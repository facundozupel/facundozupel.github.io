---
import Layout from '../../layouts/Layout.astro';

// ─── DATOS DE LA REGION ───────────────────────────────────────────────────────
const region = {
  nombre: 'Los Ríos',
  slug: 'los-rios',
  zona: 'Zona Sur',
  subtitulo: 'Bosque valdiviano, Huilo-Huilo y volcanes nevados · 62 cascadas catalogadas',
  totalCascadas: 62,
  imagen: '/assets/cascadas/salto-del-buey/hero.webp',
  imagenAlt: 'Salto del Buey, cascada de 90 metros alimentada por el glaciar Pichillancahue en Coñaripe, Región de Los Ríos',
  stats: [
    { label: 'Cascadas', value: '62' },
    { label: 'Reservas naturales', value: '3' },
    { label: 'Altura máx.', value: '90 m' },
    { label: 'Mejor época', value: 'Nov–Mar' },
  ],
  zonas: [
    { nombre: 'Panguipulli & Huilo-Huilo', cascadas: 22, descripcion: 'La Reserva Biológica Huilo-Huilo, declarada Reserva de la Biósfera por la UNESCO, concentra las cascadas más espectaculares. Salto del Buey (90 m), Salto Huilo-Huilo y Cascada del Puma entre bosque valdiviano.' },
    { nombre: 'Lago Ranco & Futrono', cascadas: 15, descripcion: 'Cascadas en los afluentes del Lago Ranco. Salto de Riñinahue en bosque valdiviano, cascadas del Río Bueno y saltos entre coihue y ulmo centenarios.' },
    { nombre: 'Corral & Costa Valdiviana', cascadas: 10, descripcion: 'Cascadas costeras en la desembocadura del Río Valdivia. Bosque siempreverde, helechos gigantes y la pluviosidad más alta de la región.' },
    { nombre: 'Volcán Mocho-Choshuenco', cascadas: 15, descripcion: 'Cascadas glaciares en las laderas del volcán. Deshielos alimentan saltos de agua entre araucarias y bosque de lenga sobre los 1.200 m de altitud.' },
  ],
  descripcion: `La Región de Los Ríos es un territorio de ríos caudalosos, bosque valdiviano milenario y volcanes nevados que alimentan más de 62 cascadas catalogadas. Creada en 2007, la región concentra su riqueza hídrica en la cuenca del Río Valdivia y los lagos Ranco, Panguipulli y Calafquén. Es la región con mayor pluviosidad del centro-sur de Chile, lo que garantiza cascadas con caudal durante todo el año.`,
  descripcion2: `El Salto del Buey —con 90 metros de caída libre alimentados por el glaciar Pichillancahue del volcán Villarrica— es la cascada más alta de la región. La <a href="/cascadas/" class="cascada-inline-link" style="color:#00b4a0; text-decoration:underline; text-underline-offset:3px;">Reserva Biológica Huilo-Huilo</a>, declarada Reserva de la Biósfera por la UNESCO, es el epicentro de la exploración de cascadas con más de 20 saltos de agua en un radio de 30 kilómetros. El bosque valdiviano, con sus alerces, coihues y helechos gigantes, crea un escenario único para cada cascada.`,
  cascadasDestacadas: [
    {
      nombre: 'Salto del Buey',
      slug: 'salto-del-buey',
      altura: 90,
      zona: 'Coñaripe',
      dificultad: 'Fácil',
      imagen: '/assets/cascadas/salto-del-buey/hero.webp',
      imagenAlt: 'Salto del Buey, cascada de 90 metros alimentada por el glaciar Pichillancahue en Coñaripe',
      destacado: 'La más alta de la región',
      tienepagina: true,
    },
    {
      nombre: 'Salto de Riñinahue',
      slug: 'salto-de-rininahue',
      altura: 27,
      zona: 'Lago Ranco',
      dificultad: 'Fácil a moderado',
      imagen: '/assets/cascadas/salto-de-rininahue/hero.webp',
      imagenAlt: 'Salto de Riñinahue en bosque valdiviano junto al Lago Ranco',
      destacado: 'Bosque valdiviano puro',
      tienepagina: true,
    },
    {
      nombre: 'Salto del Huilo-Huilo',
      slug: 'salto-del-huilo-huilo',
      altura: 37,
      zona: 'Reserva Huilo-Huilo',
      dificultad: 'Fácil',
      imagen: '/assets/cascadas/salto-del-huilo-huilo/hero.webp',
      imagenAlt: 'Salto del Huilo-Huilo en la Reserva Biológica Huilo-Huilo, bosque valdiviano',
      destacado: 'Reserva de la Biósfera UNESCO',
      tienepagina: true,
    },
    {
      nombre: 'Cascada del Puma',
      slug: 'cascada-del-puma',
      altura: 30,
      zona: 'Reserva Huilo-Huilo',
      dificultad: 'Moderado',
      imagen: '/assets/cascadas/salto-del-buey/galeria-2.webp',
      imagenAlt: 'Cascada del Puma entre bosque valdiviano en la Reserva Huilo-Huilo',
      destacado: 'Sendero escénico de 2 km',
      tienepagina: false,
    },
    {
      nombre: 'Cascada La Leona',
      slug: 'cascada-la-leona-los-rios',
      altura: 20,
      zona: 'Futrono',
      dificultad: 'Fácil',
      imagen: '/assets/cascadas/salto-de-rininahue/galeria-1.webp',
      imagenAlt: 'Cascada La Leona en los bosques de Futrono, junto al Lago Ranco',
      destacado: 'Junto al Lago Ranco',
      tienepagina: false,
    },
    {
      nombre: 'Salto del Mocho',
      slug: 'salto-del-mocho',
      altura: 45,
      zona: 'Volcán Mocho-Choshuenco',
      dificultad: 'Difícil',
      imagen: '/assets/cascadas/salto-de-rininahue/galeria-2.webp',
      imagenAlt: 'Cascada glaciar en las laderas del volcán Mocho-Choshuenco',
      destacado: 'Cascada glaciar de montaña',
      tienepagina: false,
    },
  ],
  tablaCascadas: [
    { nombre: 'Salto del Buey', slug: 'salto-del-buey', altura: '90 m', dificultad: 'Fácil', acceso: 'Coñaripe, sendero 3 km', entrada: 'Gratuita', tienepagina: true },
    { nombre: 'Salto del Mocho', slug: '', altura: '45 m', dificultad: 'Difícil', acceso: 'Volcán Mocho-Choshuenco', entrada: 'Gratuita', tienepagina: false },
    { nombre: 'Salto del Huilo-Huilo', slug: 'salto-del-huilo-huilo', altura: '37 m', dificultad: 'Fácil', acceso: 'Reserva Huilo-Huilo, Neltume', entrada: 'Pagada', tienepagina: true },
    { nombre: 'Cascada del Puma', slug: '', altura: '30 m', dificultad: 'Moderado', acceso: 'Reserva Huilo-Huilo', entrada: 'Pagada', tienepagina: false },
    { nombre: 'Salto de Riñinahue', slug: 'salto-de-rininahue', altura: '27 m', dificultad: 'Fácil a moderado', acceso: 'Lago Ranco, camino rural', entrada: 'Gratuita', tienepagina: true },
    { nombre: 'Cascada La Leona', slug: '', altura: '20 m', dificultad: 'Fácil', acceso: 'Futrono, Lago Ranco', entrada: 'Gratuita', tienepagina: false },
  ],
  mapCenter: { lat: -39.8, lng: -72.2 },
  mapZoom: 8,
  comoLlegar: `Desde Santiago (850 km, 9-10 horas en auto): Ruta 5 Sur hasta Valdivia o Panguipulli. Para la Reserva Huilo-Huilo, desvío en Lanco hacia el este por Ruta 203. Para Lago Ranco, desvío en Los Lagos hacia Futrono.`,
  comoLlegar2: `Desde Valdivia (capital regional): Base ideal para explorar la región. Aeropuerto Pichoy (ZAL) con vuelos diarios desde Santiago. Terminal de buses con conexiones directas desde Santiago, Temuco y Puerto Montt.`,
  comoLlegar3: `Transporte público: Buses interurbanos Santiago-Valdivia (10-11 horas, Tur Bus, Pullman). Buses locales a Panguipulli y Futrono. Para Huilo-Huilo, buses desde Panguipulli a Neltume. Cascadas de montaña requieren vehículo propio.`,
  clima: {
    tipo: 'Oceánico templado (Cfb)',
    tempVerano: '18-26°C',
    tempInvierno: '4-10°C',
    precipitaciones: '2.100 mm anuales',
    mejorEpoca: 'Noviembre a Marzo',
    descripcion: 'Clima oceánico con lluvias frecuentes todo el año. Los veranos son suaves con días largos; los inviernos fríos y muy lluviosos. La cordillera recibe más de 3.000 mm anuales. Las cascadas tienen buen caudal todo el año, pero el acceso a senderos de montaña se limita a noviembre-marzo. El bosque valdiviano siempreverde luce espectacular en cualquier estación.',
  },
  faq: [
    { pregunta: '¿Cuántas cascadas hay en la Región de Los Ríos?', respuesta: 'La Región de Los Ríos cuenta con más de 62 cascadas catalogadas, desde el Salto del Buey de 90 metros en Coñaripe hasta decenas de saltos menores en la Reserva Biológica Huilo-Huilo y el entorno del Lago Ranco.' },
    { pregunta: '¿Cuál es la cascada más alta de Los Ríos?', respuesta: 'El Salto del Buey en Coñaripe, con 90 metros de caída libre alimentados por el deshielo del glaciar Pichillancahue del volcán Villarrica. Es una de las cascadas más altas del sur de Chile.' },
    { pregunta: '¿Cómo llegar a la Reserva Huilo-Huilo?', respuesta: 'Desde Valdivia se toma la Ruta 5 Sur hasta Lanco, luego la Ruta 203 hasta Panguipulli y Neltume (170 km, 2.5 horas). Desde Santiago, la ruta total es de aproximadamente 850 km por Ruta 5 Sur.' },
    { pregunta: '¿Se puede visitar cascadas en Los Ríos en invierno?', respuesta: 'Sí, las cascadas de baja altitud como Salto de Riñinahue y Salto Huilo-Huilo son accesibles todo el año con buen caudal. Las cascadas de montaña del volcán Mocho-Choshuenco solo son accesibles de noviembre a marzo.' },
    { pregunta: '¿Cuál es la mejor época para ver cascadas en Los Ríos?', respuesta: 'De noviembre a marzo es la mejor época. El clima es más estable, los senderos están abiertos y el deshielo de primavera (noviembre-diciembre) garantiza máximo caudal en las cascadas volcánicas.' },
  ],
  regionesAdyacentes: [
    { nombre: 'Los Lagos', slug: 'los-lagos', cascadas: 95 },
    { nombre: 'La Araucanía', slug: 'araucania', cascadas: 48 },
    { nombre: 'Biobío', slug: 'biobio', cascadas: 42 },
  ],
};

const dificultadColor: Record<string, string> = {
  'Fácil': '#00e5d4',
  'Moderado': '#b8e8e4',
  'Moderada': '#b8e8e4',
  'Fácil a moderado': '#b8e8e4',
  'Difícil': '#f4efe6',
};

// ─── STRUCTURED DATA ────────────────────────────────────────────────────────
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: `Cascadas en la Región de ${region.nombre}`,
    description: `Las ${region.totalCascadas} mejores cascadas y saltos de agua de la Región de ${region.nombre}, Chile.`,
    numberOfItems: region.cascadasDestacadas.length,
    itemListElement: region.cascadasDestacadas.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.nombre,
      ...(c.tienepagina ? { url: `https://cascadaschile.com/cascadas/${c.slug}` } : {}),
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: region.faq.map(f => ({
      '@type': 'Question',
      name: f.pregunta,
      acceptedAnswer: { '@type': 'Answer', text: f.respuesta },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://cascadaschile.com/' },
      { '@type': 'ListItem', position: 2, name: 'Regiones', item: 'https://cascadaschile.com/region' },
      { '@type': 'ListItem', position: 3, name: region.nombre },
    ],
  },
];
---

<Layout
  title={`Cascadas en ${region.nombre} — ${region.totalCascadas} cascadas y saltos de agua | Cascadas de Chile`}
  description={`Descubre las ${region.totalCascadas} cascadas de la Región de Los Ríos. Guía completa con mapa, alturas, dificultad y cómo llegar al Salto del Buey, Huilo-Huilo y más.`}
  ogImage={`https://cascadaschile.com${region.imagen}`}
  structuredData={structuredData}
>

  <!-- ─── 1. HERO ──────────────────────────────────────────────────────────────── -->
  <section style="
    position:relative;
    min-height:80vh;
    padding-top:64px;
    overflow:hidden;
    display:flex; flex-direction:column; justify-content:flex-end;
  ">
    <img
      src={region.imagen}
      alt={region.imagenAlt}
      fetchpriority="high"
      decoding="async"
      style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover;"
    />
    <div style="position:absolute; inset:0; background:linear-gradient(to bottom, rgba(9,29,43,0.2) 0%, rgba(9,29,43,0.9) 100%);"></div>

    <div style="position:relative; z-index:1; padding:4rem 2.5rem;">
      <nav style="margin-bottom:1.5rem;">
        <a href="/" style="color:rgba(244,239,230,0.6); text-decoration:none; font-size:0.78rem; letter-spacing:0.08em; text-transform:uppercase;">Inicio</a>
        <span style="color:rgba(244,239,230,0.3); margin:0 0.5rem;">›</span>
        <a href="/region/" style="color:rgba(244,239,230,0.6); text-decoration:none; font-size:0.78rem; letter-spacing:0.08em; text-transform:uppercase;">Regiones</a>
        <span style="color:rgba(244,239,230,0.3); margin:0 0.5rem;">›</span>
        <span style="color:#00e5d4; font-size:0.78rem; letter-spacing:0.08em; text-transform:uppercase;">{region.nombre}</span>
      </nav>

      <p style="color:#00e5d4; font-size:0.82rem; letter-spacing:0.15em; text-transform:uppercase; margin:0 0 0.75rem;">{region.subtitulo}</p>
      <h1 style="
        font-family:'Archivo Black',sans-serif;
        font-size:clamp(4rem, 10vw, 12rem);
        color:#f4efe6; margin:0; line-height:0.88;
        text-transform:uppercase; letter-spacing:-0.02em;
      ">
        Región<br/>de {region.nombre}
      </h1>
    </div>
  </section>


  <!-- ─── 2. STATS ────────────────────────────────────────────────────────────── -->
  <section style="background:#091d2b; padding:0;">
    <div style="
      display:grid; grid-template-columns:repeat(4,1fr);
      border-top:1px solid rgba(0,229,212,0.15);
    ">
      {region.stats.map((stat, i) => (
        <div style={`
          padding:2.5rem 2rem;
          border-right:${i < 3 ? '1px solid rgba(0,229,212,0.15)' : 'none'};
        `}>
          <p style="
            font-family:'Archivo Black',sans-serif;
            font-size:clamp(2rem, 4vw, 3.5rem);
            color:#00e5d4; margin:0; line-height:1;
          ">{stat.value}</p>
          <p style="color:rgba(244,239,230,0.45); font-size:0.8rem; letter-spacing:0.12em; text-transform:uppercase; margin:0.5rem 0 0;">{stat.label}</p>
        </div>
      ))}
    </div>
  </section>


  <!-- ─── 3. GRID DE CASCADAS ──────────────────────────────────────────────────── -->
  <section style="background:#091d2b; padding:7rem 2.5rem;">
    <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:3.5rem;">
      <h2 class="reveal" style="
        font-family:'Archivo Black',sans-serif;
        font-size:clamp(3rem, 7vw, 8rem);
        color:#f4efe6; margin:0; line-height:0.9;
        text-transform:uppercase;
      ">
        Cascadas<br/>en {region.nombre}
      </h2>
      <p style="color:rgba(244,239,230,0.4); font-size:0.85rem; align-self:center;">
        Mostrando 6 de {region.totalCascadas}
      </p>
    </div>

    <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:1.25rem;">
      {region.cascadasDestacadas.map(c => {
        const inner = (
          <>
            <div style="height:280px; border-radius:4px; margin-bottom:1.25rem; position:relative; overflow:hidden;">
              <img
                src={c.imagen}
                alt={c.imagenAlt}
                loading="lazy"
                decoding="async"
                style="width:100%; height:100%; object-fit:cover;"
              />
              <span style={`
                position:absolute; top:1rem; left:1rem;
                background:${dificultadColor[c.dificultad] || '#b8e8e4'}; color:#091d2b;
                font-size:0.7rem; font-weight:700; letter-spacing:0.1em;
                text-transform:uppercase; padding:0.3rem 0.75rem; border-radius:999px;
              `}>{c.dificultad}</span>
              <span style="
                position:absolute; bottom:1rem; right:1rem;
                background:rgba(9,29,43,0.8);
                color:#f4efe6; font-family:'Archivo Black',sans-serif;
                font-size:1.1rem; padding:0.35rem 0.75rem; border-radius:4px;
              ">{c.altura}m</span>
            </div>
            <h3 style="
              font-family:'Archivo Black',sans-serif;
              font-size:1.4rem; color:#f4efe6; margin:0 0 0.3rem;
              text-transform:uppercase;
            ">{c.nombre}</h3>
            <p style="color:rgba(244,239,230,0.45); font-size:0.88rem; margin:0 0 0.2rem; font-weight:300;">{c.zona}</p>
            <p style="color:#00b4a0; font-size:0.78rem; margin:0; font-weight:500;">{c.destacado}</p>
          </>
        );

        return c.tienepagina ? (
          <a href={`/cascadas/${c.slug}`} class="cascade-card" style="display:block; text-decoration:none; cursor:pointer;">
            {inner}
          </a>
        ) : (
          <div class="cascade-card" style="display:block;">
            {inner}
          </div>
        );
      })}
    </div>

    <div style="margin-top:4rem; text-align:center;">
      <a href="/cascadas/" style="
        display:inline-flex; align-items:center; gap:0.75rem;
        color:#091d2b; background:#00e5d4; text-decoration:none;
        font-size:0.85rem; font-weight:600; letter-spacing:0.12em;
        text-transform:uppercase; padding:1rem 2.5rem; border-radius:999px;
      ">
        Ver todas las cascadas de Chile
      </a>
    </div>
  </section>


  <!-- ─── 4. TABLA COMPARATIVA ─────────────────────────────────────────────────── -->
  <section style="background:#f4efe6; padding:6rem 2.5rem;">
    <h2 class="reveal" style="
      font-family:'Archivo Black',sans-serif;
      font-size:clamp(2rem, 4vw, 4rem);
      color:#091d2b; margin:0 0 1rem; line-height:0.9;
      text-transform:uppercase;
    ">Comparativa de Cascadas</h2>
    <p style="color:rgba(9,29,43,0.5); font-size:0.9rem; margin:0 0 2.5rem; font-weight:300;">
      Datos clave para planificar tu visita a las cascadas de Los Ríos.
    </p>

    <div style="overflow-x:auto;">
      <table style="width:100%; border-collapse:collapse; font-size:0.92rem;">
        <thead>
          <tr style="border-bottom:2px solid #091d2b;">
            <th style="text-align:left; padding:1rem 1rem 1rem 0; font-size:0.72rem; font-weight:600; letter-spacing:0.12em; text-transform:uppercase; color:#00b4a0;">Nombre</th>
            <th style="text-align:left; padding:1rem; font-size:0.72rem; font-weight:600; letter-spacing:0.12em; text-transform:uppercase; color:#00b4a0;">Altura</th>
            <th style="text-align:left; padding:1rem; font-size:0.72rem; font-weight:600; letter-spacing:0.12em; text-transform:uppercase; color:#00b4a0;">Dificultad</th>
            <th style="text-align:left; padding:1rem; font-size:0.72rem; font-weight:600; letter-spacing:0.12em; text-transform:uppercase; color:#00b4a0;">Acceso</th>
            <th style="text-align:left; padding:1rem 0 1rem 1rem; font-size:0.72rem; font-weight:600; letter-spacing:0.12em; text-transform:uppercase; color:#00b4a0;">Entrada</th>
          </tr>
        </thead>
        <tbody>
          {region.tablaCascadas.map((c, i) => (
            <tr style={`border-bottom:1px solid rgba(9,29,43,0.1); ${i % 2 === 1 ? 'background:rgba(0,180,160,0.04);' : ''}`}>
              <td style="padding:1rem 1rem 1rem 0; font-weight:500; color:#091d2b;">
                {c.tienepagina ? (
                  <a href={`/cascadas/${c.slug}`} style="color:#091d2b; text-decoration:none; border-bottom:1px solid #00b4a0; transition:color 0.2s;">
                    {c.nombre}
                  </a>
                ) : (
                  <span>{c.nombre}</span>
                )}
              </td>
              <td style="padding:1rem; color:#091d2b;">
                <span style="font-family:'Archivo Black',sans-serif; color:#00b4a0;">{c.altura}</span>
              </td>
              <td style="padding:1rem; color:#091d2b;">
                <span style={`
                  display:inline-block;
                  font-size:0.72rem; font-weight:700; letter-spacing:0.08em;
                  text-transform:uppercase; padding:0.2rem 0.6rem; border-radius:999px;
                  background:${dificultadColor[c.dificultad] || '#b8e8e4'}; color:#091d2b;
                `}>{c.dificultad}</span>
              </td>
              <td style="padding:1rem; color:rgba(9,29,43,0.7); font-weight:300; font-size:0.88rem;">{c.acceso}</td>
              <td style="padding:1rem 0 1rem 1rem; color:rgba(9,29,43,0.7); font-weight:300; font-size:0.88rem;">{c.entrada}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>


  <!-- ─── 5. MAPA ──────────────────────────────────────────────────────────────── -->
  <section style="background:#091d2b; padding:6rem 2.5rem;">
    <h2 class="reveal" style="
      font-family:'Archivo Black',sans-serif;
      font-size:clamp(2rem, 5vw, 5rem);
      color:#f4efe6; margin:0 0 1rem; line-height:0.9;
      text-transform:uppercase;
    ">Mapa de Cascadas<br/>en {region.nombre}</h2>
    <p style="color:rgba(244,239,230,0.45); font-size:0.9rem; margin:0 0 2.5rem; font-weight:300; max-width:560px;">
      Explora la ubicación de las principales cascadas de la región. Se distribuyen desde Valdivia en el oeste hasta la Reserva Huilo-Huilo y el volcán Mocho-Choshuenco en la cordillera.
    </p>
    <div style="border-radius:8px; overflow:hidden; border:1px solid rgba(0,229,212,0.15);">
      <iframe
        src={`https://www.openstreetmap.org/export/embed.html?bbox=${region.mapCenter.lng - 1.5}%2C${region.mapCenter.lat - 1}%2C${region.mapCenter.lng + 1.5}%2C${region.mapCenter.lat + 1}&layer=mapnik`}
        style="width:100%; height:450px; border:0;"
        loading="lazy"
        title={`Mapa de cascadas en la Región de ${region.nombre}`}
      ></iframe>
    </div>
  </section>


  <!-- ─── 6+7. ZONAS + DESCRIPCION REGIONAL ───────────────────────────────────── -->
  <section style="background:#f4efe6; padding:6rem 2.5rem;">
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:6rem; align-items:start;">
      <div class="reveal">
        <h2 style="
          font-family:'Archivo Black',sans-serif;
          font-size:clamp(2.5rem, 5vw, 5rem);
          color:#091d2b; margin:0 0 2rem; line-height:0.9;
          text-transform:uppercase;
        ">
          Bosque<br/>Valdiviano<br/>y Volcanes
        </h2>
        <p style="color:#091d2b; font-size:1.05rem; line-height:1.75; font-weight:300; max-width:480px; margin:0 0 1.5rem;">{region.descripcion}</p>
        <p style="color:#091d2b; font-size:1.05rem; line-height:1.75; font-weight:300; max-width:480px; margin:0;" set:html={region.descripcion2}></p>
      </div>

      <div class="reveal">
        <p style="font-size:0.75rem; font-weight:600; letter-spacing:0.15em; text-transform:uppercase; color:#00b4a0; margin:0 0 1.5rem;">Zonas principales</p>
        <div style="display:flex; flex-direction:column;">
          {region.zonas.map((zona, i) => (
            <div style={`
              padding:1.5rem 0;
              border-top:${i > 0 ? '1px solid rgba(9,29,43,0.1)' : 'none'};
            `}>
              <div style="display:flex; justify-content:space-between; align-items:baseline; margin-bottom:0.5rem;">
                <h3 style="font-size:1rem; font-weight:600; color:#091d2b; margin:0;">{zona.nombre}</h3>
                <span style="font-family:'Archivo Black',sans-serif; font-size:0.9rem; color:#00b4a0;">{zona.cascadas} cascadas</span>
              </div>
              <p style="color:rgba(9,29,43,0.6); font-size:0.88rem; line-height:1.55; margin:0; font-weight:300;">{zona.descripcion}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>


  <!-- ─── 8. CLIMA / MEJOR EPOCA ───────────────────────────────────────────────── -->
  <section style="background:#091d2b; padding:6rem 2.5rem;">
    <h2 class="reveal" style="
      font-family:'Archivo Black',sans-serif;
      font-size:clamp(2rem, 4vw, 4rem);
      color:#f4efe6; margin:0 0 3rem; line-height:0.9;
      text-transform:uppercase;
    ">Mejor Época<br/>para Visitar</h2>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:4rem; align-items:start;">
      <div class="reveal">
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:1.5rem;">
          <div style="padding:1.5rem; border:1px solid rgba(0,229,212,0.15); border-radius:8px;">
            <p style="font-size:0.7rem; font-weight:600; letter-spacing:0.12em; text-transform:uppercase; color:#00b4a0; margin:0 0 0.5rem;">Tipo de clima</p>
            <p style="color:#f4efe6; font-size:0.95rem; margin:0; font-weight:300;">{region.clima.tipo}</p>
          </div>
          <div style="padding:1.5rem; border:1px solid rgba(0,229,212,0.15); border-radius:8px;">
            <p style="font-size:0.7rem; font-weight:600; letter-spacing:0.12em; text-transform:uppercase; color:#00b4a0; margin:0 0 0.5rem;">Mejor época</p>
            <p style="font-family:'Archivo Black',sans-serif; color:#00e5d4; font-size:1.3rem; margin:0;">{region.clima.mejorEpoca}</p>
          </div>
          <div style="padding:1.5rem; border:1px solid rgba(0,229,212,0.15); border-radius:8px;">
            <p style="font-size:0.7rem; font-weight:600; letter-spacing:0.12em; text-transform:uppercase; color:#00b4a0; margin:0 0 0.5rem;">Verano</p>
            <p style="font-family:'Archivo Black',sans-serif; color:#00e5d4; font-size:1.3rem; margin:0;">{region.clima.tempVerano}</p>
          </div>
          <div style="padding:1.5rem; border:1px solid rgba(0,229,212,0.15); border-radius:8px;">
            <p style="font-size:0.7rem; font-weight:600; letter-spacing:0.12em; text-transform:uppercase; color:#00b4a0; margin:0 0 0.5rem;">Invierno</p>
            <p style="font-family:'Archivo Black',sans-serif; color:#00e5d4; font-size:1.3rem; margin:0;">{region.clima.tempInvierno}</p>
          </div>
        </div>
        <div style="margin-top:1.5rem; padding:1.5rem; border:1px solid rgba(0,229,212,0.15); border-radius:8px;">
          <p style="font-size:0.7rem; font-weight:600; letter-spacing:0.12em; text-transform:uppercase; color:#00b4a0; margin:0 0 0.5rem;">Precipitaciones</p>
          <p style="font-family:'Archivo Black',sans-serif; color:#00e5d4; font-size:1.3rem; margin:0;">{region.clima.precipitaciones}</p>
        </div>
      </div>

      <div class="reveal">
        <p style="color:rgba(244,239,230,0.75); font-size:1.05rem; line-height:1.75; font-weight:300; margin:0;">
          {region.clima.descripcion}
        </p>
      </div>
    </div>
  </section>


  <!-- ─── 9. COMO LLEGAR ───────────────────────────────────────────────────────── -->
  <section style="background:#f4efe6; padding:6rem 2.5rem;">
    <h2 class="reveal" style="
      font-family:'Archivo Black',sans-serif;
      font-size:clamp(2rem, 4vw, 4rem);
      color:#091d2b; margin:0 0 3rem; line-height:0.9;
      text-transform:uppercase;
    ">Cómo Llegar<br/>a {region.nombre}</h2>

    <div class="reveal" style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:2.5rem;">
      <div style="padding:2rem; border:1px solid rgba(9,29,43,0.1); border-radius:8px; background:white;">
        <div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:1.25rem;">
          <span style="display:inline-flex; align-items:center; justify-content:center; width:36px; height:36px; background:#00e5d4; border-radius:50%; font-size:1rem;">&#128663;</span>
          <p style="font-size:0.72rem; font-weight:600; letter-spacing:0.12em; text-transform:uppercase; color:#00b4a0; margin:0;">En auto desde Santiago</p>
        </div>
        <p style="color:rgba(9,29,43,0.7); font-size:0.92rem; line-height:1.65; font-weight:300; margin:0;">{region.comoLlegar}</p>
      </div>

      <div style="padding:2rem; border:1px solid rgba(9,29,43,0.1); border-radius:8px; background:white;">
        <div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:1.25rem;">
          <span style="display:inline-flex; align-items:center; justify-content:center; width:36px; height:36px; background:#00e5d4; border-radius:50%; font-size:1rem;">&#9992;</span>
          <p style="font-size:0.72rem; font-weight:600; letter-spacing:0.12em; text-transform:uppercase; color:#00b4a0; margin:0;">Desde Valdivia</p>
        </div>
        <p style="color:rgba(9,29,43,0.7); font-size:0.92rem; line-height:1.65; font-weight:300; margin:0;">{region.comoLlegar2}</p>
      </div>

      <div style="padding:2rem; border:1px solid rgba(9,29,43,0.1); border-radius:8px; background:white;">
        <div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:1.25rem;">
          <span style="display:inline-flex; align-items:center; justify-content:center; width:36px; height:36px; background:#00e5d4; border-radius:50%; font-size:1rem;">&#128652;</span>
          <p style="font-size:0.72rem; font-weight:600; letter-spacing:0.12em; text-transform:uppercase; color:#00b4a0; margin:0;">Transporte público</p>
        </div>
        <p style="color:rgba(9,29,43,0.7); font-size:0.92rem; line-height:1.65; font-weight:300; margin:0;">{region.comoLlegar3}</p>
      </div>
    </div>
  </section>


  <!-- ─── 10. FAQ ──────────────────────────────────────────────────────────────── -->
  <section style="background:#f4efe6; padding:0 2.5rem 6rem;">
    <h2 class="reveal" style="
      font-family:'Archivo Black',sans-serif;
      font-size:clamp(2rem, 4vw, 4rem);
      color:#091d2b; margin:0 0 2.5rem; line-height:0.9;
      text-transform:uppercase;
    ">Preguntas Frecuentes</h2>

    <div class="reveal" style="max-width:800px;">
      {region.faq.map((f, i) => (
        <details style={`
          border-top:${i === 0 ? '1px solid rgba(9,29,43,0.12)' : 'none'};
          border-bottom:1px solid rgba(9,29,43,0.12);
        `}>
          <summary style="
            padding:1.5rem 0;
            cursor:pointer;
            font-family:'Archivo Black',sans-serif;
            font-size:1.05rem;
            color:#091d2b;
            text-transform:uppercase;
            list-style:none;
            display:flex;
            justify-content:space-between;
            align-items:center;
          ">
            {f.pregunta}
            <span style="color:#00b4a0; font-size:1.5rem; font-family:'DM Sans',sans-serif; font-weight:300; margin-left:1rem; flex-shrink:0;">+</span>
          </summary>
          <div style="padding:0 0 1.5rem;">
            <p style="color:rgba(9,29,43,0.7); font-size:0.95rem; line-height:1.7; font-weight:300; margin:0;">
              {f.respuesta}
            </p>
          </div>
        </details>
      ))}
    </div>
  </section>


  <!-- ─── 11. REGIONES ADYACENTES ──────────────────────────────────────────────── -->
  <section style="background:#f4efe6; padding:0 2.5rem 6rem;">
    <h2 class="reveal" style="
      font-family:'Archivo Black',sans-serif;
      font-size:clamp(2rem, 4vw, 4rem);
      color:#091d2b; margin:0 0 3rem; line-height:0.9;
      text-transform:uppercase;
    ">Regiones Cercanas</h2>

    <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:0; border:1px solid rgba(9,29,43,0.12);">
      {region.regionesAdyacentes.map((r, i) => (
        <a href={`/region/${r.slug}`} style={`
          display:block; padding:2.5rem;
          text-decoration:none; color:#091d2b;
          border-right:${i < 2 ? '1px solid rgba(9,29,43,0.12)' : 'none'};
          transition:background 0.2s;
        `}
        onmouseenter="this.style.background='rgba(0,229,212,0.08)'"
        onmouseleave="this.style.background='transparent'">
          <p style="font-family:'Archivo Black',sans-serif; font-size:clamp(1.5rem, 3vw, 2.5rem); margin:0 0 0.5rem; text-transform:uppercase;">{r.nombre}</p>
          <p style="font-size:0.88rem; color:#00b4a0; margin:0; font-weight:500;">{r.cascadas} cascadas</p>
        </a>
      ))}
    </div>
  </section>


  <!-- ─── 12. CTA MAPA ────────────────────────────────────────────────────────── -->
  <section style="background:#091d2b; padding:6rem 2.5rem; text-align:center;">
    <h2 style="
      font-family:'Archivo Black',sans-serif;
      font-size:clamp(2rem, 5vw, 5rem);
      color:#f4efe6; margin:0 0 1.5rem; line-height:0.95;
      text-transform:uppercase;
    ">Explora las Cascadas<br/>en el Mapa</h2>
    <p style="color:rgba(244,239,230,0.5); font-size:1.05rem; max-width:480px; margin:0 auto 2.5rem; font-weight:300;">
      Usa el mapa interactivo para planificar tu ruta por las cascadas de Los Ríos y el sur de Chile.
    </p>
    <a href="/cascadas/" style="
      display:inline-flex; align-items:center; gap:0.75rem;
      color:#091d2b; background:#00e5d4; text-decoration:none;
      font-size:0.85rem; font-weight:600; letter-spacing:0.12em;
      text-transform:uppercase; padding:1rem 2.5rem; border-radius:999px;
    ">Abrir mapa</a>
  </section>

</Layout>