  <section class="cascada-cta">
    <h2 class="cascada-cta__title">Descubre +500<br/>cascadas más</h2>
    <p class="cascada-cta__text">Explora todas las cascadas de Chile con guías completas, mapas y datos prácticos.</p>
    <a href="/cascadas/" class="cascada-cta__button">Explorar cascadas →</a>
  </section>

</Layout>


