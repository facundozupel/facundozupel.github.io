---
import Layout from '../../layouts/Layout.astro';

// ─── DATOS DE LA CASCADA ──────────────────────────────────────────────────────
// Verificado por chile-waterfalls-researcher, marzo 2026
const cascada = {
  nombre: 'Saltos de Malalcura',
  slug: 'saltos-de-malalcura',
  region: 'Biobío',
  zona: 'Antuco',
  altura: 40,
  caudal: 'Variable estacional — aguas filtradas por escoria volcánica desde la Laguna del Laja',
  dificultad: 'Moderado',
  acceso: 'Sendero 2 h desde Camping Malalcura, Ruta Q-45 km 80',
  coordenadas: '37°24\'S 71°25\'W',
  mejorEpoca: 'Noviembre — Marzo',
  entrada: 'Consultar en Camping Malalcura',
  horario: 'Sin horario fijo',
  descripcion: `Los Saltos de Malalcura son una serie de al menos seis cascadas y toboganes naturales que el Río Malalcura —cuyo nombre en mapudungún significa 'corral de piedra'— forma al descender por una imponente formación granítica de origen intrusivo. El granito, de fuerte contenido de cuarzo, exhibe un llamativo color blanco brillante que contrasta con la vegetación de bosque nativo que lo rodea. El salto más grande es parcialmente visible desde la Ruta Q-45, mientras que para acceder a toda la serie de cascadas es necesario realizar una caminata de aproximadamente dos horas desde el Camping Malalcura, a través de espesos bosques de Nothofagus (coihues, ñirres y lengas) con vistas a la Sierra Velluda y el Volcán Antuco.

  Las aguas tienen una pureza excepcional: se filtran a través del subsuelo constituido por escoria volcánica (tefra) producto de la actividad del complejo volcánico Antuco, con origen en la Laguna del Laja y el Estero El Toro. Este proceso de filtración natural otorga a las aguas una transparencia cristalina. La formación geológica corresponde a un antiguo valle glaciario colgado labrado en el plutón granodiorítico, rellenado posteriormente por coladas de lava del Volcán Sierra Velluda.

  Los Saltos de Malalcura forman parte de la Ruta de las Cascadas del Biobío promovida por SERNATUR, que incluye también el Salto del Trubunleo, el Velo de la Novia, Las Chilcas y el Salto Echeverría, todas en la comuna de Antuco. El parque de aventura Altos de Malalcura, ubicado en el km 80 de la ruta Q-45 contiguo al acceso, ofrece actividades de canopy, rappel en cascadas y excursiones guiadas al sector.`,
  comoLlegar: `Desde Santiago (560 km, 6-7 horas en auto): Tomar Ruta 5 Sur hasta Los Ángeles, luego desviar por la Ruta Q-45 en dirección a Antuco y Laguna del Laja. Los Saltos de Malalcura se encuentran aproximadamente en el km 80 de la Ruta Q-45, antes de llegar a la entrada del Parque Nacional Laguna del Laja (km 94-97). El salto principal es visible al costado derecho del camino.

  Desde Los Ángeles (90 km, aprox. 1 h 30 min): Tomar la Ruta Q-45 en dirección a Antuco. Pasar por la ciudad de Antuco y continuar por el camino de montaña hacia Laguna del Laja. El acceso a los saltos está en el km 80, en el sector Camping Malalcura / Altos de Malalcura.

  Transporte público: Desde el Terminal Rural de Los Ángeles salen buses de las empresas Elper y El Volcán con destino a Abanico (pasando por Antuco y Villa Peluca). El viaje toma aproximadamente 90 minutos. El bus puede detenerse en el acceso al Camping Malalcura si se solicita. No hay transporte público directo desde Santiago al lugar.`,
  imagen: '/assets/cascadas/saltos-de-malalcura/hero.webp',
  imagenAlt: 'Volcán Antuco y Sierra Velluda en el Parque Nacional Laguna del Laja, entorno de los Saltos de Malalcura en Biobío',
  galeria: [
    { src: '/assets/cascadas/saltos-de-malalcura/galeria-1.webp', alt: 'Glaciar de la Sierra Velluda en el Parque Nacional Laguna del Laja, visible desde el sendero a Malalcura' },
    { src: '/assets/cascadas/saltos-de-malalcura/galeria-2.webp', alt: 'Laguna del Laja con paisaje cordillerano en la Región del Biobío, origen de las aguas de Malalcura' },
    { src: '/assets/cascadas/saltos-de-malalcura/galeria-3.webp', alt: 'Río Laja atravesando el Parque Nacional Laguna del Laja, cuenca compartida con el Río Malalcura' },
    { src: '/assets/cascadas/saltos-de-malalcura/galeria-4.webp', alt: 'Glaciar Sierra Velluda visto desde el interior del Parque Nacional Laguna del Laja, Biobío' },
  ],
  galeriaCreditos: [
    { autor: 'Raymundo46', licencia: 'CC BY-SA 4.0', url: 'https://commons.wikimedia.org/wiki/File:Volcan-Antuco-y-Sierra-Velluda.jpg' },
    { autor: 'Raymundo46', licencia: 'CC BY-SA 4.0', url: 'https://commons.wikimedia.org/wiki/File:Sierra-Velluda-3.jpg' },
    { autor: 'Hellmighty', licencia: 'CC BY-SA 4.0', url: 'https://commons.wikimedia.org/wiki/File:Laguna_del_Laja,_Bio_Bio,_Chile.jpg' },
    { autor: 'AcrossTheMountains', licencia: 'CC BY-SA 4.0', url: 'https://commons.wikimedia.org/wiki/File:Parque_nacional_Laguna_del_Laja_rio_Laja.jpg' },
  ],
  // 3 por cercanía geográfica (misma región, misma comuna Antuco)
  cascadasCercanas: [
    { nombre: 'Cascadas P.N. Laguna del Laja', slug: 'cascadas-parque-nacional-laguna-del-laja', region: 'Biobío', altura: 55, tipo: 'cercania' },
    { nombre: 'Salto del Trubunleo', slug: 'salto-trubunleo', region: 'Biobío', altura: 55, tipo: 'cercania' },
    { nombre: 'Salto del Laja', slug: 'salto-del-laja', region: 'Biobío', altura: 35, tipo: 'cercania' },
  ],
  // 3 por relación semántica (sendero moderado en parque/reserva, múltiples saltos, experiencia outdoor)
  cascadasRelacionadas: [
    { nombre: 'Cascada Nido de Águila', slug: 'cascada-nido-de-aguila', region: 'La Araucanía', altura: 50, tipo: 'relacionada' },
    { nombre: 'Salto Rehuén', slug: 'salto-rehuen', region: 'Biobío', altura: 70, tipo: 'relacionada' },
    { nombre: 'Salto del Claro', slug: 'salto-del-claro', region: 'La Araucanía', altura: 90, tipo: 'relacionada' },
  ],

  // --- Datos verificados por chile-waterfalls-researcher (marzo 2026) ---
  lat: -37.402,
  lng: -71.420,
  rio: 'Río Malalcura',
  tipoFormacion: 'Formación granítica intrusiva con cuarzo',
  numeroBrazos: 6,
  distanciaSantiago: 560,

  historia: `El nombre Malalcura proviene del mapudungún y significa 'corral de piedra' (malal = corral, kura = piedra), reflejo de la geografía granítica del lugar y de la relación histórica que el pueblo mapuche —en particular los pehuenches— mantuvieron con este territorio andino. Los pehuenches utilizaban el corredor del Río Laja y el Paso Antuco para sus desplazamientos y comercio transfronterizo con Argentina, por lo que los sectores altos de Antuco fueron frecuentados durante siglos por estas comunidades.

  Geológicamente, la formación de los saltos está vinculada a millones de años de actividad volcánica e intrusiva del complejo Antuco-Sierra Velluda. El plutón granodiorítico que forma el lecho por el que caen los saltos se formó por la intrusión de magma en épocas geológicas pasadas. Posteriormente, durante el Pleistoceno, glaciares tallaron el valle donde hoy corre el Río Malalcura, creando el perfil de 'valle colgado' que da origen a las cascadas escalonadas. Las lavas del Volcán Sierra Velluda rellenaron parcialmente el valle glaciario, modificando aún más el recorrido del río y configurando los saltos actuales.

  El sector fue incorporado al circuito turístico de Antuco durante la última década del siglo XX, y tomó mayor relevancia con la creación de la Ruta de las Cascadas del Biobío (SERNATUR, 2020), que lo incluye entre las cinco cascadas principales de la comuna de Antuco. El parque de aventura Altos de Malalcura lleva más de 15 años operando en el km 80 de la Ruta Q-45.`,

  queHacer: [
    { actividad: 'Trekking a los saltos', descripcion: 'Caminata de aproximadamente 2 horas desde el Camping Malalcura. El sendero atraviesa bosques densos de Nothofagus con vistas al Volcán Antuco (2.979 m) y Sierra Velluda (3.585 m). Las rocas graníticas son resbaladizas: se recomienda calzado de trekking con buena tracción. Dificultad moderada.' },
    { actividad: 'Canopy y rappel en cascadas', descripcion: 'El parque Altos de Malalcura (km 80, Ruta Q-45) opera un circuito de canopy de 2,3 km con líneas de hasta 130 m de altura. También ofrecen rappel vertical en cascadas y escalada. Más de 15 años de experiencia. Contacto: +56 9 7427 7508.' },
    { actividad: 'Observación desde la carretera', descripcion: 'El salto más grande de la serie es parcialmente visible desde el costado derecho de la Ruta Q-45, frente a un coihue de gran tamaño, aproximadamente 3 km antes de la entrada al Parque Nacional Laguna del Laja. No requiere caminata.' },
    { actividad: 'Fotografía de naturaleza', descripcion: 'El sendero permite avistar la mariposa del chagual (Castnia eudesmia), la mariposa más grande de Chile. Oportunidades fotográficas de cóndor andino, zorro culpeo, y el contraste del granito blanco con el bosque nativo. Mejor época: noviembre a febrero.' },
    { actividad: 'Pesca deportiva', descripcion: 'El Río Malalcura y sectores del Río Laja ofrecen pesca deportiva de trucha arcoíris. Requiere licencia de pesca de Sernapesca vigente. Temporada habitual: noviembre a mayo.' },
    { actividad: 'Visita al P.N. Laguna del Laja', descripcion: 'A 14 km por la misma Ruta Q-45 se encuentra la entrada al parque (km 94). Sendero Las Chilcas (1,6 km, fácil, 1 h) incluye las cascadas Las Chilcas y Torbellino. Entrada: $3.200 adultos chilenos (2025). Horario: 8:30-17:30.' },
  ],

  flora: `El sendero hacia los Saltos de Malalcura discurre por un bosque templado andino dominado por Nothofagus: coihue (Nothofagus dombeyi), ñirre (Nothofagus antarctica) y lenga (Nothofagus pumilio), especies características de la cordillera de la Región del Biobío entre los 900 y 1.800 msnm. El sotobosque incluye diversas especies de helechos nativos, musgos y líquenes que cubren las rocas graníticas en las zonas de mayor humedad.

  En el estrato arbustivo se encuentran el michay (Berberis sp.) de flores amarillas, la murtilla (Ugni molinae) con sus frutos comestibles, el calafate (Berberis microphylla) y el chilco (Fuchsia magellanica) de flores rojas. La orilla del Río Malalcura alberga vegetación higrófila con abundantes musgos ribereños y helechos acuáticos. En las zonas abiertas crece el chagual o puya (Puya sp.), planta que sirve de hábitat a la mariposa Castnia eudesmia. También se reportan araucaria (Araucaria araucana) y ciprés de la cordillera (Austrocedrus chilensis) en sectores del parque adyacente.`,

  fauna: `El entorno de los Saltos de Malalcura destaca por la presencia de la mariposa del chagual (Castnia eudesmia Gray, 1838), la mariposa más grande de Chile y la única de la familia Castniidae en el país. Esta especie amenazada mantiene una relación simbiótica con el chagual: los adultos se alimentan del néctar de sus flores mientras las larvas se desarrollan en el interior del tallo. Es fácil de observar durante primavera y verano.

  Entre las aves destacan el cóndor andino (Vultur gryphus), el águila (Geranoaetus melanoleucus), el halcón peregrino (Falco peregrinus), el picaflor gigante (Patagona gigas) y la cachaña (Enicognathus ferrugineus). En la ribera del río se pueden observar el martín pescador (Megaceryle torquata) y el pato cortacorrientes (Merganetta armata). Entre los mamíferos están el puma, el zorro culpeo (Lycalopex culpaeus), el pudú (Pudu puda) y la vizcacha (Lagidium viscacia). El huemul (Hippocamelus bisulcus), especie en peligro crítico, habita la zona aunque su avistamiento es muy ocasional.`,

  clima: {
    tipo: 'Mediterráneo cordillerano (Csb)',
    tempPromedio: '13.6°C',
    tempVerano: '20-30°C',
    tempInvierno: '-0.3°C a 10°C',
    precipitaciones: '~1.400-1.800 mm anuales (mayo-agosto)',
    descripcion: 'El sector de Malalcura (~1.000 msnm) presenta un clima cordillerano con veranos cálidos y secos e inviernos fríos y lluviosos, con nevadas posibles desde mayo. El período óptimo para visitar los saltos es de noviembre a marzo: temperaturas agradables, nieve derretida que alimenta el caudal del Río Malalcura, y senderos accesibles. En invierno (junio-agosto) el sendero puede presentar hielo y nieve.',
  },

  seguridad: [
    'Las rocas graníticas son extremadamente resbaladizas, especialmente con musgo húmedo — caminar con precaución',
    'El sendero no tiene señalización formal — se recomienda ir con guía local o pedir indicaciones en el Camping Malalcura',
    'No bañarse en los pozones bajo los saltos sin conocer la profundidad — aguas de deshielo muy frías (menos de 10°C)',
    'Llevar agua potable propia — no consumir agua del río sin tratar',
    'En invierno (junio-septiembre) la Ruta Q-45 puede quedar bloqueada por nieve y el sendero ser inaccesible',
    'El Volcán Antuco es un volcán activo — estar atento a alertas de SERNAGEOMIN',
    'No escalar las rocas graníticas sin equipo adecuado',
    'No dejar basura — zona de bosque nativo con alta sensibilidad ecológica',
  ],

  recomendaciones: [
    'Calzado de trekking con suela antideslizante — imprescindible en el granito húmedo',
    'Ropa en capas: chaqueta impermeable aunque el día esté soleado',
    'Bastones de trekking para el descenso por senderos con raíces',
    'Mínimo 1,5 litros de agua potable por persona',
    'Protector solar SPF 50+ (altitud y reflexión del granito blanco)',
    'Binoculares para observar cóndores y patos cortacorrientes',
    'Snacks energéticos para la caminata de 2 horas de subida',
    'Mapa offline (MAPS.ME o AllTrails) — cobertura de datos limitada',
  ],

  gastronomia: [
    { plato: 'Trucha arcoíris del Río Laja', descripcion: 'El plato estrella de la zona cordillerana de Antuco. Trucha a la plancha, al ajillo o ahumada. Disponible en el EcoHotel Antuco, Antucalhue Mountain Resort y restaurantes locales de Antuco.' },
    { plato: 'Cazuela de vacuno cordillerana', descripcion: 'Caldo contundente con trozos de carne, papas, choclo y zapallo. Plato cotidiano de la cocina criolla del sur de Chile, ideal para recuperar energías después del trekking.' },
    { plato: 'Asado al palo', descripcion: 'Cordero o vacuno asado a fuego lento en estaca, tradición huasa del campo del Biobío. En Antuco se ofrece en fondas y campings durante temporada estival y Fiestas Patrias.' },
    { plato: 'Empanada de pino horneada', descripcion: 'Empanada criolla rellena de carne picada, cebolla, aceituna y huevo duro. Presente en locales de Antuco y puestos de la ruta Q-45.' },
    { plato: 'Hongos silvestres (changle, digüeñe)', descripcion: 'En otoño (marzo-mayo) los bosques de Nothofagus producen hongos nativos como el changle y el digüeñe. Los restaurantes rurales los ofrecen salteados con ajo o en tortilla campesina.' },
  ],

  alojamiento: [
    { nombre: 'Antucalhue Mountain Resort', tipo: 'Cabañas', precioDesde: 'Consultar', url: 'https://www.antucalhue.cl', descripcion: 'Resort de montaña en Ruta Q-45 km 82, a 2 km de los saltos. Cabañas con calefacción, cocina equipada, piscina al aire libre y quincho. Registro SERNATUR. Tel: +56 9 6849 6340.' },
    { nombre: 'Altos de Malalcura', tipo: 'Parque de aventura', precioDesde: 'Consultar', url: 'https://www.instagram.com/altosdemalalcura/', descripcion: 'En Ruta Q-45 km 80, contiguo a los saltos. Canopy, rappel, escalada y acceso directo al sendero de las cascadas. Más de 15 años de operación. Tel: +56 9 7427 7508.' },
    { nombre: 'Camping Malalcura', tipo: 'Camping', precioDesde: 'Consultar', url: '#', descripcion: 'Camping en la Ruta Q-45 con ruca mapuche. Punto de partida oficial del sendero a los saltos. Contactar vía Facebook para reservas.' },
    { nombre: 'EcoHotel Antuco', tipo: 'Hotel boutique', precioDesde: 'Desde ~$50.000 CLP', url: 'https://volcanantuco.com/alojamiento/', descripcion: '5 habitaciones con vista a la cordillera en Antuco, a 30 km de los saltos. Restaurant, WiFi, lavandería. Tel: +56 9 6715 3242.' },
    { nombre: 'Cabañas Curalemu', tipo: 'Cabañas', precioDesde: 'Consultar', url: 'https://volcanantuco.com/alojamiento/', descripcion: 'En km 55 del camino a Antuco (35 km de los saltos). 10 cabañas para 4-6 personas. Piscina estacional, sala de juegos, senderos. Tel: +56 9 7455 6548.' },
  ],

  faq: [
    { pregunta: '¿Qué son los Saltos de Malalcura?', respuesta: 'Los Saltos de Malalcura son una serie de al menos 6 cascadas y toboganes naturales que forma el Río Malalcura al descender por una formación granítica blanca en Antuco, Región del Biobío. Su nombre en mapudungún significa \'corral de piedra\'. Las aguas tienen pureza excepcional al filtrarse por escoria volcánica.' },
    { pregunta: '¿Cómo se llega a los Saltos de Malalcura?', respuesta: 'Se accede por la Ruta Q-45 (Los Ángeles-Laguna del Laja), aproximadamente en el km 80. El salto mayor es visible desde la carretera. Para recorrer todos los saltos se debe solicitar acceso en el Camping Malalcura y realizar una caminata de unas 2 horas.' },
    { pregunta: '¿Cuánto cuesta la entrada a los Saltos de Malalcura?', respuesta: 'No hay tarifa oficial pública verificada. Se debe consultar directamente con el Camping Malalcura o con Altos de Malalcura (+56 9 7427 7508). Los saltos están fuera del Parque Nacional Laguna del Laja, por lo que no requieren entrada CONAF.' },
    { pregunta: '¿Los Saltos de Malalcura están dentro del Parque Nacional?', respuesta: 'No. Los Saltos de Malalcura se ubican en el km 80 de la Ruta Q-45, antes de la entrada al Parque Nacional Laguna del Laja (km 94-97). El acceso no requiere entrada CONAF. El parque Altos de Malalcura y el Camping Malalcura gestionan el acceso al sendero.' },
    { pregunta: '¿Qué dificultad tiene el sendero?', respuesta: 'El sendero tiene dificultad moderada. La caminata de ida dura unas 2 horas por bosque nativo denso. Las rocas graníticas húmedas son muy resbaladizas, se recomienda calzado de trekking con suela antideslizante y bastones.' },
    { pregunta: '¿Cuál es la mejor época para visitar?', respuesta: 'De noviembre a marzo (primavera-verano austral). Temperaturas agradables (20-30°C), senderos accesibles y caudal óptimo alimentado por el deshielo de la Sierra Velluda. En invierno el sector puede tener nieve y el sendero ser intransitable.' },
    { pregunta: '¿Qué animal especial se puede ver en el sendero?', respuesta: 'El sendero es uno de los pocos lugares donde se avista fácilmente la mariposa del chagual (Castnia eudesmia), la mariposa más grande de Chile. También es posible observar cóndores andinos sobrevolando la Sierra Velluda.' },
  ],
};

// ─── STRUCTURED DATA ────────────────────────────────────────────────────────
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'TouristAttraction',
    name: cascada.nombre,
    description: `Serie de ${cascada.numeroBrazos} cascadas de ${cascada.altura} metros promedio sobre formación granítica blanca en Antuco, Región del ${cascada.region}, Chile. Sendero de 2 horas por bosque de Nothofagus.`,
    image: `https://cascadaschile.com${cascada.imagen}`,
    geo: {
      '@type': 'GeoCoordinates',
      latitude: cascada.lat,
      longitude: cascada.lng,
    },
    address: {
      '@type': 'PostalAddress',
      addressRegion: cascada.region,
      addressLocality: cascada.zona,
      addressCountry: 'CL',
    },
    touristType: ['Naturaleza', 'Trekking', 'Aventura', 'Fotografía'],
    url: `https://cascadaschile.com/cascadas/${cascada.slug}`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: cascada.faq.map(f => ({
      '@type': 'Question',
      name: f.pregunta,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.respuesta,
      },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://cascadaschile.com/' },
      { '@type': 'ListItem', position: 2, name: 'Cascadas', item: 'https://cascadaschile.com/cascadas' },
      { '@type': 'ListItem', position: 3, name: cascada.region, item: `https://cascadaschile.com/region/${cascada.region.toLowerCase().replace(/\s/g,'-')}` },
      { '@type': 'ListItem', position: 4, name: cascada.nombre },
    ],
  },
];

const pageTitle = `${cascada.nombre} — Guía completa, cómo llegar y qué hacer | Cascadas de Chile`;
const pageDescription = `${cascada.nombre}: ${cascada.numeroBrazos} cascadas de ${cascada.altura} m sobre granito blanco en Antuco, ${cascada.region}. Cómo llegar, sendero, canopy, alojamiento y toda la información.`;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  ogImage={`https://cascadaschile.com${cascada.imagen}`}
  structuredData={structuredData}
>

  <!-- ─── 1. HERO ──────────────────────────────────────────────────────────── -->
  <section class="cascada-hero">
    <img src={cascada.imagen} alt={cascada.imagenAlt} class="cascada-hero__bg" width="1600" height="1200" decoding="async" fetchpriority="high" />
    <div class="cascada-hero__overlay"></div>
    <div class="cascada-hero__content">
      <nav class="cascada-breadcrumb">
        <a href="/">Inicio</a>
        <span>›</span>
        <a href="/cascadas/">Cascadas</a>
        <span>›</span>
        <a href={`/region/${cascada.region.toLowerCase().replace(/\s/g,'-')}`}>{cascada.region}</a>
        <span>›</span>
        <span class="cascada-breadcrumb__current">{cascada.nombre}</span>
      </nav>

      <div class="cascada-hero__bottom">
        <div>
          <span class="cascada-badge">{cascada.region}</span>
          <h1 class="cascada-hero__title">{cascada.nombre}</h1>
        </div>
        <div class="cascada-hero__stat">
          <p class="cascada-hero__stat-number">{cascada.altura}m</p>
          <p class="cascada-hero__stat-label">Altura promedio</p>
        </div>
      </div>
    </div>
  </section>


  <!-- ─── 2. FICHA RÁPIDA ─────────────────────────────────────────────────── -->
  <section class="cascada-section cascada-section--cream" style="padding-top:3rem; padding-bottom:3rem;">
    <div class="cascada-ficha">
      {[
        { label: 'Dificultad', value: cascada.dificultad },
        { label: 'Acceso', value: cascada.acceso },
        { label: 'Entrada', value: cascada.entrada },
        { label: 'Mejor época', value: cascada.mejorEpoca },
        { label: 'Río', value: cascada.rio },
        { label: 'Saltos', value: `${cascada.numeroBrazos} cascadas` },
        { label: 'Dist. Santiago', value: `${cascada.distanciaSantiago} km` },
        { label: 'Coordenadas', value: cascada.coordenadas },
      ].map((stat) => (
        <div class="cascada-ficha__item">
          <p class="cascada-ficha__label">{stat.label}</p>
          <p class="cascada-ficha__value">{stat.value}</p>
        </div>
      ))}
    </div>
  </section>


  <!-- ─── 3. DESCRIPCIÓN ──────────────────────────────────────────────────── -->
  <section class="cascada-section cascada-section--cream">
    <div class="cascada-two-col">
      <div class="reveal">
        <h2 class="cascada-h2">Sobre los {cascada.nombre}</h2>
        <p class="cascada-body">Los Saltos de Malalcura son una serie de al menos seis cascadas y toboganes naturales que el Río Malalcura —cuyo nombre en mapudungún significa 'corral de piedra'— forma al descender por una imponente formación granítica de origen intrusivo. El granito, de fuerte contenido de cuarzo, exhibe un llamativo color blanco brillante que contrasta con la vegetación de bosque nativo que lo rodea.</p>
        <p class="cascada-body">Las aguas tienen una pureza excepcional: se filtran a través del subsuelo de escoria volcánica del complejo <a href="/cascadas/salto-trubunleo/" class="cascada-inline-link">Volcán Antuco</a>, con origen en la Laguna del Laja y el Estero El Toro. La formación geológica corresponde a un antiguo valle glaciario colgado labrado en el plutón granodiorítico, rellenado posteriormente por coladas de lava de la Sierra Velluda. A diferencia de las <a href="/cascadas/cascadas-parque-nacional-laguna-del-laja/" class="cascada-inline-link">cascadas del Parque Nacional Laguna del Laja</a> ubicadas en el km 94, los Saltos de Malalcura se encuentran fuera del parque (km 80) y no requieren entrada CONAF.</p>
        <p class="cascada-body">Los Saltos de Malalcura forman parte de la Ruta de las Cascadas del <a href="/region/biobio/" class="cascada-inline-link">Biobío</a>, circuito promovido por SERNATUR que incluye también el <a href="/cascadas/salto-trubunleo/" class="cascada-inline-link">Salto del Trubunleo</a>, el Velo de la Novia, Las Chilcas y el Salto Echeverría, todas en la comuna de Antuco. Son, junto con el <a href="/cascadas/salto-del-laja/" class="cascada-inline-link">Salto del Laja</a>, una de las <a href="/cascadas/" class="cascada-inline-link">cascadas más singulares de Chile</a> por su formación en granito blanco.</p>
      </div>

      <!-- ─── 4. CÓMO LLEGAR + MAPA ──────────────────────────────────────── -->
      <div class="reveal">
