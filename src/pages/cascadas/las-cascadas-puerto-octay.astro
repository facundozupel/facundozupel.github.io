---
import Layout from '../../layouts/Layout.astro';

// ─── DATOS DE LA CASCADA ──────────────────────────────────────────────────────
// Datos verificados por chile-waterfalls-researcher: google maps, tripadvisor, sernatur.cl, canopychile.cl, mar 2026
const cascada = {
  // --- Identificación ---
  nombre: 'Las Cascadas de Puerto Octay',
  slug: 'las-cascadas-puerto-octay',
  region: 'Los Lagos',
  zona: 'Las Cascadas, Puerto Octay',
  altura: 40,
  caudal: 'Régimen pluvio-nival. Alimentadas por deshielo del volcán Osorno y precipitaciones de la zona lacustre; mayor caudal en primavera (octubre-noviembre)',
  dificultad: 'Fácil a moderado',
  acceso: 'Ruta U-55-V desde Puerto Octay hacia Las Cascadas (25 km), camino pavimentado',
  coordenadas: '41°07\'S 72°30\'W',
  mejorEpoca: 'Octubre — Abril',
  entrada: 'Contribución voluntaria',
  horario: 'Acceso libre, sin horario restringido',
  descripcion: `Las Cascadas de Puerto Octay son un conjunto de saltos de agua formados por el Río Blanco Las Cascadas, alimentado por las nieves del volcán Osorno y las abundantes lluvias de la <a href="/region/los-lagos" class="cascada-inline-link">Región de Los Lagos</a>. Ubicadas en la localidad de Las Cascadas, a 25 km de Puerto Octay y a orillas del Lago Llanquihue, estas cascadas ofrecen un espectáculo natural enmarcado por el bosque valdiviano y la imponente vista del volcán Osorno como telón de fondo. Con una caída principal estimada en 40 metros, las cascadas se precipitan sobre roca volcánica en un entorno de selva lluviosa que conserva la magia de los paisajes del sur de Chile.

  La localidad de Las Cascadas es un caserío de origen colonial alemán que debe su nombre precisamente a estos saltos de agua. El pueblo mantiene la arquitectura y el carácter de los asentamientos germanos que se establecieron en la zona a partir de 1852, cuando colonos provenientes de Silesia, Sajonia y otras regiones de Alemania llegaron al Lago Llanquihue por iniciativa del gobierno chileno. Esta herencia se refleja en las casas de madera con techos empinados, las iglesias luteranas y la gastronomía local, que fusiona tradiciones alemanas con ingredientes chilenos.

  El sendero hasta las cascadas tiene 2,5 km y se recorre en 30-60 minutos. Para quienes buscan más <a href="/cascadas" class="cascada-inline-link">cascadas de Chile</a> en la zona, los <a href="/cascadas/saltos-del-petrohue" class="cascada-inline-link">Saltos del Petrohué</a> se encuentran a una hora de distancia por la ribera sur del Lago Llanquihue.`,
  comoLlegar: `Desde Puerto Octay (25 km, 30 min en auto): Tomar la Ruta U-55-V en dirección sur-este, bordeando la ribera norte del Lago Llanquihue. El camino está pavimentado y la señalización indica "Las Cascadas". El acceso a las cascadas está en el pueblo de Las Cascadas, junto a la iglesia.

  Desde Puerto Varas (60 km, 1 hora): Ruta 225 hacia Ensenada, luego tomar la Ruta V-69 hacia el norte bordeando el Lago Llanquihue hasta Las Cascadas. Ruta escénica con vistas al volcán Osorno.

  Desde Osorno (65 km, 1 hora): Ruta U-40 hasta Puerto Octay, luego Ruta U-55-V hasta Las Cascadas.

  Desde Santiago (978 km, ~11 horas): Ruta 5 Sur hasta Osorno, luego seguir indicaciones a Puerto Octay y Las Cascadas.

  En transporte público: Buses rurales desde Puerto Octay a Las Cascadas operan con frecuencia limitada (2-3 salidas diarias). Desde Osorno hay buses frecuentes a Puerto Octay (Buses Expresos Lagos del Sur). No hay transporte público directo desde Puerto Varas.`,
  imagen: '/assets/cascadas/las-cascadas-puerto-octay/hero.webp',
  imagenAlt: 'Puerto Octay y Lago Llanquihue con vista al volcán Osorno, Región de Los Lagos',
  galeria: [
    { src: '/assets/cascadas/las-cascadas-puerto-octay/galeria-1.webp', alt: 'Panorámica de Puerto Octay junto al Lago Llanquihue, Región de Los Lagos' },
    { src: '/assets/cascadas/las-cascadas-puerto-octay/galeria-2.webp', alt: 'Puerto Octay, pueblo de origen colonial alemán en la ribera del Lago Llanquihue' },
    { src: '/assets/cascadas/las-cascadas-puerto-octay/galeria-3.webp', alt: 'Lago Rupanco, lago volcánico cercano a Las Cascadas de Puerto Octay' },
    { src: '/assets/cascadas/las-cascadas-puerto-octay/galeria-4.webp', alt: 'Sector Las Gaviotas del Lago Rupanco, paisaje lacustre de la Región de Los Lagos' },
  ],
  galeriaCreditos: [
    { autor: 'Eurimaco', licencia: 'CC BY 3.0', url: 'https://commons.wikimedia.org/wiki/File:Puerto_Octay_Chile_panoramio_eurimaco.jpg' },
    { autor: 'Jensjunge', licencia: 'CC BY-SA 3.0', url: 'https://commons.wikimedia.org/wiki/File:Puerto_Octay.jpg' },
    { autor: 'Carlosreusser', licencia: 'CC BY-SA 3.0', url: 'https://commons.wikimedia.org/wiki/File:Lago_rupanco.jpg' },
    { autor: 'Carlosreusser', licencia: 'CC BY-SA 3.0', url: 'https://commons.wikimedia.org/wiki/File:Lago_Rupanco_Sector_Las_Gaviotas.jpg' },
  ],
  // 3 por cercanía geográfica (Los Lagos / regiones adyacentes)
  cascadasCercanas: [
    { nombre: 'Saltos del Petrohué', slug: 'saltos-del-petrohue', region: 'Los Lagos', altura: 20, tipo: 'cercania' },
    { nombre: 'Salto del Huilo-Huilo', slug: 'salto-del-huilo-huilo', region: 'Los Ríos', altura: 37, tipo: 'cercania' },
    { nombre: 'Salto de Riñinahue', slug: 'salto-de-rininahue', region: 'Los Ríos', altura: 27, tipo: 'cercania' },
  ],
  // 3 por relación semántica (ecoturismo familiar, acceso fácil, paisaje lacustre)
  cascadasRelacionadas: [
    { nombre: 'Salto del Laja', slug: 'salto-del-laja', region: 'Biobío', altura: 35, tipo: 'relacionada' },
    { nombre: 'Cascada de las Ánimas', slug: 'cascada-de-las-animas', region: 'Metropolitana', altura: 60, tipo: 'relacionada' },
    { nombre: 'Salto del Claro', slug: 'salto-del-claro', region: 'La Araucanía', altura: 90, tipo: 'relacionada' },
  ],

  // --- Datos verificados ---
  lat: -41.1200,
  lng: -72.5000,
  rio: 'Río Blanco Las Cascadas',
  tipoFormacion: 'Cascadas escalonadas sobre roca volcánica en bosque valdiviano',
  numeroBrazos: 2,
  distanciaSantiago: 978,

  historia: `La historia de Las Cascadas de Puerto Octay está entrelazada con la colonización alemana del sur de Chile, uno de los procesos migratorios más significativos del siglo XIX en América del Sur. En 1845, el gobierno chileno promulgó la Ley de Inmigración Selectiva y encargó al agente Vicente Pérez Rosales la organización de la llegada de colonos europeos. A partir de 1852, familias provenientes de Silesia, Sajonia, Hesse y otras regiones de la Confederación Germánica comenzaron a arribar al Lago Llanquihue, atraídas por la promesa de tierras fértiles y libertad religiosa.

  Los colonos que se asentaron en lo que hoy es Las Cascadas encontraron un paisaje dominado por el bosque valdiviano impenetrable. La tala del bosque para abrir terrenos agrícolas fue un trabajo monumental que tomó décadas. Las cascadas del Río Blanco sirvieron como punto de referencia geográfico y fuente de energía: los primeros molinos hidráulicos de la zona se instalaron aprovechando la fuerza de estas caídas de agua. El pueblo que creció alrededor de las cascadas adoptó naturalmente el nombre "Las Cascadas", que conserva hasta hoy.

  Puerto Octay, la comuna a la que pertenece la localidad, fue fundado oficialmente en 1891, aunque el asentamiento existía desde la década de 1850. Su nombre combina "Puerto" (por ser punto de embarque en el Lago Llanquihue) y "Octay" (del mapudungún "Okthai", que significa "lugar de retamas"). La comuna conserva un patrimonio arquitectónico alemán notable, declarado Zona Típica por el Consejo de Monumentos Nacionales. La <a href="/region/los-lagos" class="cascada-inline-link">Región de Los Lagos</a> concentra el legado más vivo de la colonización alemana en Chile, y Las Cascadas es un punto donde naturaleza e historia convergen.`,

  queHacer: [
    { actividad: 'Trekking al mirador de las cascadas', descripcion: 'Sendero de 2,5 km (ida) que atraviesa bosque valdiviano hasta el mirador principal de las cascadas. Dificultad baja a moderada, apto para familias. Duración: 30-60 minutos. El sendero está parcialmente habilitado con pasarelas de madera en los tramos húmedos.' },
    { actividad: 'Canopy sobre el bosque', descripcion: 'Canopy Chile opera un circuito de tirolesas sobre las copas de los árboles del bosque valdiviano, con vista a las cascadas y al volcán Osorno. Empresa registrada en SERNATUR. Apto para mayores de 8 años. Reserva previa recomendada.' },
    { actividad: 'Paseo lacustre por el Lago Llanquihue', descripcion: 'Desde Las Cascadas se puede navegar el Lago Llanquihue, el segundo lago más grande de Chile (860 km²). Embarcaciones de paseo ofrecen recorridos de 1-2 horas con vista al volcán Osorno, Calbuco y Puntiagudo.' },
    { actividad: 'Recorrido por patrimonio colonial alemán', descripcion: 'Puerto Octay conserva un patrimonio arquitectónico alemán declarado Zona Típica. El Museo El Colono documenta la llegada de los colonos alemanes al Lago Llanquihue desde 1852. Recorrido a pie por las casas coloniales, la iglesia luterana y la costanera.' },
    { actividad: 'Pesca deportiva', descripcion: 'El Lago Llanquihue y el Río Blanco ofrecen pesca de trucha arcoíris y trucha marrón. Temporada: noviembre a abril. Se requiere licencia de pesca de SERNAPESCA. Guías locales disponibles en Puerto Octay.' },
    { actividad: 'Fotografía de volcanes y lagos', descripcion: 'Las Cascadas es un punto privilegiado para fotografiar el volcán Osorno (2.652 m) reflejado en el Lago Llanquihue. Mejor luz al amanecer y al atardecer. En días despejados también se ven los volcanes Calbuco y Puntiagudo.' },
  ],

  flora: `La vegetación que rodea las cascadas pertenece a la selva valdiviana, el bosque templado lluvioso que se extiende desde la Región del Biobío hasta la Región de Aysén. El dosel arbóreo está compuesto por coigüe (Nothofagus dombeyi), ulmo (Eucryphia cordifolia) —cuyas flores blancas en verano producen una de las mieles más apreciadas de Chile— y olivillo (Aextoxicon punctatum). El arrayán (Luma apiculata), con su corteza cobriza y lisa, forma bosquetes puros en las riberas del Río Blanco.

  El sotobosque es extraordinariamente húmedo y diverso. Helechos de gran tamaño como la palmilla (Lophosoria quadripinnata) y la costilla de vaca (Blechnum chilense) dominan el estrato herbáceo. Las nalcas (Gunnera tinctoria) bordean los cursos de agua con sus hojas monumentales. El copihue (Lapageria rosea), flor nacional de Chile, trepa por los troncos junto a enredaderas como la botellita (Mitraria coccinea). Musgos, líquenes y plantas epífitas cubren cada superficie disponible, creando un paisaje de verde intenso que contrasta con la espuma blanca de las cascadas. Los <a href="/cascadas/saltos-del-petrohue" class="cascada-inline-link">Saltos del Petrohué</a>, en la ribera sur del mismo lago, comparten esta composición florística de selva valdiviana lacustre.`,

  fauna: `La fauna de Las Cascadas y su entorno lacustre es representativa del bosque valdiviano y los ecosistemas acuáticos del Lago Llanquihue. En las aguas del río y del lago, la trucha arcoíris (Oncorhynchus mykiss) y la trucha marrón (Salmo trutta), especies introducidas para pesca deportiva, son abundantes. El martín pescador (Megaceryle torquata) es habitante permanente del río, y el huairavo (Nycticorax nycticorax) se posa en las ramas sobre las pozas.

  En el bosque circundante, el chucao (Scelorchilus rubecula) delata su presencia con su canto desde el sotobosque. El carpintero negro (Campephilus magellanicus) habita los árboles maduros del bosque valdiviano, y el fío-fío (Elaenia albiceps) es visitante frecuente en verano. El pudú (Pudu puda), el ciervo más pequeño del mundo, es habitante discreto del sotobosque denso. En el lago, el cisne de cuello negro (Cygnus melancoryphus) y diversas especies de patos forman parte del paisaje acuático. El huillín (Lontra provocax), nutria de río en peligro de extinción, ha sido registrado en cursos de agua de la zona.`,

  clima: {
    tipo: 'Templado oceánico lluvioso (Cfb)',
    tempPromedio: '10°C',
    tempVerano: '16-24°C',
    tempInvierno: '3-10°C',
    precipitaciones: '1.800 mm anuales',
    descripcion: 'Clima templado oceánico con precipitaciones bien distribuidas durante el año, concentradas entre mayo y septiembre. Los veranos son agradables con temperaturas que pueden alcanzar los 25°C en días despejados, aunque las lluvias son posibles en cualquier época. En invierno, las temperaturas nocturnas bajan a 0°C y las nevadas pueden cubrir las cumbres del volcán Osorno hasta niveles bajos. La mejor época para visitar es de octubre a abril, con mayor probabilidad de días despejados y vistas del volcán. Llevar siempre ropa impermeable: el clima del Lago Llanquihue es cambiante y las lluvias pueden aparecer sin aviso.',
  },

  seguridad: [
    'Llevar ropa impermeable: las lluvias son frecuentes e impredecibles en cualquier época del año',
    'El sendero puede estar resbaladizo por la humedad permanente: usar calzado con suela adherente',
    'Respetar las señalizaciones y no salirse del sendero marcado',
    'En invierno, verificar el estado del camino rural antes de salir: puede haber barro o anegamientos',
    'No nadar en las pozas cercanas a las cascadas: las corrientes pueden ser fuertes, especialmente en primavera',
    'Llevar protección solar en verano: los claros del bosque y el reflejo del lago intensifican la radiación UV',
    'Si se realiza canopy, verificar que el operador tenga registro SERNATUR vigente',
  ],

  recomendaciones: [
    'Ropa impermeable y cortavientos (imprescindible en cualquier época)',
    'Calzado de trekking resistente al agua',
    'Capas térmicas en invierno y meses de transición',
    'Cámara fotográfica (volcán Osorno como telón de fondo)',
    'Binoculares para observación de aves en el lago',
    'Mínimo 1 litro de agua y snacks',
    'Efectivo para contribución voluntaria y servicios locales',
    'Mapa offline o GPS: la señal de celular puede ser intermitente en la zona rural',
  ],

  gastronomia: [
    { plato: 'Kuchen y strudel alemán', descripcion: 'La herencia alemana se expresa en la repostería: kuchen de nuez, kuchen de frambuesa, strudel de manzana y tortas con frutos del sur. Las cafeterías de Puerto Octay y Las Cascadas mantienen recetas que datan de la época colonial.' },
    { plato: 'Trucha del Lago Llanquihue', descripcion: 'Trucha arcoíris y trucha marrón del Lago Llanquihue, preparadas al horno, a la parrilla o ahumadas con madera de manzano. Los restaurantes de Puerto Octay y la costanera la ofrecen fresca del lago.' },
    { plato: 'Curanto y milcao', descripcion: 'El curanto al hoyo (mariscos, carnes y papas cocinados bajo tierra) y el milcao (tortilla de papa rallada frita) son platos emblematicos de la cocina chilota que también se prepara en los pueblos del Lago Llanquihue.' },
    { plato: 'Cerveza artesanal lacustre', descripcion: 'La zona del Lago Llanquihue tiene una escena cervecera artesanal en crecimiento, heredera de la tradición cervecera alemana. Cervecerías en Frutillar, Puerto Varas y Puerto Octay producen lagers, weizen y bock con ingredientes locales.' },
    { plato: 'Miel de ulmo', descripcion: 'El ulmo (Eucryphia cordifolia) florece en verano y produce una miel monofloral de color ámbar claro con propiedades antibacterianas reconocidas. Se encuentra en ferias y tiendas artesanales de Puerto Octay y la zona lacustre.' },
  ],

  alojamiento: [
    { nombre: 'Hotel & Lodge Las Cascadas', tipo: 'Lodge de montaña', precioDesde: 'Desde $90.000 CLP/noche', url: '#', descripcion: 'Lodge ubicado junto a las cascadas con vista al volcán Osorno. Habitaciones con calefacción, restaurante con cocina regional y acceso directo a los senderos. La opción más cercana a las cascadas.' },
    { nombre: 'Cabañas Calma', tipo: 'Cabañas equipadas', precioDesde: 'Desde $65.000 CLP/noche', url: '#', descripcion: 'Cabañas de madera equipadas con cocina, estufa a leña y vista al lago y volcán. Ubicadas en Las Cascadas, a 10 minutos a pie del sendero. Ambiente familiar y tranquilo.' },
    { nombre: 'Hotel Haase', tipo: 'Hotel patrimonial', precioDesde: 'Desde $55.000 CLP/noche', url: '#', descripcion: 'Hotel de arquitectura colonial alemana en el centro de Puerto Octay. Edificio patrimonial restaurado con habitaciones cómodas, restaurante y vista al Lago Llanquihue. A 25 km de las cascadas.' },
  ],

  faq: [
    { pregunta: '¿Dónde están las Cascadas de Puerto Octay?', respuesta: 'Las Cascadas de Puerto Octay se encuentran en la localidad de Las Cascadas, a 25 km de Puerto Octay por la Ruta U-55-V, en la ribera norte del Lago Llanquihue, Región de Los Lagos. El acceso está junto al pueblo de Las Cascadas.' },
    { pregunta: '¿Cuánto cuesta la entrada a Las Cascadas de Puerto Octay?', respuesta: 'El acceso es por contribución voluntaria. No hay una tarifa fija. Se recomienda llevar efectivo para la contribución y para servicios locales.' },
    { pregunta: '¿Se puede visitar Las Cascadas con niños?', respuesta: 'Sí, el sendero de 2,5 km es apto para familias con niños mayores de 5 años. La dificultad es baja a moderada, con pasarelas de madera en los tramos húmedos. También hay canopy apto para mayores de 8 años.' },
    { pregunta: '¿Cuál es la mejor época para visitar Las Cascadas de Puerto Octay?', respuesta: 'De octubre a abril es la mejor época, con temperaturas agradables (16-24°C) y mayor probabilidad de días despejados con vista al volcán Osorno. En primavera (octubre-noviembre) el caudal de las cascadas es máximo por el deshielo.' },
    { pregunta: '¿Cómo llegar a Las Cascadas desde Puerto Varas?', respuesta: 'Desde Puerto Varas son 60 km (1 hora en auto). Se toma la Ruta 225 hacia Ensenada y luego la Ruta V-69 bordeando el Lago Llanquihue hacia el norte. La ruta es escénica con vistas al volcán Osorno durante todo el trayecto.' },
    { pregunta: '¿Qué otras actividades hay en la zona de Las Cascadas?', respuesta: 'Además del sendero a las cascadas, la zona ofrece canopy sobre el bosque valdiviano (Canopy Chile), paseos en bote por el Lago Llanquihue, pesca deportiva de truchas, recorrido por el patrimonio colonial alemán de Puerto Octay y visita al Museo El Colono.' },
    { pregunta: '¿Cuánto miden Las Cascadas de Puerto Octay?', respuesta: 'La cascada principal tiene una caída estimada de 40 metros. El conjunto incluye varios saltos escalonados sobre roca volcánica, alimentados por el Río Blanco Las Cascadas que nace del deshielo del volcán Osorno.' },
  ],
};

// ─── STRUCTURED DATA ────────────────────────────────────────────────────────
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'TouristAttraction',
    name: cascada.nombre,
    description: `Cascadas de ${cascada.altura} metros alimentadas por el volcán Osorno en Puerto Octay, Lago Llanquihue, Región de Los Lagos. Sendero por bosque valdiviano, canopy y patrimonio colonial alemán.`,
    image: `https://cascadaschile.com${cascada.imagen}`,
    geo: {
      '@type': 'GeoCoordinates',
      latitude: cascada.lat,
      longitude: cascada.lng,
    },
    address: {
      '@type': 'PostalAddress',
      addressRegion: cascada.region,
      addressLocality: cascada.zona,
      addressCountry: 'CL',
    },
    isAccessibleForFree: true,
    touristType: ['Naturaleza', 'Ecoturismo', 'Trekking', 'Patrimonio'],
    url: `https://cascadaschile.com/cascadas/${cascada.slug}`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: cascada.faq.map(f => ({
      '@type': 'Question',
      name: f.pregunta,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.respuesta,
      },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://cascadaschile.com/' },
      { '@type': 'ListItem', position: 2, name: 'Cascadas', item: 'https://cascadaschile.com/cascadas' },
      { '@type': 'ListItem', position: 3, name: cascada.region, item: `https://cascadaschile.com/region/${cascada.region.toLowerCase().replace(/\s/g,'-')}` },
      { '@type': 'ListItem', position: 4, name: cascada.nombre },
    ],
  },
];

const pageTitle = `${cascada.nombre} — Guía completa, cómo llegar y qué hacer | Cascadas de Chile`;
const pageDescription = `${cascada.nombre}: cascadas de ${cascada.altura} m junto al Lago Llanquihue y el volcán Osorno. Sendero, canopy, patrimonio alemán. Entrada libre, cómo llegar y toda la información.`;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  ogImage={`https://cascadaschile.com${cascada.imagen}`}
  structuredData={structuredData}
>

  <!-- ─── 1. HERO ──────────────────────────────────────────────────────────── -->
  <section class="cascada-hero">
    <img src={cascada.imagen} alt={cascada.imagenAlt} class="cascada-hero__bg" width="1600" height="1067" decoding="async" fetchpriority="high" />
    <div class="cascada-hero__overlay"></div>
    <div class="cascada-hero__content">
      <nav class="cascada-breadcrumb">
        <a href="/">Inicio</a>
        <span>›</span>
        <a href="/cascadas">Cascadas</a>
        <span>›</span>
        <a href={`/region/${cascada.region.toLowerCase().replace(/\s/g,'-')}`}>{cascada.region}</a>
        <span>›</span>
        <span class="cascada-breadcrumb__current">{cascada.nombre}</span>
      </nav>

      <div class="cascada-hero__bottom">
        <div>
          <span class="cascada-badge">{cascada.region}</span>
          <h1 class="cascada-hero__title">{cascada.nombre}</h1>
        </div>
        <div class="cascada-hero__stat">
          <p class="cascada-hero__stat-number">{cascada.altura}m</p>
          <p class="cascada-hero__stat-label">Altura de caída</p>
        </div>
      </div>
    </div>
  </section>


  <!-- ─── 2. FICHA RÁPIDA ─────────────────────────────────────────────────── -->
  <section class="cascada-section cascada-section--cream" style="padding-top:3rem; padding-bottom:3rem;">
    <div class="cascada-ficha">
      {[
        { label: 'Dificultad', value: cascada.dificultad },
        { label: 'Acceso', value: cascada.acceso },
        { label: 'Entrada', value: cascada.entrada },
        { label: 'Mejor época', value: cascada.mejorEpoca },
        { label: 'Río', value: cascada.rio },
        { label: 'Brazos', value: `${cascada.numeroBrazos} brazos` },
        { label: 'Dist. Santiago', value: `${cascada.distanciaSantiago} km` },
        { label: 'Coordenadas', value: cascada.coordenadas },
      ].map((stat) => (
        <div class="cascada-ficha__item">
          <p class="cascada-ficha__label">{stat.label}</p>
          <p class="cascada-ficha__value">{stat.value}</p>
        </div>
      ))}
    </div>
  </section>


