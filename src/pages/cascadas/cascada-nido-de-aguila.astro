---
import Layout from '../../layouts/Layout.astro';

// ─── DATOS DE LA CASCADA ──────────────────────────────────────────────────────
// Datos verificados por chile-waterfalls-researcher: CONAF, OpenStreetMap nodo 1695450914, Wikimedia, mar 2026
const cascada = {
  // --- Identificación ---
  nombre: 'Cascada Nido de Águila',
  slug: 'cascada-nido-de-aguila',
  region: 'La Araucanía',
  zona: 'Pucón',
  altura: 50,
  caudal: 'Régimen pluvio-nival. Mayor caudal en primavera (octubre-noviembre) por deshielo; caudal perenne gracias al régimen de lluvias de la zona (1.800-2.500 mm anuales)',
  dificultad: 'Moderado',
  acceso: 'Sendero Los Lagos, Parque Nacional Huerquehue. Últimos 8 km de ripio desde desvío Paillaco',
  coordenadas: '39°08\'S 71°42\'W',
  mejorEpoca: 'Octubre — Marzo',
  entrada: 'Entrada PN Huerquehue vía pasesparques.cl (~$5.000 CLP adulto nacional)',
  horario: 'Martes a domingo, 8:30 a 18:00. Último ingreso: 14:00. Cerrado los lunes',
  descripcion: `La Cascada Nido de Águila es una de las joyas escondidas del Parque Nacional Huerquehue, en la comuna de Pucón, <a href="/region/araucania/" class="cascada-inline-link">Región de La Araucanía</a>. Ubicada a unos 50 metros de altura sobre un anfiteatro de roca volcánica andina, esta cascada se alimenta de un arroyo que drena los lagos interiores del parque — Lago Chico, Lago Toro y Lago Verde — antes de descender hacia el lago Tinquilco. Su nombre evoca la posición elevada y accidentada donde el agua se precipita, como el nido de un águila en una pared rocosa inaccesible.

  Lo que hace especial a esta cascada es su ubicación dentro de uno de los bosques de araucarias más antiguos y mejor conservados de Chile. El acceso se realiza por el Sendero Los Lagos, un recorrido de 8,8 km que atraviesa bosque templado lluvioso con araucarias milenarias, coihues, lengas y un sotobosque exuberante de helechos y musgos. A solo 240 metros de la Cascada Nido de Águila se encuentra la Cascada Trufulco, formando un par de saltos de agua sobre el mismo curso que ofrece uno de los espectáculos naturales más impresionantes de la zona de Pucón.

  El Parque Nacional Huerquehue es parte de la Reserva de la Biosfera Araucarias (UNESCO, 1983) y protege 12.500 hectáreas de bosque nativo andino. Para quienes buscan explorar más <a href="/cascadas/" class="cascada-inline-link">cascadas de Chile</a> en la zona, el <a href="/cascadas/salto-del-claro/" class="cascada-inline-link">Salto del Claro</a> a 27 km de Pucón y el <a href="/cascadas/salto-truful-truful/" class="cascada-inline-link">Salto Truful-Truful</a> en el Parque Nacional Conguillío completan un circuito de cascadas araucanas excepcional.`,
  comoLlegar: `Desde Pucón (21 km, 35-45 min en auto): Tomar el camino hacia Lago Caburgua (dirección este). En el sector Paillaco, seguir el desvío señalizado hacia el Parque Nacional Huerquehue. Los últimos 8 km son de camino de ripio hasta la zona de administración del parque. Desde ahí, tomar el Sendero Los Lagos (señalizado con color naranja, 8,8 km totales) que lleva a la cascada.

  Desde Temuco (135 km, 2-2,5 horas): Ruta 199 dirección Villarrica (70 km), continuar a Pucón (25 km) y desde ahí seguir las indicaciones hacia Huerquehue.

  Desde Santiago (850 km, ~9-10 horas en auto): Ruta 5 Sur hasta Temuco (585 km), luego Ruta 199 hacia Villarrica y Pucón, y desde Pucón seguir indicaciones anteriores.

  En transporte público: Buses desde Temuco a Pucón (Buses JAC, 2 horas). Desde Pucón no hay bus directo al parque. Se recomienda contratar taxi, remise o tour organizado. Algunos operadores de Pucón ofrecen traslados al parque.`,
  imagen: '/assets/cascadas/cascada-nido-de-aguila/hero.webp',
  imagenAlt: 'Cascada Nido de Águila en el Parque Nacional Huerquehue, Pucón, La Araucanía',
  galeria: [
    { src: '/assets/cascadas/cascada-nido-de-aguila/galeria-1.webp', alt: 'Cascada Trufulco, salto de agua vecino a la Cascada Nido de Águila en PN Huerquehue' },
    { src: '/assets/cascadas/cascada-nido-de-aguila/galeria-2.webp', alt: 'Vista de la Cascada Trufulco entre bosque de araucarias en el Parque Nacional Huerquehue' },
    { src: '/assets/cascadas/cascada-nido-de-aguila/galeria-3.webp', alt: 'Lago Tinquilco con el Volcán Villarrica al fondo, Parque Nacional Huerquehue' },
    { src: '/assets/cascadas/cascada-nido-de-aguila/galeria-4.webp', alt: 'Interior del bosque nativo de araucarias en el sendero del Parque Nacional Huerquehue' },
  ],
  galeriaCreditos: [
    { autor: 'Falk2', licencia: 'CC BY-SA 4.0', url: 'https://commons.wikimedia.org/wiki/File:J25_167_Wasserfall_%C2%BBNido_de_Aguila%C2%AB.jpg' },
    { autor: 'Falk2', licencia: 'CC BY-SA 4.0', url: 'https://commons.wikimedia.org/wiki/File:J25_170_Cascada_Trufulco.jpg' },
    { autor: 'Falk2', licencia: 'CC BY-SA 4.0', url: 'https://commons.wikimedia.org/wiki/File:J25_174_Cascada_Trufulco.jpg' },
    { autor: 'Elemaki (José Porras)', licencia: 'CC BY 3.0', url: 'https://commons.wikimedia.org/wiki/File:Parque_Nacional_Huerquehue.jpg' },
    { autor: 'Marco Antonio Correa Flores', licencia: 'CC BY-SA 3.0', url: 'https://commons.wikimedia.org/wiki/File:Parque_Nacional_Huerquehue_01.jpg' },
  ],
  // 3 por cercanía geográfica (Pucón / Araucanía volcánica)
  cascadasCercanas: [
    { nombre: 'Salto del Claro', slug: 'salto-del-claro', region: 'La Araucanía', altura: 90, tipo: 'cercania' },
    { nombre: 'Salto Truful-Truful', slug: 'salto-truful-truful', region: 'La Araucanía', altura: 20, tipo: 'cercania' },
    { nombre: 'Salto de la Princesa', slug: 'salto-de-la-princesa', region: 'La Araucanía', altura: 25, tipo: 'cercania' },
  ],
  // 3 por relación semántica (parques nacionales, bosque nativo, trekking moderado)
  cascadasRelacionadas: [
    { nombre: 'Salto del Huilo-Huilo', slug: 'salto-del-huilo-huilo', region: 'Los Ríos', altura: 37, tipo: 'relacionada' },
    { nombre: 'Salto Chancagua', slug: 'salto-chancagua', region: 'La Araucanía', altura: 70, tipo: 'relacionada' },
    { nombre: 'Salto Quino', slug: 'salto-quino', region: 'La Araucanía', altura: 30, tipo: 'relacionada' },
  ],

  // --- Datos verificados ---
  lat: -39.1481,
  lng: -71.7105,
  rio: 'Arroyo afluente del lago Tinquilco',
  tipoFormacion: 'Caída sobre roca volcánica andina en zona de bosque templado lluvioso',
  numeroBrazos: 1,
  distanciaSantiago: 850,

  historia: `La Cascada Nido de Águila se encuentra en el corazón del territorio ancestral mapuche-pehuenche, pueblos que habitaron los bosques de araucarias de la precordillera andina durante milenios. El nombre "Huerquehue" proviene del mapudungun y se traduce como "lugar de insectos" o "lugar donde abundan los huérquen". Para el pueblo mapuche, las cascadas son espacios de poder espiritual protegidos por el ngen-ko, el espíritu guardián de las aguas. El canelo (Drimys winteri) que crece junto a los cursos de agua es el árbol sagrado más importante de la cultura mapuche.

  Los pehuenche (pewen = araucaria, che = gente) mantienen una relación sagrada con los bosques de araucarias del parque. Los piñones del pehuén son un alimento central de su cultura y cosmovisión, cosechados entre marzo y mayo mediante la práctica ancestral del piñoneo. El agua (ko) es un elemento sagrado con vida propia en la cosmología mapuche, y cada cascada tiene un significado espiritual que trasciende lo meramente natural.

  El Parque Nacional Huerquehue fue creado el 9 de junio de 1967 mediante Decreto Supremo N°347 para proteger los bosques de araucaria de la precordillera andina de La <a href="/region/araucania/" class="cascada-inline-link">Araucanía</a>. En 1983 fue integrado a la Reserva de la Biosfera Araucarias, declarada por UNESCO, reconociendo su valor ecológico excepcional. Hoy el parque protege 12.500 hectáreas de bosque nativo y alberga una red de senderos que conecta lagos, cascadas y bosques milenarios, consolidándose como uno de los destinos de trekking más valorados del sur de Chile.`,

  queHacer: [
    { actividad: 'Sendero Los Lagos', descripcion: 'Trekking de 8,8 km por bosque de araucarias milenarias, coihues y lengas. El sendero conecta los lagos interiores del parque (Lago Toro, Lago Chico, Lago Verde) y pasa por la Cascada Nido de Águila y la Cascada Trufulco. Señalizado con color naranja. Dificultad moderada, 5-7 horas ida y vuelta.' },
    { actividad: 'Fotografía de naturaleza', descripcion: 'El bosque templado lluvioso con araucarias centenarias y la cascada ofrecen composiciones fotográficas excepcionales. La luz difusa del bosque nativo es óptima en días nublados. Llevar gran angular para la cascada y teleobjetivo para aves.' },
    { actividad: 'Observación de aves', descripcion: 'El parque alberga aves emblemáticas del bosque austral: carpintero negro (Campephilus magellanicus), chucao, cóndor andino y más de 40 especies registradas. Los binoculares son imprescindibles en el sendero.' },
    { actividad: 'Camping en el parque', descripcion: 'El Camping CONAF del parque tiene 22 sitios con duchas de agua caliente, cobertizo para cocinar, lavaderos y baños. Asignación por orden de llegada. Ideal para hacer el sendero en dos jornadas y disfrutar el amanecer en el bosque.' },
    { actividad: 'Visita a los lagos interiores', descripcion: 'El Sendero Los Lagos conecta Lago Toro, Lago Chico y Lago Verde, lagunas andinas de aguas cristalinas rodeadas de araucarias. Cada lago ofrece miradores naturales y zonas de descanso.' },
    { actividad: 'Circuito de cascadas de Pucón', descripcion: 'Combinar la visita a Huerquehue con el Salto del Claro (27 km de Pucón, rappel de 90 m) y los Ojos del Caburgua. Un circuito de 2-3 días que revela la diversidad de cascadas de La Araucanía.' },
  ],

  flora: `El bosque del Parque Nacional Huerquehue es uno de los ecosistemas más biodiversos de la cordillera andina del sur de Chile. La especie emblemática es la araucaria (Araucaria araucana), árbol monumento natural que puede superar los 1.000 años de edad y cuya silueta de paraguas define el paisaje del parque. Las araucarias dominan en las zonas de mayor altitud, mientras que el coihue (Nothofagus dombeyi) y la lenga (Nothofagus pumilio) forman el dosel arbóreo en las zonas medias y bajas.

  El sotobosque es denso y exuberante. Helechos como la palmilla (Lophosoria quadripinnata) y el helecho costilla de vaca (Blechnum chilense) forman masas verdes en las zonas húmedas junto a la cascada. El mañío (Podocarpus nubigena) y el canelo (Drimys winteri), árbol sagrado para el pueblo mapuche, crecen en los sectores más húmedos cercanos a los cursos de agua. La lenga produce un follaje rojizo espectacular en otoño (abril-mayo) que transforma el paisaje del sendero en un tapiz de colores.`,

  fauna: `El Parque Nacional Huerquehue alberga fauna representativa del bosque templado andino, con varias especies endémicas y en categorías de conservación. El pudú (Pudu puda), el cérvido más pequeño del mundo, habita el sotobosque y puede avistarse al amanecer o al atardecer en los bordes del sendero. El monito del monte (Dromiciops gliroides), considerado un "fósil viviente" con un linaje de más de 70 millones de años, es otro habitante nocturno del parque.

  Entre las aves destaca el carpintero negro (Campephilus magellanicus), el más grande de Chile, cuyo golpeteo rítmico resuena en el bosque. El chucao (Scelorchilus rubecula) delata su presencia con un canto penetrante desde el sotobosque. El cóndor andino (Vultur gryphus) sobrevuela las cumbres del parque, y el zorro culpeo (Lycalopex culpaeus) se avista con frecuencia en los senderos. La rana de Darwin (Rhinoderma darwinii), anfibio endémico y vulnerable, habita cerca de los cursos de agua del parque.`,

  clima: {
    tipo: 'Templado lluvioso con influencia andina (Cfb)',
    tempPromedio: '10°C',
    tempVerano: '12-24°C',
    tempInvierno: '0-10°C',
    precipitaciones: '1.800-2.500 mm anuales',
    descripcion: 'Clima templado oceánico transicional hacia lluvioso en la precordillera andina. Los veranos (diciembre-febrero) son frescos y relativamente secos, con temperaturas que pueden alcanzar los 24°C en Pucón pero 5-8°C menos dentro del parque a mayor altitud. Los inviernos son fríos y muy lluviosos, con nevadas frecuentes sobre los 900 msnm. La mejor época para visitar es de octubre a marzo, cuando los senderos están transitables, el clima es estable y el caudal de la cascada es espectacular por el deshielo. Evitar visitas en invierno (junio-agosto) por posibles cierres de caminos.',
  },

  seguridad: [
    'El Sendero Los Lagos tiene 8,8 km — salir temprano (antes de las 9:00 AM) para completar el recorrido antes del cierre del parque a las 18:00',
    'Último ingreso al parque a las 14:00 — no se permite entrar después de esa hora',
    'Calzado de trekking impermeable obligatorio: raíces y musgo del bosque son muy resbaladizos, especialmente tras lluvia',
    'El parque tiene baja cobertura de telefonía celular en el interior — no realizar el sendero solo',
    'No acercarse al borde de la cascada: las rocas son resbaladizas y la caída es peligrosa',
    'No alimentar ni acercarse a la fauna silvestre. En caso de avistamiento de puma, mantener la calma y no correr',
    'No encender fuego fuera de las zonas habilitadas del camping CONAF',
    'El agua de los arroyos puede contener parásitos — llevar agua potable o sistema de purificación',
    'En caso de emergencia contactar a CONAF: parque.huerquehue@conaf.cl',
  ],

  recomendaciones: [
    'Ropa abrigada en capas incluso en verano — el interior del parque puede ser 5-8°C más frío que Pucón',
    'Impermeable o poncho: el bosque templado lluvioso puede recibir precipitaciones en cualquier época',
    'Bastones de trekking (útiles en tramos con raíces y humedad)',
    'Mínimo 2 litros de agua por persona',
    'Binoculares para observación de aves',
    'Repelente de insectos — jejenes y tábanos activos en verano cerca del agua',
    'Mapa offline (OSMand o Maps.me) — sin cobertura celular en el interior del parque',
    'Comprar entrada anticipadamente en pasesparques.cl',
    'Snacks de alta energía (frutos secos, barras de cereal) para el sendero',
    'Cámara fotográfica con funda impermeable para la cascada',
  ],

  gastronomia: [
    { plato: 'Piñones de araucaria (pewén)', descripcion: 'Semilla sagrada de la araucaria, base de la alimentación ancestral mapuche-pehuenche. Se consumen hervidos, asados o molidos en harina. Disponibles en ferias locales de Pucón en otoño (marzo-mayo). Sabor similar a la castaña.' },
    { plato: 'Trucha del lago Villarrica', descripcion: 'Trucha arcoíris capturada en los lagos de la zona, preparada a la plancha, ahumada o a la mantequilla. Plato emblemático de los restaurantes de Pucón y la costanera del lago.' },
    { plato: 'Merkén', descripcion: 'Condimento mapuche de ají cacho de cabra ahumado y molido con semillas de cilantro. Aromatiza carnes, guisos y sopas. Presente en todos los restaurantes de Pucón y La Araucanía.' },
    { plato: 'Asado de cordero al palo', descripcion: 'Cordero de la zona asado lentamente junto a brasas de leña, sazonado con merkén. Plato emblemático de las fiestas costumbristas y restaurantes rurales de La Araucanía.' },
    { plato: 'Catuto (mültrun)', descripcion: 'Preparación ancestral mapuche de trigo cocido y molido, formado en bolitas o bastones. Se consume acompañado de miel, merkén o pebre. Disponible en ferias y restaurantes de Pucón.' },
  ],

  alojamiento: [
    { nombre: 'Camping PN Huerquehue (CONAF)', tipo: 'Camping', precioDesde: 'Desde ~$8.000 CLP/sitio', url: '#', descripcion: '22 sitios para carpas dentro del parque. Duchas con agua caliente, cobertizo para cocinar, lavaderos y baños. Asignación por orden de llegada, sin reserva anticipada. La opción más cercana a la cascada.' },
    { nombre: 'Hotel Antumalal', tipo: 'Hotel boutique', precioDesde: 'Desde $150.000 CLP/noche', url: 'https://www.antumalal.com', descripcion: 'Hotel de diseño Bauhaus de los años 1950 sobre un acantilado del Lago Villarrica. Vista al volcán, spa y restaurante gourmet. En Pucón, a 21 km del parque.' },
    { nombre: 'Hostales en Pucón', tipo: 'Hostal', precioDesde: 'Desde $15.000 CLP/noche', url: '#', descripcion: 'Amplia oferta de hostales en el centro de Pucón con dorms y habitaciones privadas. Lacustre Trip Hostel y Chucao Climbing Hostel son opciones populares entre senderistas.' },
  ],

  faq: [
    { pregunta: '¿Cómo llegar a la Cascada Nido de Águila?', respuesta: 'La cascada se encuentra dentro del Parque Nacional Huerquehue. Desde Pucón (21 km), tomar el camino a Lago Caburgua y desviar en Paillaco hacia el parque (8 km de ripio). Dentro del parque, tomar el Sendero Los Lagos (8,8 km, señalizado en naranja).' },
    { pregunta: '¿Cuánto cuesta la entrada al Parque Nacional Huerquehue?', respuesta: 'La entrada se compra anticipadamente en pasesparques.cl. Las tarifas aproximadas son $5.000-7.000 CLP para adultos nacionales y $10.000-15.000 CLP para extranjeros. Menores de 12 años nacionales entran gratis.' },
    { pregunta: '¿Cuánto dura el sendero a la Cascada Nido de Águila?', respuesta: 'El Sendero Los Lagos tiene 8,8 km totales. Para llegar a la cascada y regresar, el tiempo estimado es de 5 a 7 horas dependiendo del ritmo. Se recomienda salir antes de las 9:00 AM.' },
    { pregunta: '¿Qué dificultad tiene el sendero?', respuesta: 'Dificultad moderada. Requiere buena condición física, calzado de trekking impermeable y resistencia para varias horas de caminata. No es técnicamente exigente. No recomendado para niños menores de 8 años.' },
    { pregunta: '¿Cuál es la mejor época para visitar?', respuesta: 'De octubre a marzo. El verano (diciembre-febrero) ofrece días largos y clima estable. La primavera (octubre-noviembre) tiene el mayor caudal por el deshielo. Evitar el invierno por posibles cierres de caminos y nieve.' },
    { pregunta: '¿Hay camping cerca de la cascada?', respuesta: 'Sí. El Camping CONAF dentro del parque tiene 22 sitios con duchas de agua caliente y cocina. Funciona por orden de llegada. En el camino de acceso hay campings privados como Las Vertientes y Los Pilos.' },
    { pregunta: '¿El parque abre todos los días?', respuesta: 'No. El parque abre de martes a domingo, de 8:30 a 18:00 horas. Último ingreso a las 14:00. Permanece cerrado los lunes.' },
    { pregunta: '¿Hay transporte público al Parque Huerquehue?', respuesta: 'No hay bus directo. Desde Pucón se puede contratar taxi o remise. Algunos operadores turísticos ofrecen traslados. Se recomienda vehículo propio o tour organizado.' },
  ],
};

// ─── STRUCTURED DATA ────────────────────────────────────────────────────────
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'TouristAttraction',
    name: cascada.nombre,
    description: `Cascada de ~${cascada.altura} metros en el Parque Nacional Huerquehue, Pucón, Región de La Araucanía. Trekking por bosque de araucarias milenarias, lagos andinos y fauna nativa.`,
    image: `https://cascadaschile.com${cascada.imagen}`,
    geo: {
      '@type': 'GeoCoordinates',
      latitude: cascada.lat,
      longitude: cascada.lng,
    },
    address: {
      '@type': 'PostalAddress',
      addressRegion: cascada.region,
      addressLocality: cascada.zona,
      addressCountry: 'CL',
    },
    isAccessibleForFree: false,
    touristType: ['Naturaleza', 'Trekking', 'Fotografía', 'Observación de aves'],
    url: `https://cascadaschile.com/cascadas/${cascada.slug}`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: cascada.faq.map(f => ({
      '@type': 'Question',
      name: f.pregunta,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.respuesta,
      },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://cascadaschile.com/' },
      { '@type': 'ListItem', position: 2, name: 'Cascadas', item: 'https://cascadaschile.com/cascadas' },
      { '@type': 'ListItem', position: 3, name: cascada.region, item: `https://cascadaschile.com/region/araucania` },
      { '@type': 'ListItem', position: 4, name: cascada.nombre },
    ],
  },
];

const pageTitle = `${cascada.nombre} — Guía completa, cómo llegar y qué hacer | Cascadas de Chile`;
const pageDescription = `${cascada.nombre}: cascada de ~${cascada.altura} m en el PN Huerquehue, Pucón. Sendero Los Lagos, araucarias milenarias, lagos andinos. Entrada, cómo llegar y toda la información.`;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  ogImage={`https://cascadaschile.com${cascada.imagen}`}
  structuredData={structuredData}
>

  <!-- ─── 1. HERO ──────────────────────────────────────────────────────────── -->
  <section class="cascada-hero">
    <img src={cascada.imagen} alt={cascada.imagenAlt} class="cascada-hero__bg" width="1600" height="1067" decoding="async" fetchpriority="high" />
    <div class="cascada-hero__overlay"></div>
    <div class="cascada-hero__content">
      <nav class="cascada-breadcrumb">
        <a href="/">Inicio</a>
        <span>›</span>
        <a href="/cascadas/">Cascadas</a>
        <span>›</span>
        <a href="/region/araucania">La Araucanía</a>
        <span>›</span>
        <span class="cascada-breadcrumb__current">{cascada.nombre}</span>
      </nav>

      <div class="cascada-hero__bottom">
        <div>
          <span class="cascada-badge">{cascada.region}</span>
          <h1 class="cascada-hero__title">{cascada.nombre}</h1>
        </div>
        <div class="cascada-hero__stat">
          <p class="cascada-hero__stat-number">~{cascada.altura}m</p>
          <p class="cascada-hero__stat-label">Altura de caída</p>
        </div>
      </div>
    </div>
  </section>


  <!-- ─── 2. FICHA RÁPIDA ─────────────────────────────────────────────────── -->
  <section class="cascada-section cascada-section--cream" style="padding-top:3rem; padding-bottom:3rem;">
    <div class="cascada-ficha">
      {[
        { label: 'Dificultad', value: cascada.dificultad },
        { label: 'Acceso', value: cascada.acceso },
        { label: 'Entrada', value: cascada.entrada },
        { label: 'Mejor época', value: cascada.mejorEpoca },
        { label: 'Río', value: cascada.rio },
        { label: 'Brazos', value: `${cascada.numeroBrazos} brazo` },
        { label: 'Dist. Santiago', value: `${cascada.distanciaSantiago} km` },
