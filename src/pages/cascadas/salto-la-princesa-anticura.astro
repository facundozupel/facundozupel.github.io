---
import Layout from '../../layouts/Layout.astro';

// ─── DATOS DE LA CASCADA ──────────────────────────────────────────────────────
// Datos verificados por chile-waterfalls-researcher (mar 2026)
const cascada = {
  nombre: 'Salto La Princesa (Anticura)',
  slug: 'salto-la-princesa-anticura',
  region: 'Los Lagos',
  zona: 'Puyehue',
  altura: 20,
  caudal: 'Estacional: fuerte en otoño-invierno, mínimo o nulo en verano',
  dificultad: 'Fácil',
  acceso: 'Ruta CH-215 km 91 (pavimentada)',
  coordenadas: '40°44\'S 72°11\'W',
  mejorEpoca: 'Octubre — Diciembre',
  entrada: 'Gratuita (posible cobro concesión)',
  horario: '9:00 — 18:30 hrs',
  descripcion: `El Salto La Princesa es una cascada estacional ubicada en el sector Anticura del Parque Nacional Puyehue, inmersa en uno de los rincones más prístinos de la selva valdiviana chilena. La cascada se forma por un tributario del río Gol-Gol que se precipita entre coihues centenarios y un manto denso de musgos, helechos y líquenes.

  A diferencia de muchas cascadas del sur de Chile, el Salto La Princesa tiene un comportamiento marcadamente estacional: en otoño e invierno el caudal es abundante gracias a las intensas precipitaciones de la zona (2.500-3.000 mm anuales), pero en verano puede reducirse drásticamente o secarse por completo. Este carácter efímero le otorga un atractivo particular para quienes la visitan en época de lluvias.

  El sendero de acceso de 850 metros atraviesa un bosque valdiviano extraordinariamente conservado, con ejemplares de coihue, ulmo, olivillo y tepa que forman un dosel casi impenetrable. La cascada forma parte del circuito de los Saltos de Anticura Catrué, que incluye también el <a href="/cascadas/salto-del-indio-anticura/" class="cascada-inline-link">Salto del Indio</a> y el Salto Repucura, tres joyas escondidas en el corazón del <a href="/region/los-lagos/" class="cascada-inline-link">Parque Nacional Puyehue</a>.`,
  comoLlegar: `Desde Osorno (91 km, 1:15-1:30 hrs en auto): Tomar la Ruta CH-215 (ruta internacional hacia Argentina) en dirección este. La ruta está completamente pavimentada. Al km 91 se encuentra la señalización del Centro Turístico Anticura, dentro del Parque Nacional Puyehue. Desde el estacionamiento, el sendero al Salto La Princesa tiene 850 metros.

  Desde Santiago (1.025 km, 11-12 horas en auto): Ruta 5 Sur hasta Osorno (aproximadamente 950 km). En Osorno tomar la Ruta CH-215 hacia el este por 91 km hasta el sector Anticura.

  Desde Entre Lagos (55 km, 45-60 min): Seguir la Ruta CH-215 hacia el este.

  Transporte público: Expreso Lago Puyehue (ELP) opera desde el Terminal Mercado de Osorno con aproximadamente 4 frecuencias diarias. El viaje dura 1 hora 50 minutos hasta Anticura.`,
  imagen: '/assets/cascadas/salto-la-princesa-anticura/hero.webp',
  imagenAlt: 'Salto La Princesa cayendo entre bosque valdiviano en el sector Anticura del Parque Nacional Puyehue, Los Lagos',
  galeria: [
    { src: '/assets/cascadas/salto-la-princesa-anticura/galeria-1.webp', alt: 'Vista cercana del Salto La Princesa con caudal entre rocas y musgos en Anticura' },
    { src: '/assets/cascadas/salto-la-princesa-anticura/galeria-2.webp', alt: 'Cascada en el sector Anticura del Parque Nacional Puyehue rodeada de selva valdiviana' },
    { src: '/assets/cascadas/salto-la-princesa-anticura/galeria-3.webp', alt: 'Río Gol-Gol fluyendo entre bosque nativo en el sector Anticura, Parque Nacional Puyehue' },
    { src: '/assets/cascadas/salto-la-princesa-anticura/galeria-4.webp', alt: 'Salto Repucura, cascada vecina al Salto La Princesa en el circuito de Anticura' },
  ],
  galeriaCreditos: [
    { autor: 'Claudio Elias', licencia: 'CC BY-SA 4.0', url: 'https://commons.wikimedia.org/wiki/File:Salto_de_la_Princesa_-_Anticura.jpg' },
    { autor: 'Natalia Reyes Escobar', licencia: 'CC BY-SA 4.0', url: 'https://commons.wikimedia.org/wiki/File:Salto_de_la_Princesa_Parque_Nacional_Puyehue_10.jpg' },
    { autor: 'Claudio Elias', licencia: 'CC BY-SA 4.0', url: 'https://commons.wikimedia.org/wiki/File:Salto_Anticura.jpg' },
    { autor: 'Claudio Elias', licencia: 'CC BY-SA 4.0', url: 'https://commons.wikimedia.org/wiki/File:Salto_Repucura_-_Anticura.jpg' },
  ],
  // 3 por cercanía geográfica (mismo parque / región)
  cascadasCercanas: [
    { nombre: 'Saltos del Petrohué', slug: 'saltos-del-petrohue', region: 'Los Lagos', altura: 20, tipo: 'cercania' },
    { nombre: 'Cascada Velo de la Novia', slug: 'cascada-velo-de-la-novia-peulla', region: 'Los Lagos', altura: 35, tipo: 'cercania' },
    { nombre: 'Las Cascadas de Puerto Octay', slug: 'las-cascadas-puerto-octay', region: 'Los Lagos', altura: 40, tipo: 'cercania' },
  ],
  // 3 por relación semántica (bosque valdiviano, parque nacional, sendero fácil)
  cascadasRelacionadas: [
    { nombre: 'Salto del Huilo-Huilo', slug: 'salto-del-huilo-huilo', region: 'Los Ríos', altura: 37, tipo: 'relacionada' },
    { nombre: 'Salto de Riñinahue', slug: 'salto-de-rininahue', region: 'Los Ríos', altura: 27, tipo: 'relacionada' },
    { nombre: 'Salto del Buey', slug: 'salto-del-buey', region: 'Los Ríos', altura: 90, tipo: 'relacionada' },
  ],

  lat: -40.6637,
  lng: -72.1701,
  rio: 'Tributario del Río Gol-Gol',
  tipoFormacion: 'Cascada estacional tipo velo en bosque valdiviano',
  numeroBrazos: 1,
  distanciaSantiago: 1025,

  historia: `El nombre Anticura proviene del mapudungun: anti (sol, luz) y kura (piedra), que significa "Piedra del Sol". Este territorio fue habitado históricamente por el pueblo mapuche-huilliche, la rama más austral del pueblo mapuche, quienes utilizaban los bosques y ríos de la zona como fuente de alimento y refugio. Los huilliche son la fuente de las leyendas y cosmovisión que dan nombre a los lugares del parque.

  El Salto del Indio, vecino del Salto La Princesa en el mismo circuito, lleva su nombre porque según la tradición local, durante la época colonial un grupo de indígenas huilliche se escondió en la zona de Anticura para escapar del asedio de los españoles, usando las cascadas y el bosque denso como refugio natural. La denominación "Salto de la Princesa" está precedida por una leyenda indígena que narra cómo una princesa huilliche fue sumergida en estas aguas cristalinas y encontrada por los españoles a su llegada.

  El Parque Nacional Puyehue fue creado en 1941 por decreto supremo del Ministerio de Tierras y Colonización, ampliado en 1950 y con sus límites actuales establecidos en 1981. Abarca 107.000 hectáreas y es parte de la Reserva de la Biosfera de los Bosques Templados de Los Andes, declarada por UNESCO. El 4 de junio de 2011, la erupción del complejo volcánico Puyehue-Cordón Caulle afectó severamente el parque con ceniza volcánica. El sector Anticura fue uno de los más impactados, pero el ecosistema se ha recuperado notablemente desde entonces.`,

  queHacer: [
    { actividad: 'Sendero Salto La Princesa (850 m)', descripcion: 'Sendero recreativo de baja dificultad que atraviesa selva valdiviana prístina hasta el mirador de la cascada. Ida y vuelta en 30 minutos. Apto para familias con niños mayores de 5 años.' },
    { actividad: 'Circuito Saltos de Anticura (4 km)', descripcion: 'Circuito completo que conecta el Salto La Princesa, el Salto del Indio y el Salto Repucura. 1 a 1,5 horas, desnivel de 63 m, dificultad fácil. La mejor forma de conocer las tres cascadas del sector.' },
    { actividad: 'Fotografía de bosque valdiviano', descripcion: 'El sendero atraviesa una de las expresiones más prístinas de selva valdiviana en Chile. Coihues centenarios, ulmos, olivillos y tepas forman un dosel denso ideal para fotografía de naturaleza.' },
    { actividad: 'Avistamiento de aves', descripcion: 'El parque alberga más de 130 especies de aves. En el sector Anticura destacan el carpintero negro, el huet-huet, el choroy, el pato cortacorrientes y el picaflor chico. Llevar binoculares.' },
    { actividad: 'Trekking Anticura-Antillanca (2 días)', descripcion: 'Para trekkers experimentados: la ruta roja de 2 días desde Anticura hasta Antillanca por Pampa Frutilla. Requiere registro en CONAF y equipo de travesía completo.' },
    { actividad: 'Cabalgatas', descripcion: 'El Centro Turístico Anticura ofrece cabalgatas como actividad complementaria para explorar los alrededores del sector.' },
  ],

  flora: `El sendero al Salto La Princesa atraviesa una de las expresiones más prístinas de la selva valdiviana de Chile. El dosel está dominado por coihue (Nothofagus dombeyi) y ulmo (Eucryphia cordifolia), árboles que pueden superar los 40 metros de altura y los 800 años de edad. En el sotobosque destacan el olivillo (Aextoxicon punctatum), el tineo (Weinmannia trichosperma), la tepa (Laureliopsis philippiana) y el mañío (Podocarpus nubigena).

  En cotas más altas aparece el coigüe de Magallanes (Nothofagus betuloides) y la lenga (Nothofagus pumilio). El suelo está tapizado de helechos de múltiples especies, musgos y líquenes que cubren troncos y rocas creando un paisaje casi prehistórico. Las quilas (Chusquea quila) y el coligüe (Chusquea coleu), bambúes nativos, forman densas matas en los claros del bosque. La extraordinaria humedad de la zona (2.500-3.000 mm anuales) mantiene este ecosistema en estado prístino.`,

  fauna: `El Parque Nacional Puyehue alberga más de 130 especies de aves y una rica fauna de mamíferos. El puma (Puma concolor) es el principal depredador, aunque raramente avistado. El pudú (Pudu puda), el ciervo más pequeño del mundo, habita los matorrales del sector. El monito del monte (Dromiciops gliroides), pequeño marsupial relicto considerado un fósil viviente, habita en el bosque valdiviano de Anticura.

  Entre las aves más fáciles de observar destacan el carpintero negro (Campephilus magellanicus) con su inconfundible golpeteo, el huet-huet (Pteroptochos tarnii) de canto profundo, el choroy (Enicognathus leptorhynchus) en bandadas ruidosas, y el pato cortacorrientes (Merganetta armata) en las aguas del río Gol-Gol. El cóndor andino (Vultur gryphus) sobrevuela las zonas altas del parque. En zonas elevadas se registra la presencia del huemul (Hippocamelus bisulcus), ciervo en peligro de extinción. También habitan el zorro culpeo, el coipo, el chingue y la güiña.`,

  clima: {
    tipo: 'Templado lluvioso / oceánico andino',
    tempPromedio: '11-14°C',
    tempVerano: '15-25°C',
    tempInvierno: '4-10°C',
    precipitaciones: '2.500-3.000 mm anuales',
    descripcion: 'El clima es oceánico y muy lluvioso, con precipitaciones abundantes incluso en verano. Es uno de los sectores más lluviosos de Chile. En invierno hay nieve frecuente en las partes altas del parque y las mínimas pueden llegar a -18°C en cotas elevadas. Los meses de enero y febrero son los más secos pero igualmente con posibilidad de lluvia. La mejor ventana para equilibrar caudal de la cascada y condiciones de senderismo es octubre a diciembre.',
  },

  seguridad: [
    'Registrarse en el puesto de guardaparques de CONAF en Anticura antes de iniciar cualquier sendero',
    'La cascada puede estar seca en verano (diciembre-febrero) — consultar condiciones antes de visitar',
    'El sendero puede tener barro abundante en época lluviosa — usar calzado impermeable con buen agarre',
    'No abandonar el sendero marcado — el bosque valdiviano es denso y puede desorientar',
    'En invierno, revisar condiciones de la Ruta CH-215 (puede haber nieve o hielo en el camino)',
    'No alimentar fauna silvestre — pumas y zorros pueden estar presentes en el sector',
  ],

  recomendaciones: [
    'Calzado impermeable con buen agarre (sendero con barro y raíces)',
    'Ropa en capas: base térmica + polar + cortaviento impermeable (llueve todo el año)',
    'Repelente de insectos, especialmente en verano',
    'Cámara fotográfica para aves y bosque valdiviano',
    'Binoculares para avistamiento del carpintero negro, huet-huet y choroy',
    'Agua y snacks (el restaurante del Centro Turístico está disponible antes y después)',
  ],

  gastronomia: [
    { plato: 'Trucha y salmón del Lago Puyehue', descripcion: 'Los ríos y lagos de la zona son abundantes en trucha y salmón. Plato emblemático de la región preparado ahumado, al vapor o a la plancha en los restaurantes de la zona.' },
    { plato: 'Kuchen de frambuesa y berries del bosque', descripcion: 'Herencia de la colonización alemana del siglo XIX. Los kuchens son un ícono gastronómico de Los Lagos, elaborados con frambuesas, murtas y berries silvestres de la región.' },
    { plato: 'Cazuela de vacuno o cordero', descripcion: 'Plato típico chileno de campo con trozos de carne, papas, zapallo y verduras. Presente en hosterías y restaurantes de Entre Lagos y Puyehue.' },
    { plato: 'Pan amasado casero', descripcion: 'El Centro Turístico Anticura ofrece pan amasado artesanal elaborado en el propio centro. Tradición del campo chileno sureño.' },
    { plato: 'Carnes de caza (jabalí, ciervo)', descripcion: 'En la zona de Osorno y Entre Lagos es posible encontrar preparaciones con carnes de caza como jabalí y ciervo en hosterías especializadas.' },
    { plato: 'Mistelas y mermeladas artesanales', descripcion: 'Licores suaves y conservas elaborados con frutos del bosque: murta, calafate y frambuesa silvestre. Se venden en tiendas locales de Entre Lagos y Puyehue.' },
  ],

  alojamiento: [
    { nombre: 'Centro Turístico Anticura (Cabañas)', tipo: 'Cabañas de montaña', precioDesde: 'Desde USD 109/noche', url: 'https://www.anticura.com/', descripcion: 'Cabañas alpinas con living, cocina, chimenea y panel convector insertas en la selva valdiviana. Capacidad hasta 6 personas. Restaurante con 3 comidas diarias. Score Booking 8.2 (462 reseñas).' },
    { nombre: 'Centro Turístico Anticura (Camping)', tipo: 'Camping', precioDesde: 'Desde $18.000 CLP/noche', url: 'https://www.anticura.com/', descripcion: '15 sitios de camping con mesas de picnic, electricidad y baños con agua caliente. A 300 metros de los senderos. WiFi disponible.' },
    { nombre: 'Termas de Aguas Calientes', tipo: 'Hotel / Lodge termal', precioDesde: 'Desde USD 66/noche', url: 'https://termasaguascalientes.cl/', descripcion: 'Complejo turístico a 17 km de Anticura frente al río Chanleufú. Piscinas termales, restaurante y bungalows equipados. Sector Aguas Calientes del P.N. Puyehue.' },
    { nombre: 'Hotel Termas de Puyehue', tipo: 'Resort 5 estrellas', precioDesde: 'Consultar precio', url: 'https://puyehue.cl/', descripcion: 'Resort de bosque con aguas termales, spa, piscinas indoor/outdoor y restaurantes. A 31 km de Anticura. Referente de la zona de Puyehue.' },
    { nombre: 'Hostería Entre Lagos', tipo: 'Hostería', precioDesde: 'Desde USD 80/noche', url: '#', descripcion: 'Habitaciones privadas con baño, balcón y vistas al lago o montaña. Incluye desayuno continental. A 55 km de Anticura, en la localidad de Entre Lagos.' },
  ],

  faq: [
    { pregunta: '¿Cuándo es mejor visitar el Salto La Princesa en Anticura?', respuesta: 'Para ver la cascada con caudal, lo ideal es visitarla en otoño (marzo a mayo) o invierno (junio a agosto), cuando el caudal es mayor gracias a las lluvias. En verano (diciembre-febrero) la cascada puede estar completamente seca. Si buscas equilibrio entre caudal y buen clima para caminar, octubre a diciembre es la mejor ventana.' },
    { pregunta: '¿Tiene costo la entrada al sector Anticura?', respuesta: 'El acceso al sector Anticura del Parque Nacional Puyehue es gratuito o con costo mínimo. El parque tiene una concesión operada por el Centro Turístico Anticura que puede cobrar por el acceso a algunos senderos. Se recomienda consultar directamente con CONAF (parque.puyehue@conaf.cl) o llamar al +56 64 2 221304.' },
    { pregunta: '¿Cuánto dura la caminata al Salto La Princesa?', respuesta: 'El sendero tiene 850 metros (ida y vuelta) y se recorre en aproximadamente 30 minutos. Si quieres hacer el circuito completo Anticura Catrué (Salto La Princesa + Salto del Indio + Salto Repucura), son 4 km en total y toma entre 1 y 1,5 horas.' },
    { pregunta: '¿Se puede acampar en Anticura?', respuesta: 'Sí. El Centro Turístico Anticura cuenta con 15 sitios de camping con mesas de picnic, electricidad y baños con agua caliente (desde $18.000 CLP/noche). También ofrecen cabañas alpinas y dormitorios compartidos. Reservas en www.anticura.com o por Booking.com.' },
    { pregunta: '¿Qué fauna puedo ver en los senderos de Anticura?', respuesta: 'El Parque Nacional Puyehue alberga más de 130 especies de aves. Las más fáciles de avistar son el carpintero negro, el huet-huet, el choroy y el pato cortacorrientes. El pudú (el ciervo más pequeño del mundo) habita el sector pero es muy esquivo. También habita el monito del monte, un pequeño marsupial endémico del bosque valdiviano.' },
    { pregunta: '¿Cómo llego a Anticura en transporte público?', respuesta: 'Desde Osorno, la empresa Expreso Lago Puyehue opera buses desde el Terminal Mercado con aproximadamente 4 frecuencias diarias. El viaje dura 1 hora 50 minutos. Verificar horarios actualizados en el terminal, ya que varían por temporada.' },
  ],
};

// ─── STRUCTURED DATA ────────────────────────────────────────────────────────
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'TouristAttraction',
    name: 'Salto La Princesa (Anticura)',
    description: `Cascada estacional en el sector Anticura del Parque Nacional Puyehue, Región de Los Lagos, Chile. Sendero de 850 m en selva valdiviana prístina.`,
    image: `https://cascadaschile.com${cascada.imagen}`,
    geo: {
      '@type': 'GeoCoordinates',
      latitude: cascada.lat,
      longitude: cascada.lng,
    },
    address: {
      '@type': 'PostalAddress',
      addressRegion: cascada.region,
      addressLocality: cascada.zona,
      addressCountry: 'CL',
    },
    isAccessibleForFree: true,
    openingHours: 'Mo-Su 09:00-18:30',
    touristType: ['Naturaleza', 'Trekking', 'Fotografía', 'Familiar'],
    url: `https://cascadaschile.com/cascadas/${cascada.slug}`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: cascada.faq.map(f => ({
      '@type': 'Question',
      name: f.pregunta,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.respuesta,
      },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://cascadaschile.com/' },
      { '@type': 'ListItem', position: 2, name: 'Cascadas', item: 'https://cascadaschile.com/cascadas' },
      { '@type': 'ListItem', position: 3, name: cascada.region, item: `https://cascadaschile.com/region/los-lagos` },
      { '@type': 'ListItem', position: 4, name: 'Salto La Princesa (Anticura)' },
    ],
  },
];

const pageTitle = `${cascada.nombre} — Guía completa, cómo llegar y qué hacer | Cascadas de Chile`;
const pageDescription = `Salto La Princesa en Anticura: cascada estacional en el Parque Nacional Puyehue, Los Lagos. Sendero de 850 m en selva valdiviana, cómo llegar, fauna y alojamiento.`;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  ogImage={`https://cascadaschile.com${cascada.imagen}`}
  structuredData={structuredData}
>

  <!-- ─── 1. HERO ──────────────────────────────────────────────────────────── -->
  <section class="cascada-hero">
    <img src={cascada.imagen} alt={cascada.imagenAlt} class="cascada-hero__bg" width="1600" height="1067" decoding="async" fetchpriority="high" />
    <div class="cascada-hero__overlay"></div>
    <div class="cascada-hero__content">
      <nav class="cascada-breadcrumb">
        <a href="/">Inicio</a>
        <span>›</span>
        <a href="/cascadas/">Cascadas</a>
        <span>›</span>
        <a href="/region/los-lagos/">Los Lagos</a>
        <span>›</span>
        <span class="cascada-breadcrumb__current">Salto La Princesa</span>
      </nav>

      <div class="cascada-hero__bottom">
        <div>
          <span class="cascada-badge">{cascada.region}</span>
          <h1 class="cascada-hero__title">Salto La<br/>Princesa</h1>
        </div>
        <div class="cascada-hero__stat">
          <p class="cascada-hero__stat-number">850m</p>
          <p class="cascada-hero__stat-label">Sendero ida y vuelta</p>
        </div>
      </div>
    </div>
  </section>


  <!-- ─── 2. FICHA RÁPIDA ─────────────────────────────────────────────────── -->
  <section class="cascada-section cascada-section--cream" style="padding-top:3rem; padding-bottom:3rem;">
    <div class="cascada-ficha">
      {[
        { label: 'Dificultad', value: cascada.dificultad },
        { label: 'Acceso', value: cascada.acceso },
        { label: 'Entrada', value: cascada.entrada },
        { label: 'Mejor época', value: cascada.mejorEpoca },
        { label: 'Río', value: cascada.rio },
        { label: 'Sendero', value: '850 m, 30 min' },
        { label: 'Dist. Santiago', value: `${cascada.distanciaSantiago} km` },
        { label: 'Coordenadas', value: cascada.coordenadas },
      ].map((stat) => (
        <div class="cascada-ficha__item">
          <p class="cascada-ficha__label">{stat.label}</p>
          <p class="cascada-ficha__value">{stat.value}</p>
        </div>
      ))}
    </div>
  </section>


  <!-- ─── 3. DESCRIPCIÓN ──────────────────────────────────────────────────── -->
  <section class="cascada-section cascada-section--cream">
    <div class="cascada-two-col">
      <div class="reveal">
        <h2 class="cascada-h2">Sobre el Salto La Princesa</h2>
        <p class="cascada-body">El Salto La Princesa es una cascada estacional ubicada en el sector Anticura del Parque Nacional Puyehue, inmersa en uno de los rincones más prístinos de la selva valdiviana chilena. La cascada se forma por un tributario del río Gol-Gol que se precipita entre coihues centenarios y un manto denso de musgos, helechos y líquenes.</p>
        <p class="cascada-body">A diferencia de muchas <a href="/" class="cascada-inline-link">cascadas del sur de Chile</a>, el Salto La Princesa tiene un comportamiento marcadamente estacional: en otoño e invierno el caudal es abundante gracias a las intensas precipitaciones de la zona (2.500-3.000 mm anuales), pero en verano puede reducirse drásticamente o secarse por completo. Este carácter efímero le otorga un atractivo particular para quienes la visitan en época de lluvias.</p>
        <p class="cascada-body">El sendero de acceso de 850 metros atraviesa un bosque valdiviano extraordinariamente conservado, con ejemplares de coihue, ulmo, olivillo y tepa que forman un dosel casi impenetrable. La cascada forma parte del circuito de los Saltos de Anticura Catrué, que incluye también el <a href="/cascadas/salto-del-indio-anticura/" class="cascada-inline-link">Salto del Indio</a> y el Salto Repucura, tres joyas escondidas en el corazón del <a href="/region/los-lagos/" class="cascada-inline-link">Parque Nacional Puyehue</a>. Los <a href="/cascadas/saltos-del-petrohue/" class="cascada-inline-link">Saltos del Petrohué</a>, a 130 km, comparten el contexto volcánico y boscoso de la <a href="/region/los-lagos/" class="cascada-inline-link">Región de Los Lagos</a>.</p>
      </div>

