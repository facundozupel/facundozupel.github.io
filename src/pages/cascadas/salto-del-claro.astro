---
import Layout from '../../layouts/Layout.astro';

// ─── DATOS DE LA CASCADA ──────────────────────────────────────────────────────
// Datos verificados por chile-waterfalls-researcher: alltrails.com, wikiloc.com, google maps, tripadvisor, mar 2026
const cascada = {
  // --- Identificación ---
  nombre: 'Salto del Claro',
  slug: 'salto-del-claro',
  region: 'La Araucanía',
  zona: 'Pucón',
  altura: 90,
  caudal: 'Régimen pluvio-nival. Mayor caudal en primavera (octubre-noviembre) por deshielo del volcán Villarrica; caudal estable en verano gracias a alimentación subterránea',
  dificultad: 'Moderado',
  acceso: 'Ruta Internacional CH-199 (Pucón–Huife), desvío a camino Los Calabozos o acceso privado Parque Salto del Claro',
  coordenadas: '39°17\'S 71°56\'W',
  mejorEpoca: 'Octubre — Abril',
  entrada: 'CLP 3.000 adulto / CLP 2.000 niño (acceso privado Parque Salto del Claro). Acceso gratuito por Los Calabozos',
  horario: '9:00 a 18:00 (Parque Salto del Claro). Acceso Los Calabozos: sin horario',
  descripcion: `El Salto del Claro es una de las cascadas más impresionantes de la zona de Pucón, con una caída de aproximadamente 90 metros sobre un anfiteatro de basalto volcánico tallado por las aguas del Río Claro. Ubicada a solo 27 km de Pucón por la ruta que conduce a las Termas de Huife, esta cascada es un destino imperdible para quienes visitan la <a href="/region/araucania" class="cascada-inline-link">Región de La Araucanía</a>. El Río Claro, alimentado por las aguas de deshielo del volcán Villarrica y por vertientes subterráneas, ha erosionado durante miles de años las capas de roca basáltica creando un cañón profundo que culmina en esta caída vertical espectacular.

  La cascada tiene dos accesos. El primero es el Parque Salto del Claro, un predio privado con infraestructura turística que incluye sendero habilitado, miradores, estacionamiento y servicios. El segundo es por el camino de Los Calabozos, una ruta gratuita que llega a la parte superior de la cascada a través de un sendero más rústico. Ambas opciones ofrecen perspectivas diferentes: el parque permite ver la cascada de frente desde abajo, mientras que Los Calabozos da acceso a la vista superior y a pozones naturales aguas arriba.

  La zona de Pucón es el epicentro del turismo de aventura en Chile, y el Salto del Claro forma parte de un circuito natural que incluye el <a href="/cascadas/salto-truful-truful" class="cascada-inline-link">Salto Truful-Truful</a> en el Parque Nacional Conguillío y los Ojos del Caburgua. Para quienes buscan explorar más <a href="/cascadas" class="cascada-inline-link">cascadas de Chile</a> en La Araucanía, el <a href="/cascadas/salto-de-la-princesa" class="cascada-inline-link">Salto de la Princesa</a> en Curacautín es otra opción extraordinaria.`,
  comoLlegar: `Desde Pucón (27 km, 35 min en auto): Tomar la Ruta Internacional CH-199 hacia el este, en dirección a las Termas de Huife. A la altura del km 27, buscar el desvío señalizado al Parque Salto del Claro a mano derecha. El camino es de ripio los últimos 2 km hasta el estacionamiento del parque.

  Acceso por Los Calabozos (gratuito): Desde la misma CH-199, tomar el desvío al camino Los Calabozos (antes del desvío al parque). El camino de ripio conduce a un área donde se puede estacionar. Desde ahí, sendero de 1,5 km hasta la parte superior de la cascada. Ruta sin señalización formal.

  Desde Santiago (780 km, ~9 horas en auto): Ruta 5 Sur hasta Freire, luego Ruta 199 hacia Villarrica y Pucón. Desde Pucón seguir indicaciones anteriores.

  En transporte público: Buses desde Temuco a Pucón (Buses JAC, 2 horas). Desde Pucón, no hay transporte público directo al salto. Se recomienda taxi, transfer o tour organizado.`,
  imagen: '/assets/cascadas/salto-del-claro/hero.webp',
  imagenAlt: 'Salto del Claro, cascada de 90 metros sobre basalto volcánico en Pucón, La Araucanía',
  galeria: [
    { src: '/assets/cascadas/salto-del-claro/galeria-1.webp', alt: 'Vista cercana de cascada en la zona de Pucón, La Araucanía' },
    { src: '/assets/cascadas/salto-del-claro/galeria-2.webp', alt: 'Cascada entre bosque nativo y roca volcánica en la precordillera de Pucón' },
    { src: '/assets/cascadas/salto-del-claro/galeria-3.webp', alt: 'Ojos del Caburgua, cascadas cercanas al Salto del Claro en Pucón' },
    { src: '/assets/cascadas/salto-del-claro/galeria-4.webp', alt: 'Cascada y desembocadura en los Ojos del Caburgua, Pucón' },
  ],
  galeriaCreditos: [
    { autor: 'Dsjr89', licencia: 'CC BY-SA 4.0', url: 'https://commons.wikimedia.org/wiki/File:Puc%C3%B3n_2019_(06)_salto_La_China.jpg' },
    { autor: 'Dsjr89', licencia: 'CC BY-SA 4.0', url: 'https://commons.wikimedia.org/wiki/File:Puc%C3%B3n_2019_(10)_salto_La_China.jpg' },
    { autor: 'Joselu3', licencia: 'CC BY-SA 4.0', url: 'https://commons.wikimedia.org/wiki/File:Ojos_del_Caburgua_(3_cascadas).jpg' },
    { autor: 'Joselu3', licencia: 'CC BY-SA 4.0', url: 'https://commons.wikimedia.org/wiki/File:Ojos_del_Caburgua_(cascada_y_desembocadura).jpg' },
  ],
  // 3 por cercanía geográfica (La Araucanía / Pucón)
  cascadasCercanas: [
    { nombre: 'Salto Truful-Truful', slug: 'salto-truful-truful', region: 'La Araucanía', altura: 20, tipo: 'cercania' },
    { nombre: 'Salto de la Princesa', slug: 'salto-de-la-princesa', region: 'La Araucanía', altura: 25, tipo: 'cercania' },
    { nombre: 'Salto Chancagua', slug: 'salto-chancagua', region: 'La Araucanía', altura: 70, tipo: 'cercania' },
  ],
  // 3 por relación semántica (aventura, rappel, cañones volcánicos)
  cascadasRelacionadas: [
    { nombre: 'Salto del Huilo-Huilo', slug: 'salto-del-huilo-huilo', region: 'Los Ríos', altura: 37, tipo: 'relacionada' },
    { nombre: 'Salto Quino', slug: 'salto-quino', region: 'La Araucanía', altura: 30, tipo: 'relacionada' },
    { nombre: 'Cascada Invertida', slug: 'cascada-invertida', region: 'Maule', altura: 50, tipo: 'relacionada' },
  ],

  // --- Datos verificados ---
  lat: -39.2961,
  lng: -71.9490,
  rio: 'Río Claro',
  tipoFormacion: 'Caída vertical sobre anfiteatro de basalto volcánico',
  numeroBrazos: 1,
  distanciaSantiago: 780,

  historia: `El Salto del Claro se encuentra en territorio ancestral mapuche-pehuenche, pueblos que habitaron los valles y bosques de la precordillera araucana durante milenios. El Río Claro (Lif-Leufu en mapudungún, "río limpio") era una fuente esencial de agua y alimento para las comunidades que se asentaban en las inmediaciones del volcán Villarrica (Ruka Pillán, "la casa del espíritu"). Para los mapuche, las cascadas y los ríos están protegidos por el ngen-ko, espíritu guardián de las aguas, y cualquier intervención en estos espacios requiere respeto y permiso espiritual.

  La colonización de la zona de Pucón comenzó a fines del siglo XIX, cuando el ejército chileno estableció el Fuerte de Pucón en 1883 durante la ocupación de la Araucanía. Los colonos europeos que llegaron posteriormente transformaron la zona en un destino agrícola y ganadero. El turismo comenzó a desarrollarse en la década de 1930 con la construcción del Gran Hotel Pucón, y durante el siglo XX la zona se consolidó como el principal polo de turismo aventura de Chile.

  El Salto del Claro permaneció relativamente desconocido fuera de la comunidad local hasta las décadas de 2000 y 2010, cuando el auge del canyoning y el rappel deportivo lo puso en el mapa de los aventureros. Operadores como Aguaventura y Pucón Kayak comenzaron a ofrecer descensos de rappel por la cascada, una experiencia que se convirtió en una de las actividades más emblemáticas de Pucón. La creación del Parque Salto del Claro como predio turístico privado formalizó el acceso y facilitó la visita para familias y turistas menos experimentados. La <a href="/region/araucania" class="cascada-inline-link">Región de La Araucanía</a> concentra hoy una de las mayores densidades de cascadas y atractivos de aventura de todo Chile.`,

  queHacer: [
    { actividad: 'Rappel y canyoning en la cascada', descripcion: 'Descenso de 90 metros en rappel por la pared de la cascada, una de las experiencias de aventura más emblemáticas de Pucón. Operadores certificados como Aguaventura ofrecen la actividad con equipo completo y guías. Precio: CLP 45.000-50.000 por persona. No requiere experiencia previa.' },
    { actividad: 'Trekking al mirador inferior', descripcion: 'Sendero habilitado de 800 metros desde el estacionamiento del Parque Salto del Claro hasta el mirador frontal de la cascada. Dificultad fácil, apto para familias. El sendero desciende por escaleras de madera hasta la base del anfiteatro donde se aprecia la caída completa.' },
    { actividad: 'Vía Ferrata', descripcion: 'El Parque Salto del Claro ofrece un circuito de Vía Ferrata sobre las paredes del cañón, con grapas metálicas y cable de seguridad. Permite recorrer las paredes de basalto con vista a la cascada. Apto para mayores de 12 años.' },
    { actividad: 'Baño en pozones naturales', descripcion: 'Aguas arriba de la cascada, accediendo por el camino de Los Calabozos, hay pozones naturales de agua cristalina formados en el lecho de roca del Río Claro. En verano (enero-febrero) la temperatura del agua permite un baño refrescante. Solo accesibles por el acceso gratuito.' },
    { actividad: 'Fotografía de naturaleza', descripcion: 'El anfiteatro de basalto con la cascada de 90 metros ofrece composiciones fotográficas espectaculares. Mejor luz en la mañana (9:00-12:00) cuando el sol ilumina la pared de roca. En días soleados se forman arcoíris en el espray de la base.' },
    { actividad: 'Circuito de cascadas de Pucón', descripcion: 'Combinar la visita al Salto del Claro con los Ojos del Caburgua (cascadas sobre roca volcánica, 18 km de Pucón) y el Salto Truful-Truful en el Parque Nacional Conguillío. Un circuito de un día completo que muestra la diversidad de cascadas de La Araucanía.' },
  ],

  flora: `La vegetación en torno al Salto del Claro es representativa del bosque templado lluvioso de la precordillera araucana, con influencia directa de la actividad volcánica del Villarrica. El dosel arbóreo está dominado por el coigüe (Nothofagus dombeyi) y el raulí (Nothofagus alpina), árboles que alcanzan los 30-40 metros de altura y forman un dosel cerrado que filtra la luz en tonos verdes sobre el sendero. La lenga (Nothofagus pumilio) aparece en las zonas más altas y expuestas del cañón.

  El sotobosque es denso y exuberante. Los helechos —especialmente la palmilla (Lophosoria quadripinnata) y el helecho costilla de vaca (Blechnum chilense)— forman masas verdes en las zonas húmedas junto a la cascada. El copihue (Lapageria rosea), flor nacional de Chile, trepa por los troncos de los árboles y florece en rojo intenso entre diciembre y marzo. La murta (Ugni molinae) y el arrayán (Luma apiculata) se encuentran en las quebradas más protegidas. En las paredes del cañón, musgos, líquenes y plantas rupícolas forman tapices verdes que contrastan con la roca oscura del basalto. El <a href="/cascadas/salto-truful-truful" class="cascada-inline-link">Salto Truful-Truful</a> en el Parque Nacional Conguillío comparte esta misma composición florística de bosque araucano.`,

  fauna: `La fauna del entorno del Salto del Claro es característica del bosque templado de la precordillera araucana. El martín pescador (Megaceryle torquata), con su plumaje azul metálico, es habitante permanente del Río Claro y puede observarse pescando desde las ramas que sobresalen del cauce. El pato cortacorrientes (Merganetta armata) se desplaza por los tramos de mayor velocidad del río, y la huala (Podiceps major) frecuenta las pozas más tranquilas.

  En el bosque circundante, el chucao (Scelorchilus rubecula) delata su presencia con su canto penetrante desde el sotobosque. El carpintero negro (Campephilus magellanicus) habita los coigües maduros del cañón, y el pitío (Colaptes pitius) se observa en los claros del bosque. El zorro chilla (Lycalopex griseus) y el pudú (Pudu puda) son mamíferos frecuentes en la zona, aunque el pudú es difícil de avistar por sus hábitos crepusculares. El cóndor andino (Vultur gryphus) sobrevuela ocasionalmente el cañón, especialmente en las mañanas de verano cuando las corrientes térmicas facilitan su vuelo.`,

  clima: {
    tipo: 'Templado lluvioso con influencia andina (Cfb)',
    tempPromedio: '10°C',
    tempVerano: '18-28°C',
    tempInvierno: '2-10°C',
    precipitaciones: '2.000-2.500 mm anuales',
    descripcion: 'Clima templado oceánico con precipitaciones distribuidas durante todo el año, concentradas entre mayo y septiembre. Los veranos son agradables y relativamente secos, con temperaturas que pueden superar los 25°C. En invierno, las temperaturas bajan a 0°C en las noches y son posibles nevadas sobre los 800 m.s.n.m. La mejor época para visitar es de octubre a abril: los senderos están secos, la temperatura es agradable y el caudal de la cascada es espectacular por el deshielo del Villarrica. Evitar la visita después de lluvias intensas, cuando el río crece y el acceso por Los Calabozos puede ser riesgoso.',
  },

  seguridad: [
    'El rappel en la cascada debe realizarse únicamente con operadores certificados y equipo profesional — nunca intentar descender solo',
    'El acceso por Los Calabozos carece de señalización: ir acompañado y con GPS o mapa descargado',
    'No acercarse al borde superior de la cascada: las rocas son resbaladizas y la caída es de 90 metros',
    'Llevar efectivo para la entrada al Parque Salto del Claro — no siempre hay terminal de pago',
    'En los pozones naturales, verificar la profundidad antes de saltar y nunca nadar solo',
    'El camino de ripio puede estar en mal estado tras lluvias: verificar condiciones del camino antes de salir',
    'Llevar protección solar y agua: el sendero dentro del parque tiene tramos expuestos al sol',
  ],

  recomendaciones: [
    'Calzado de trekking resistente al agua con suela adherente',
    'Ropa de baño si se planea visitar los pozones (acceso Los Calabozos)',
    'Protector solar y sombrero para los tramos expuestos',
    'Mínimo 1,5 litros de agua por persona',
    'Cámara fotográfica con funda impermeable (espray en la base de la cascada)',
    'Efectivo en pesos chilenos para la entrada',
    'Toalla y ropa de cambio si se hace rappel o se visitan los pozones',
    'Repelente de insectos en verano (tábanos activos cerca del agua)',
  ],

  gastronomia: [
    { plato: 'Trucha del Río Claro', descripcion: 'La trucha arcoíris y la trucha fario del Río Claro son la especialidad de Pucón. Se preparan a la parrilla, al disco o en ceviche. Los restaurantes de la costanera de Pucón la ofrecen fresca del día.' },
    { plato: 'Curanto en hoyo', descripcion: 'Preparación ancestral mapuche con mariscos, carnes, longanizas, papas, milcaos y chapaleles cocinados bajo tierra con piedras calientes. Los restaurantes rurales de la zona lo ofrecen como experiencia gastronómica grupal.' },
    { plato: 'Piñones de araucaria', descripcion: 'Los piñones (ngüilliu en mapudungún) del pehuén (Araucaria araucana) se cosechan entre marzo y mayo. Se preparan cocidos, en harina para pan, o como acompañamiento de guisos. Producto ancestral del pueblo pehuenche, disponible en ferias y restaurantes de Pucón.' },
    { plato: 'Cerveza artesanal de Pucón', descripcion: 'Pucón tiene una escena cervecera artesanal en crecimiento. Cervecerías como Maltierra, Petermann y Kaf Café producen variedades que van desde pale ales hasta stouts con ingredientes locales como piñón y murtilla.' },
    { plato: 'Asado de cordero al palo', descripcion: 'Cordero de la zona asado lentamente al palo junto a brasas de leña de roble pellín, sazonado con merkén (ají ahumado mapuche). Plato emblemático de las fiestas costumbristas y restaurantes rurales de La Araucanía.' },
  ],

  alojamiento: [
    { nombre: 'Hotel Antumalal', tipo: 'Hotel boutique', precioDesde: 'Desde $150.000 CLP/noche', url: 'https://www.antumalal.com', descripcion: 'Hotel de diseño Bauhaus construido en 1950 sobre un acantilado del Lago Villarrica. Vista al volcán, spa, restaurante gourmet y jardines nativos. A 25 km del Salto del Claro.' },
    { nombre: 'Cabañas en Pucón', tipo: 'Cabañas equipadas', precioDesde: 'Desde $60.000 CLP/noche', url: '#', descripcion: 'Amplia oferta de cabañas equipadas en Pucón y alrededores, con cocina, estacionamiento y entorno natural. Opciones desde económicas a premium. Reservar por Booking o Airbnb.' },
    { nombre: 'Camping Parque Cerduo', tipo: 'Camping', precioDesde: 'Desde $10.000 CLP/persona', url: '#', descripcion: 'Camping equipado en la ruta hacia Huife, a 15 km del Salto del Claro. Sitios con sombra, baños, duchas calientes y acceso al Río Liucura para pesca y kayak.' },
  ],

  faq: [
    { pregunta: '¿Cuánto mide el Salto del Claro?', respuesta: 'El Salto del Claro tiene una caída de aproximadamente 90 metros sobre un anfiteatro de basalto volcánico. Es una de las cascadas más altas de la zona de Pucón y de toda la Región de La Araucanía.' },
    { pregunta: '¿Cuánto cuesta la entrada al Salto del Claro?', respuesta: 'El acceso por el Parque Salto del Claro cuesta CLP 3.000 para adultos y CLP 2.000 para niños. Solo se acepta efectivo. Existe un acceso alternativo gratuito por el camino de Los Calabozos que llega a la parte superior de la cascada.' },
    { pregunta: '¿Se puede hacer rappel en el Salto del Claro?', respuesta: 'Sí, el rappel es una de las actividades más populares. Operadores certificados como Aguaventura ofrecen descensos de 90 metros con equipo profesional y guías. Precio: CLP 45.000-50.000. No se necesita experiencia previa.' },
    { pregunta: '¿Cómo llegar al Salto del Claro desde Pucón?', respuesta: 'Desde Pucón son 27 km (35 minutos en auto) por la Ruta CH-199 hacia las Termas de Huife. El desvío al Parque Salto del Claro está señalizado a la derecha. Los últimos 2 km son camino de ripio.' },
    { pregunta: '¿Se puede visitar el Salto del Claro con niños?', respuesta: 'Sí, el sendero del Parque Salto del Claro es apto para familias con niños. Son 800 metros por un camino habilitado con escaleras hasta el mirador frontal. El acceso por Los Calabozos es más rústico y no se recomienda para niños pequeños.' },
    { pregunta: '¿Cuál es la mejor época para visitar el Salto del Claro?', respuesta: 'De octubre a abril. En verano (enero-febrero) las temperaturas son agradables, los pozones permiten baño y las condiciones son ideales para rappel y trekking. En primavera (octubre-noviembre) el caudal es máximo por el deshielo del volcán Villarrica.' },
    { pregunta: '¿Hay pozones para bañarse cerca del Salto del Claro?', respuesta: 'Sí, aguas arriba de la cascada hay pozones naturales de agua cristalina accesibles por el camino de Los Calabozos (acceso gratuito). En verano el agua está a temperatura tolerable para un baño refrescante.' },
  ],
};

// ─── STRUCTURED DATA ────────────────────────────────────────────────────────
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'TouristAttraction',
    name: cascada.nombre,
    description: `Cascada de ${cascada.altura} metros sobre basalto volcánico en Pucón, Región de La Araucanía, Chile. Rappel, trekking, pozones naturales y vía ferrata a 27 km de Pucón.`,
    image: `https://cascadaschile.com${cascada.imagen}`,
    geo: {
      '@type': 'GeoCoordinates',
      latitude: cascada.lat,
      longitude: cascada.lng,
    },
    address: {
      '@type': 'PostalAddress',
      addressRegion: cascada.region,
      addressLocality: cascada.zona,
      addressCountry: 'CL',
    },
    isAccessibleForFree: false,
    touristType: ['Aventura', 'Naturaleza', 'Trekking', 'Rappel'],
    url: `https://cascadaschile.com/cascadas/${cascada.slug}`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: cascada.faq.map(f => ({
      '@type': 'Question',
      name: f.pregunta,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.respuesta,
      },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://cascadaschile.com/' },
      { '@type': 'ListItem', position: 2, name: 'Cascadas', item: 'https://cascadaschile.com/cascadas' },
      { '@type': 'ListItem', position: 3, name: cascada.region, item: `https://cascadaschile.com/region/${cascada.region.toLowerCase().replace(/\s/g,'-')}` },
      { '@type': 'ListItem', position: 4, name: cascada.nombre },
    ],
  },
];

const pageTitle = `${cascada.nombre} — Guía completa, cómo llegar y qué hacer | Cascadas de Chile`;
const pageDescription = `${cascada.nombre}: cascada de ${cascada.altura} m en Pucón, La Araucanía. Rappel de 90 metros, trekking, pozones naturales. Entrada, cómo llegar y toda la información.`;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  ogImage={`https://cascadaschile.com${cascada.imagen}`}
  structuredData={structuredData}
>

  <!-- ─── 1. HERO ──────────────────────────────────────────────────────────── -->
  <section class="cascada-hero">
    <img src={cascada.imagen} alt={cascada.imagenAlt} class="cascada-hero__bg" width="1600" height="1067" decoding="async" fetchpriority="high" />
    <div class="cascada-hero__overlay"></div>
    <div class="cascada-hero__content">
      <nav class="cascada-breadcrumb">
        <a href="/">Inicio</a>
        <span>›</span>
        <a href="/cascadas">Cascadas</a>
        <span>›</span>
        <a href={`/region/${cascada.region.toLowerCase().replace(/\s/g,'-')}`}>{cascada.region}</a>
        <span>›</span>
        <span class="cascada-breadcrumb__current">{cascada.nombre}</span>
      </nav>

      <div class="cascada-hero__bottom">
        <div>
          <span class="cascada-badge">{cascada.region}</span>
          <h1 class="cascada-hero__title">{cascada.nombre}</h1>
        </div>
        <div class="cascada-hero__stat">
          <p class="cascada-hero__stat-number">{cascada.altura}m</p>
          <p class="cascada-hero__stat-label">Altura de caída</p>
        </div>
      </div>
    </div>
  </section>


  <!-- ─── 2. FICHA RÁPIDA ─────────────────────────────────────────────────── -->
  <section class="cascada-section cascada-section--cream" style="padding-top:3rem; padding-bottom:3rem;">
    <div class="cascada-ficha">
      {[
        { label: 'Dificultad', value: cascada.dificultad },
        { label: 'Acceso', value: cascada.acceso },
        { label: 'Entrada', value: cascada.entrada },
        { label: 'Mejor época', value: cascada.mejorEpoca },
        { label: 'Río', value: cascada.rio },
        { label: 'Brazos', value: `${cascada.numeroBrazos} brazo` },
        { label: 'Dist. Santiago', value: `${cascada.distanciaSantiago} km` },
        { label: 'Coordenadas', value: cascada.coordenadas },
      ].map((stat) => (
