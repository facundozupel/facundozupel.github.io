---
import Layout from '../../layouts/Layout.astro';

// ─── DATOS DE LA CASCADA ──────────────────────────────────────────────────────
// Datos verificados por chile-waterfalls-researcher: parquenacionalhuerquehue.cl, CONAF, OpenStreetMap, AllTrails, Wikiexplora, mar 2026
const cascada = {
  // --- Identificación ---
  nombre: 'Cascada Trufulco',
  slug: 'cascada-trufulco',
  region: 'La Araucanía',
  zona: 'Pucón',
  altura: 80,
  caudal: 'Estacional. Mayor caudal en invierno-primavera por deshielo cordillerano. En verano el caudal disminuye pero la cascada no se seca',
  dificultad: 'Moderado',
  acceso: 'Sendero Los Lagos, PN Huerquehue. 2,26 km desde estacionamiento',
  coordenadas: '39°08\'S 71°42\'W',
  mejorEpoca: 'Noviembre — Abril',
  entrada: '$4.700 CLP (adulto chileno, CONAF vía pasesparques.cl)',
  horario: 'Mar-Dom 8:30 a 18:30. Último ingreso 14:00. Cerrado los lunes',
  descripcion: `La Cascada Trufulco es una de las joyas ocultas del <a href="/region/araucania/" class="cascada-inline-link">Parque Nacional Huerquehue</a>, en la precordillera de Pucón, Región de La Araucanía. Con una caída de aproximadamente 80 metros por un acantilado de roca volcánica andina, es la cascada más alta del parque y uno de los puntos fotográficos más impactantes del sendero Los Lagos. Sus aguas drenan las laderas superiores del parque, alimentadas por el deshielo cordillerano y las lluvias del bosque valdiviano que la rodea.

  Lo que hace especial a esta cascada es su entorno: helechos gigantes, raíces expuestas, musgos y líquenes cubren las paredes rocosas circundantes, creando un microclima húmedo donde la luz se filtra entre las copas de coigües y araucarias milenarias. El contraste entre la caída de agua y la exuberancia del bosque templado lluvioso la convierte en una de las <a href="/cascadas/" class="cascada-inline-link">cascadas más fotogénicas de Chile</a>.

  La Cascada Trufulco se alcanza como un desvío de 400 metros (ida y vuelta) desde el sendero Los Lagos, el más popular del parque. A solo 240 metros de distancia se encuentra la <a href="/cascadas/cascada-nido-de-aguila/" class="cascada-inline-link">Cascada Nido de Águila</a>, la otra cascada del mismo sendero, lo que permite visitar ambas en una sola jornada. El sendero continúa hacia tres lagos de alta montaña —Lago Chico, Laguna Verde y Lago El Toro— con vistas al Volcán Villarrica desde los miradores.`,
  comoLlegar: `Desde Pucón (33-35 km, ~40-50 minutos en vehículo): Tomar la ruta hacia Caburgua (CH-199). Después de 15 km girar hacia Paillaco-Huerquehue. Seguir por camino de ripio (transitable para vehículos normales). Llegar a la entrada del parque (administración CONAF). La Cascada Trufulco se alcanza caminando 2,26 km por el sendero Los Lagos (~45-60 minutos de ascenso).

  Desde Santiago (760 km, ~9-10 horas en auto): Tomar la Ruta 5 Sur hasta Temuco (670 km, ~7 horas). Desde Temuco, seguir por Ruta 199 hasta Pucón (112 km, ~1,5 horas). Desde Pucón, seguir las indicaciones anteriores.

  En transporte público: Buses Caburgua desde terminal en calle Uruguay 540, Pucón. Salidas hacia el parque: 8:30 y 16:00 hrs. Regreso: 9:45 y 17:10 hrs. Precio aproximado: $2.400-5.200 CLP ida y vuelta. Se recomienda tomar el de las 8:30 para completar el sendero.`,
  imagen: '/assets/cascadas/cascada-trufulco/hero.webp',
  imagenAlt: 'Cascada Trufulco, caída de agua de 80 metros en el Parque Nacional Huerquehue, Pucón, La Araucanía',
  galeria: [
    { src: '/assets/cascadas/cascada-trufulco/galeria-1.webp', alt: 'Cascada Trufulco vista HDR con vegetación exuberante del bosque valdiviano' },
    { src: '/assets/cascadas/cascada-trufulco/galeria-2.webp', alt: 'Cascada Nido de Águila, la cascada vecina en el sendero Los Lagos del PN Huerquehue' },
    { src: '/assets/cascadas/cascada-trufulco/galeria-3.webp', alt: 'Lago Tinquilco desde el sendero del Parque Nacional Huerquehue' },
    { src: '/assets/cascadas/cascada-trufulco/galeria-4.webp', alt: 'Río en el sendero del Parque Nacional Huerquehue rodeado de bosque nativo' },
  ],
  galeriaCreditos: [
    { autor: 'Falk2', licencia: 'CC BY-SA 4.0', url: 'https://commons.wikimedia.org/wiki/File:J25_170_Cascada_Trufulco.jpg' },
    { autor: 'Falk2', licencia: 'CC BY-SA 4.0', url: 'https://commons.wikimedia.org/wiki/File:J25_174_Cascada_Trufulco.jpg' },
    { autor: 'Sergio Perez', licencia: 'CC BY-SA 4.0', url: 'https://commons.wikimedia.org/wiki/File:Parque_nacional_Huerquehue_-_SENDERO_-_LAGO_TINTILCO.jpg' },
  ],
  // 3 por cercanía geográfica (PN Huerquehue / Pucón / Araucanía)
  cascadasCercanas: [
    { nombre: 'Cascada Nido de Águila', slug: 'cascada-nido-de-aguila', region: 'La Araucanía', altura: 50, tipo: 'cercania' },
    { nombre: 'Salto del Claro', slug: 'salto-del-claro', region: 'La Araucanía', altura: 90, tipo: 'cercania' },
    { nombre: 'Salto Chancagua', slug: 'salto-chancagua', region: 'La Araucanía', altura: 70, tipo: 'cercania' },
  ],
  // 3 por relación semántica (trekking moderado, bosque valdiviano, parques nacionales)
  cascadasRelacionadas: [
    { nombre: 'Salto del Buey', slug: 'salto-del-buey', region: 'Los Ríos', altura: 90, tipo: 'relacionada' },
    { nombre: 'Saltos del Petrohué', slug: 'saltos-del-petrohue', region: 'Los Lagos', altura: 20, tipo: 'relacionada' },
    { nombre: 'Salto del Huilo-Huilo', slug: 'salto-del-huilo-huilo', region: 'Los Ríos', altura: 37, tipo: 'relacionada' },
  ],

  // --- Datos verificados ---
  lat: -39.146075,
  lng: -71.711359,
  rio: 'Estero sin nombre oficial (drenaje de lagunas superiores del PN Huerquehue)',
  tipoFormacion: 'Plunge sobre acantilado volcánico andino (andesitas e ignimbritas)',
  numeroBrazos: 1,
  distanciaSantiago: 760,

  historia: `El nombre Trufulco proviene del mapudungun, la lengua del pueblo mapuche. La raíz "truful" se asocia con el concepto de "caer" o "derrumbe", y el sufijo "co" significa "agua" o "lugar de agua". Así, Trufulco podría traducirse como "agua que cae" o "lugar del agua que se derrumba", una descripción poética y precisa de la cascada. Este topónimo no debe confundirse con el del Río Truful-Truful del Parque Nacional Conguillío, que comparte la misma raíz mapuche pero se encuentra en un lugar completamente diferente.

  El Parque Nacional Huerquehue fue creado el 9 de junio de 1967, protegiendo 12.500 hectáreas de bosque templado lluvioso valdiviano con araucarias milenarias. El nombre "Huerquehue" también es mapudungun y significa "lugar de mensajeros" (de "huerquén": mensajero, y "hue": lugar). El territorio fue ocupado ancestralmente por comunidades mapuche de la zona lacustre de <a href="/region/araucania/" class="cascada-inline-link">La Araucanía</a>, para quienes la araucaria y sus piñones son patrimonio espiritual y alimentario fundamental.

  La presencia de la familia Braatz, colonos alemanes establecidos desde 1906 en la orilla del Lago Tinquilco, es testimonio de la colonización europea del sur de Chile que convivió con el territorio mapuche. Hoy, el parque es uno de los más visitados de la región, con un cupo diario de 300 visitantes para minimizar el impacto sobre este ecosistema frágil.`,

  queHacer: [
    { actividad: 'Trekking — Sendero Los Lagos', descripcion: 'La cascada se alcanza por el sendero más popular del parque: 12-13 km ida y vuelta, 5-7 horas, ~570 m de desnivel. Dificultad media. No requiere experiencia previa pero sí condición física básica. La cascada está a 2,26 km del estacionamiento.' },
    { actividad: 'Fotografía de naturaleza', descripcion: 'La combinación de la caída de 80 m, helechos gigantes, raíces expuestas y el contraste de luz filtrada por el bosque la convierte en uno de los puntos fotográficos más destacados del parque. Mejor luz en las mañanas.' },
    { actividad: 'Trekking a lagunas alpinas', descripcion: 'El sendero continúa hacia tres lagos de alta montaña: Lago Chico (troncos sumergidos bajo agua cristalina), Laguna Verde (agua azul intenso) y Lago El Toro (orillas de totoras). Incluye miradores con vistas al Volcán Villarrica.' },
    { actividad: 'Avistamiento de flora y fauna', descripcion: 'El sendero atraviesa bosque valdiviano con araucarias de 500-1.000 años. Posible avistar carpintero negro, chucao, rayadito, hued-hued y fío-fío. Mamíferos: pudú, zorro culpeo y monito del monte.' },
    { actividad: 'Camping en el parque', descripcion: 'CONAF administra 22 sitios de camping con cocina de leña cubierta, baños y duchas calientes. También disponibles opciones privadas en Lodge Huerquehue y Camping Olga. Reserva en pasesparques.cl.' },
    { actividad: 'Visita a Cascada Nido de Águila', descripcion: 'A solo 240 metros de la Cascada Trufulco, esta segunda cascada del parque es igualmente impresionante. Ambas se visitan como desvíos del mismo sendero Los Lagos, sumando apenas 15-20 minutos extra.' },
  ],

  flora: `El entorno de la Cascada Trufulco es un ejemplo excepcional de bosque templado lluvioso valdiviano con transición a bosque andino de araucarias. El coigüe (Nothofagus dombeyi) domina el dosel a mediana altitud con su corteza rugosa grisácea, mientras que en las zonas altas del sendero aparecen las araucarias milenarias (Araucaria araucana), árboles sagrados para el pueblo mapuche pehuenche con ejemplares de 500 a 1.000 años de antigüedad.

  El mañío de hojas cortas (Podocarpus nubigenus), la lenga (Nothofagus pumilio) con su espectacular color rojo-anaranjado en otoño, y la tepa (Laureliopsis philippiana) de fragante madera completan el estrato arbóreo. En el sotobosque, el colihue (Chusquea culeou) forma densos matorrales, mientras que en el entorno inmediato de la cascada la humedad permanente crea microclimas donde proliferan helechos gigantes (Blechnum chilense), musgos, líquenes y hongos. En primavera-verano, la alstroemeria silvestre (Alstroemeria aurea) ilumina el sendero con sus flores naranja-amarillo.`,

  fauna: `La fauna del Parque Nacional Huerquehue es representativa del ecosistema andino-valdiviano del sur de Chile. El carpintero negro (Campephilus magellanicus), el más grande de Sudamérica, es el ave emblema del parque: su plumaje negro con cresta roja y sus golpes rítmicos contra los árboles son inconfundibles. El chucao (Scelorchilus rubecula), de pecho rojo vivo y canto fuerte, habita la vegetación densa del sotobosque.

  El rayadito (Aphrastura spinicauda) busca insectos entre las ramas, el hued-hued del sur (Pteroptochos tarnii) recorre el suelo del bosque en parejas, y el cóndor andino (Vultur gryphus) puede avistarse sobre las lagunas. Entre los mamíferos, el pudú (Pudu pudu) —el ciervo más pequeño del mundo— es activo al amanecer y atardecer. El puma y el zorro culpeo habitan la zona, y el monito del monte (Dromiciops gliroides), marsupial "fósil viviente" y único sobreviviente del orden Microbiotheria, es nocturno y extremadamente difícil de observar. La ranita de Darwin (Rhinoderma darwinii), cuyo macho incuba los renacuajos en el saco vocal, habita el sotobosque húmedo.`,

  clima: {
    tipo: 'Templado lluvioso oceánico (Cfb) con influencia andina',
    tempPromedio: '9-12°C',
    tempVerano: '15-25°C',
    tempInvierno: '2-8°C',
    precipitaciones: '1.500-2.000 mm anuales',
    descripcion: 'Veranos agradables y noches frescas (8-12°C). Inviernos fríos con posibilidad de nevadas en los senderos superiores. La mejor época es noviembre a abril: sendero sin nieve, cascada con buen caudal por deshielo. Primavera (octubre-noviembre) ofrece mayor caudal y flores silvestres. Evitar julio-agosto por nevadas y barro extremo.',
  },

  seguridad: [
    'Usar calzado de trekking con suela antideslizante y soporte de tobillo — el sendero tiene raíces expuestas, barro y piedras resbaladizas',
    'Respetar el horario de último ingreso (14:00 hrs). El sendero completo toma 5-7 horas; ingresar tarde implica riesgo de quedarse sin luz natural',
    'Llevar mínimo 2 litros de agua por persona. El sendero no tiene fuentes de agua potable habilitadas',
    'No acercarse al borde de la cascada ni a los acantilados. El suelo cerca de la cascada está cubierto de musgo mojado extremadamente resbaladizo',
    'El clima puede cambiar rápidamente. Llevar siempre ropa impermeable y capa de abrigo aunque el día comience soleado',
    'No salirse de los senderos señalizados. El bosque andino es denso y desorientarse es fácil',
    'En invierno (junio-agosto), algunos tramos pueden estar cubiertos de nieve o hielo. Verificar condiciones con CONAF antes de la visita',
  ],

  recomendaciones: [
    'Comprar la entrada con anticipación en pasesparques.cl. Cupo máximo 300 personas/día, se agota en temporada alta y fines de semana',
    'Llegar antes de las 9:00 hrs para completar el recorrido con comodidad dentro del horario del parque',
    'Llevar snack y almuerzo para 6-7 horas. No hay servicios de alimentación dentro del parque',
    'Ropa en capas: la zona de la cascada es varios grados más fría que el estacionamiento por la humedad y la sombra',
    'Si se va en transporte público, tomar el bus de las 8:30 desde Pucón para aprovechar el día completo',
    'No se permiten mascotas, drones ni fuego dentro del parque (Ley 20.653)',
    'El desvío a la Cascada Trufulco (400 m ida y vuelta) está señalizado. No se puede llegar directamente desde el estacionamiento sin caminar el sendero',
  ],

  gastronomia: [
    { plato: 'Trucha a la plancha con merkén', descripcion: 'La trucha de río es el producto estrella de Pucón y la zona lacustre. Se prepara a la plancha, ahumada o rellena. El merkén (ají cacho de cabra ahumado y molido, patrimonio mapuche) le da carácter regional. Disponible en restaurantes del centro de Pucón.' },
    { plato: 'Piñones asados o guisados', descripcion: 'Frutos de la araucaria, alimento sagrado de la cultura mapuche pehuenche. Se consumen asados al fuego, hervidos, en sopas o en guisos con zapallo y porotos. Disponibles en temporada de cosecha (marzo-mayo) en ferias locales.' },
    { plato: 'Cordero al palo', descripcion: 'Emblema gastronómico de la región andina. Se cocina lentamente sobre las brasas, acompañado de papas cocidas, pebre y ensalada. Habitual los domingos en restaurantes y quintas de los alrededores de Pucón.' },
    { plato: 'Cazuela de vacuno', descripcion: 'Caldo tradicional con carne, papa, zapallo, choclo y arroz. Plato de reconfort especialmente valorado después de una jornada de trekking. Presente en la mayoría de restaurantes tradicionales de Pucón.' },
  ],

  alojamiento: [
    { nombre: 'Lodge Huerquehue', tipo: 'Lodge + Cabañas + Camping', precioDesde: 'Camping desde $18.000 CLP/persona', url: 'https://parquehuerquehue.cl/', descripcion: 'Km 37 camino al parque, orilla del Lago Tinquilco. Cabañas desde $80.000/noche, lodge desde $90.000/noche (incluye desayuno). Restaurant, actividades, centro de eventos. Tel: +56 9 5771 9106.' },
    { nombre: 'Camping Olga', tipo: 'Camping + Cabañas', precioDesde: 'Camping desde $12.000 CLP/noche', url: '#', descripcion: 'Sobre el Lago Tinquilco, 34 km desde Pucón. Sitios delimitados con sombra natural, duchas calientes, playa privada, kayaks y paddleboards. Cabaña rústica $70.000/noche. Tel: +56 9 7443 5125.' },
    { nombre: 'Camping CONAF', tipo: 'Camping', precioDesde: 'Reservar en pasesparques.cl', url: 'https://pasesparques.cl/', descripcion: 'Interior del parque, 22 sitios de acampe. Cocina de leña cubierta, baños y duchas calientes. Los visitantes que acampen deben registrarse con guardaparques antes de acceder a senderos.' },
  ],

  faq: [
    { pregunta: '¿La Cascada Trufulco es lo mismo que el Salto Truful-Truful de Conguillío?', respuesta: 'No. Son dos cascadas completamente distintas. El Salto Truful-Truful está en el Parque Nacional Conguillío (Melipeuco), se forma en el río Truful-Truful y tiene ~30 m. La Cascada Trufulco está en el PN Huerquehue (Pucón), tiene ~80 m y se accede por el sendero Los Lagos. Comparten la raíz mapuche del topónimo pero son lugares diferentes.' },
    { pregunta: '¿Cuánto tiempo tarda llegar a la Cascada Trufulco desde la entrada del parque?', respuesta: 'La cascada está a 2,26 km del estacionamiento por el sendero Los Lagos, lo que equivale a ~45-60 minutos de caminata ascendente. Es el primer atractivo mayor del sendero. Desde allí, el circuito completo a las lagunas toma 5-7 horas en total.' },
    { pregunta: '¿Se puede visitar la Cascada Trufulco todo el año?', respuesta: 'El parque abre martes a domingo todo el año. Sin embargo, en invierno (junio-agosto) los senderos pueden estar nevados o con barro extremo. La mejor época es noviembre a abril. Consultar condiciones con CONAF antes de ir en invierno (parque.huerquehue@conaf.cl).' },
    { pregunta: '¿Cuánto cuesta la entrada al Parque Nacional Huerquehue en 2026?', respuesta: 'Adulto chileno $4.700 CLP, adulto extranjero $10.400 CLP, jóvenes 13-17 (chilenos) $3.200 CLP, jóvenes 13-17 (extranjeros) $5.200 CLP. Niños menores de 12 años y adultos mayores entran gratis. Las entradas se compran obligatoriamente en pasesparques.cl antes de llegar.' },
    { pregunta: '¿Hay transporte público desde Pucón al Parque Huerquehue?', respuesta: 'Sí. Buses Caburgua salen desde calle Uruguay 540 en Pucón. Salidas: 8:30 y 16:00 hrs. Retornos: 9:45 y 17:10 hrs. Precio ~$2.400-5.200 CLP ida y vuelta. Se recomienda el bus de las 8:30 para hacer el sendero completo.' },
    { pregunta: '¿Puedo nadar en las lagunas o la cascada?', respuesta: 'No. CONAF prohíbe nadar en las lagunas interiores del parque y en la cascada, para proteger los ecosistemas frágiles y por seguridad. Sí se puede nadar en el Lago Tinquilco en zonas privadas como Camping Olga o Lodge Huerquehue.' },
    { pregunta: '¿Cuál es la mejor época para visitar la Cascada Trufulco?', respuesta: 'Noviembre a abril. En primavera (octubre-noviembre) hay mayor caudal por deshielo y flores silvestres. En verano (diciembre-marzo) el sendero está en mejores condiciones y las temperaturas son agradables (15-25°C). El caudal es mayor en invierno-primavera pero las condiciones del sendero son más difíciles.' },
  ],
};

// ─── STRUCTURED DATA ────────────────────────────────────────────────────────
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'TouristAttraction',
    name: cascada.nombre,
    description: `Cascada de ~${cascada.altura} metros en el Parque Nacional Huerquehue, Pucón, Región de La Araucanía. Accesible por el sendero Los Lagos, rodeada de bosque valdiviano con araucarias milenarias.`,
    image: `https://cascadaschile.com${cascada.imagen}`,
    geo: {
      '@type': 'GeoCoordinates',
      latitude: cascada.lat,
      longitude: cascada.lng,
    },
    address: {
      '@type': 'PostalAddress',
      addressRegion: cascada.region,
      addressLocality: cascada.zona,
      addressCountry: 'CL',
    },
    isAccessibleForFree: false,
    touristType: ['Naturaleza', 'Trekking', 'Fotografía', 'Avistamiento de aves'],
    url: `https://cascadaschile.com/cascadas/${cascada.slug}`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: cascada.faq.map(f => ({
      '@type': 'Question',
      name: f.pregunta,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.respuesta,
      },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://cascadaschile.com/' },
      { '@type': 'ListItem', position: 2, name: 'Cascadas', item: 'https://cascadaschile.com/cascadas' },
      { '@type': 'ListItem', position: 3, name: cascada.region, item: `https://cascadaschile.com/region/araucania` },
      { '@type': 'ListItem', position: 4, name: cascada.nombre },
    ],
  },
];

const pageTitle = `${cascada.nombre} — Guía completa, cómo llegar y qué hacer | Cascadas de Chile`;
const pageDescription = `${cascada.nombre}: cascada de ${cascada.altura} m en el PN Huerquehue, Pucón, La Araucanía. Sendero Los Lagos, lagunas alpinas, araucarias milenarias y toda la información para tu visita.`;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  ogImage={`https://cascadaschile.com${cascada.imagen}`}
  structuredData={structuredData}
>

  <!-- ─── 1. HERO ──────────────────────────────────────────────────────────── -->
  <section class="cascada-hero">
    <img src={cascada.imagen} alt={cascada.imagenAlt} class="cascada-hero__bg" width="1600" height="1067" decoding="async" fetchpriority="high" />
    <div class="cascada-hero__overlay"></div>
    <div class="cascada-hero__content">
      <nav class="cascada-breadcrumb">
        <a href="/">Inicio</a>
        <span>›</span>
        <a href="/cascadas/">Cascadas</a>
        <span>›</span>
        <a href="/region/araucania">La Araucanía</a>
        <span>›</span>
        <span class="cascada-breadcrumb__current">{cascada.nombre}</span>
      </nav>

      <div class="cascada-hero__bottom">
        <div>
          <span class="cascada-badge">{cascada.region}</span>
          <h1 class="cascada-hero__title">{cascada.nombre}</h1>
        </div>
        <div class="cascada-hero__stat">
          <p class="cascada-hero__stat-number">~{cascada.altura}m</p>
          <p class="cascada-hero__stat-label">Altura de caída</p>
        </div>
      </div>
    </div>
  </section>


  <!-- ─── 2. FICHA RÁPIDA ─────────────────────────────────────────────────── -->
  <section class="cascada-section cascada-section--cream" style="padding-top:3rem; padding-bottom:3rem;">
    <div class="cascada-ficha">
      {[
        { label: 'Dificultad', value: cascada.dificultad },
        { label: 'Acceso', value: cascada.acceso },
        { label: 'Entrada', value: cascada.entrada },
        { label: 'Mejor época', value: cascada.mejorEpoca },
        { label: 'Río', value: cascada.rio },
        { label: 'Brazos', value: `${cascada.numeroBrazos} brazo` },
        { label: 'Dist. Santiago', value: `${cascada.distanciaSantiago} km` },
        { label: 'Coordenadas', value: cascada.coordenadas },
      ].map((stat) => (
        <div class="cascada-ficha__item">
          <p class="cascada-ficha__label">{stat.label}</p>
          <p class="cascada-ficha__value">{stat.value}</p>
        </div>
      ))}
    </div>
  </section>


  <!-- ─── 3. DESCRIPCIÓN ──────────────────────────────────────────────────── -->
