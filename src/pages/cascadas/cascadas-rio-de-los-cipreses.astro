---
import Layout from '../../layouts/Layout.astro';

// ─── DATOS DE LA CASCADA ──────────────────────────────────────────────────────
// Verificado por chile-waterfalls-researcher, mayo 2026
// Fuentes: CONAF (ficha oficial + tarifas jul 2025), pasesparques.cl, Wikipedia,
// Andeshandbook, Ladera Sur, Mongabay (tricahue), Ministerio de las Culturas
// (petroglifos), Machalí Conectado, GoChile.
// NOTA: las alturas métricas de las cascadas NO están documentadas en ninguna
// fuente verificable (CONAF no las publica). No se inventan cifras: el stat
// destacado usa la superficie protegida (dato verificado).
const cascada = {
  nombre: 'Cascadas Río de los Cipreses',
  slug: 'cascadas-rio-de-los-cipreses',
  region: "O'Higgins",
  regionSlug: 'ohiggins',
  zona: 'Machalí (Reserva Nacional)',
  superficie: '38.582',
  caudal: 'Régimen nival-glaciar: máximo en primavera (sep–nov) por deshielo del Glaciar Cipreses, mínimo en otoño',
  dificultad: 'Fácil a difícil (según sendero)',
  acceso: 'Carretera del Cobre, vía Coya',
  coordenadas: "34°27'S 70°27'O",
  mejorEpoca: 'Sep–Dic · Feb–Abr',
  entrada: '$4.200 nac. / $8.900 ext.',
  horario: 'Lun a Dom, 08:30–17:30 (últ. ingreso 16:00)',
  imagen: '/assets/cascadas/cascadas-rio-de-los-cipreses/hero.webp',
  imagenAlt: 'Vista panorámica del valle del Río Cipreses con la cordillera de los Andes en la Reserva Nacional Río de los Cipreses, Machalí, Región de O\'Higgins',
  galeria: [
    { src: '/assets/cascadas/cascadas-rio-de-los-cipreses/galeria-1.webp', alt: 'Cascada en la Reserva Nacional Río de los Cipreses cayendo entre el bosque esclerófilo andino, comuna de Machalí, O\'Higgins' },
    { src: '/assets/cascadas/cascadas-rio-de-los-cipreses/galeria-2.webp', alt: 'Salto de agua entre la vegetación nativa de la Reserva Nacional Río de los Cipreses' },
    { src: '/assets/cascadas/cascadas-rio-de-los-cipreses/galeria-3.webp', alt: 'Aguas del Río Cipreses descendiendo desde el glaciar por el valle andino de la reserva' },
    { src: '/assets/cascadas/cascadas-rio-de-los-cipreses/galeria-4.webp', alt: 'Cordillera de los Andes sobre el valle del Río Cipreses en la Región de O\'Higgins' },
  ],
  galeriaCreditos: [
    { autor: 'Librero2109', licencia: 'CC BY-SA 4.0', url: 'https://commons.wikimedia.org/wiki/File:Cascada_Reserva_Nacional_R%C3%ADo_Los_Cipreses.jpg' },
    { autor: 'Tefy fd', licencia: 'CC BY-SA 3.0', url: 'https://commons.wikimedia.org/wiki/File:Reserva_Nacional_R%C3%ADo_Los_Cipreses_(cascada).jpg' },
    { autor: 'Marco Antonio Correa Flores', licencia: 'CC BY-SA 3.0', url: 'https://commons.wikimedia.org/wiki/File:R%C3%ADo_Los_Cipreses.jpg' },
    { autor: 'Ratolibre1', licencia: 'CC BY-SA 4.0', url: 'https://commons.wikimedia.org/wiki/File:Vista_al_valle_de_Los_Cipreses.jpg' },
  ],
  cascadasCercanas: [
    { nombre: 'Cascada de las Ánimas', slug: 'cascada-de-las-animas', region: 'Metropolitana', altura: 60, tipo: 'cercania' },
    { nombre: 'Cascada de los Vientos', slug: 'cascada-de-los-vientos', region: 'Metropolitana', altura: 30, tipo: 'cercania' },
    { nombre: 'Cascada El Yeso', slug: 'cascada-el-yeso', region: 'Metropolitana', altura: 15, tipo: 'cercania' },
  ],
  cascadasRelacionadas: [
    { nombre: 'Cascadas P.N. Laguna del Laja', slug: 'cascadas-parque-nacional-laguna-del-laja', region: 'Biobío', altura: 55, tipo: 'relacionada' },
    { nombre: 'Saltos de Malalcura', slug: 'saltos-de-malalcura', region: 'Biobío', altura: 40, tipo: 'relacionada' },
    { nombre: 'Salto del Maule', slug: 'salto-del-maule', region: 'Maule', altura: 70, tipo: 'relacionada' },
  ],

  lat: -34.4650,
  lng: -70.4550,
  rio: 'Río Cipreses',
  tipoFormacion: 'Valle glaciar y fluvial andino',
  distanciaSantiago: 130,

  historia: `El valle del Río Cipreses es producto de millones de años de procesos volcánicos, glaciales y fluviales que esculpieron cañones, pozas y cascadas en la cordillera de la Región de O'Higgins. El Glaciar Cipreses —uno de los más estudiados de Sudamérica desde el siglo XIX, descrito por Claudio Gay (1831) e Ignacio Domeyko (1842)— da origen al río que recorre la reserva de sur a norte antes de alimentar al Río Cachapoal. Como testimonio del cambio climático, este glaciar ha retrocedido cerca de 4,4 km entre 1842 y 2018.

  El territorio fue habitado ancestralmente por el pueblo Chiquillan, que dejó un patrimonio arqueológico excepcional: 98 bloques de piedra con 1.248 grabados rupestres —figuras humanas, animales y geométricas de carácter ceremonial— documentados en un catastro financiado por Fondart y CONAF (2013). El sitio "Piedra del Indio" es el más conocido, junto a vestigios en Carrizal, Cotón y Agua de la Vida.

  La Reserva Nacional Río de los Cipreses fue creada el 17 de octubre de 1985 (DS 127) sobre 38.582 hectáreas administradas por CONAF, convirtiéndose en el área silvestre protegida más extensa de la región. Es célebre por albergar la mayor colonia de loro tricahue del país: de apenas 217 ejemplares en 1986, la población se recuperó hasta superar los 4.478 individuos repartidos en 15 loreras activas, un caso emblemático de conservación de la biodiversidad del Chile central, comparable en importancia ecológica a las áreas protegidas andinas del sur.`,

  queHacer: [
    { actividad: 'Sendero Los Peumos y su cascada', descripcion: 'El sendero más popular para ver agua: 1,7 km (ida), desnivel 170 m, dificultad fácil-media. Atraviesa bosque esclerófilo de peumos, quillayes y litres hasta una cascada de tres saltos, y continúa al mirador "Vuelta de la Guardia" con vistas al valle del Cachapoal. Ida y vuelta en 1 hora aprox., apto para familias.' },
    { actividad: 'Sendero Los Tricahues (accesible)', descripcion: 'Sendero universal pavimentado de 250 m con señalética en braille y tallados en relieve. Lleva a un barranco frente a los farellones donde anida la colonia de loro tricahue. Completamente accesible para sillas de ruedas; las bandadas son más activas al amanecer y atardecer.' },
    { actividad: 'Sendero Puente La Leona y la Garganta Cipreses', descripcion: 'Ruta de 7 km (difícil, ~3 horas) por acantilados rocosos a orillas del Río Cipreses hasta el Puente La Leona, desde donde se aprecia la Garganta Cipreses, espectacular encañonamiento del río entre paredes verticales. Salir temprano y llevar abrigo.' },
    { actividad: 'Avistamiento de cóndores', descripcion: 'El Sendero Los Pincheira (350 m, fácil, accesible) tiene un mirador panorámico específico para observar el cóndor andino planeando sobre el valle, especialmente en las primeras horas de la mañana cuando aprovecha las térmicas.' },
    { actividad: 'Petroglifos y arte rupestre', descripcion: 'La reserva conserva 98 bloques con 1.248 grabados del pueblo Chiquillan, de 3.500 a 6.000 años de antigüedad. El sitio "Piedra del Indio" es el más accesible. Consultar disponibilidad y autorización con los guardaparques de CONAF.' },
    { actividad: 'Cabalgata al valle interior', descripcion: 'Disponible en los sectores Carrizal y Urriola y en rutas hacia Piuquenes y Agua de la Vida. El acceso al valle cordillerano profundo (donde se ubican las cascadas Ranchillos, Maitenes y El Indio) requiere arriero certificado por CONAF.' },
    { actividad: 'Fotografía de fauna y birdwatching', descripcion: 'Uno de los mejores destinos de Chile central para fotografiar fauna andina: loro tricahue, cóndor, águilas, guanaco, vizcacha y zorro culpeo, con los nevados y glaciares como telón de fondo. Lleva binoculares y teleobjetivo.' },
  ],

  flora: `La reserva reúne tres formaciones vegetacionales en gradiente altitudinal. En la zona baja (1.200–1.700 m) domina el bosque esclerófilo de transición: peumo (Cryptocarya alba), quillay (Quillaja saponaria), litre (Lithrea caustica) y olivillo (Aextoxicon punctatum). En altitudes medias aparecen los bosquetes de ciprés de la cordillera (Austrocedrus chilensis), conífera de lento crecimiento y alto valor patrimonial que da nombre al río y a la reserva, junto al frangel (Kageneckia angustifolia) y la guindilla (Guindilia trinervis).

  Sobre los 1.400 msnm la vegetación da paso a la estepa altoandina, con coirones, arbustos xerófilos y plantas en cojín adaptadas al frío y la sequía. La reserva alberga además cerca de 40 especies de orquídeas y especies amenazadas como el guayacán (Porlieria chilensis). Esta riqueza florística sustenta la fauna que hace célebre al valle.`,

  fauna: `La Reserva Nacional Río de los Cipreses es un reservorio crítico de biodiversidad del Chile central. Su emblema es el loro tricahue o loro barranquero (Cyanoliseus patagonus bloxami) —el único loro que excava túneles para anidar—, con más de 4.478 individuos y 15 loreras activas según el último censo CONAF. El cóndor andino (Vultur gryphus) sobrevuela el valle y es visible desde el mirador Los Pincheira.

  Entre los mamíferos destacan el guanaco (Lama guanicoe) en las zonas altas, el puma (Puma concolor), el zorro culpeo (Lycalopex culpaeus), el quique, el cururo (Spalacopus cyanus) y la vizcacha (Lagidium viscacia) en los roqueríos. En reptiles sobresale la amenazada iguana chilena (Callopistes maculatus), asociada al sector xerófito del Sendero Las Arpas. Los cauces albergan peces nativos y el pato correntino (Merganetta armata).`,

  clima: {
    tipo: 'Mediterráneo de altura con influencia andina',
    tempPromedio: '12–15°C anual',
    tempVerano: '20–28°C (dic–feb)',
    tempInvierno: '0–8°C (jun–ago)',
    precipitaciones: '400–600 mm anuales',
    descripcion: 'El sector de baja altitud (Ranchillo, ~1.300 msnm) tiene clima mediterráneo de altura: veranos cálidos y secos con noches frescas, e inviernos fríos con heladas y nieve en las cotas medias y altas desde junio. El deshielo primaveral (septiembre–noviembre) aumenta el caudal del río y las cascadas. La mejor época para visitar es de septiembre a diciembre y de mediados de febrero a abril: buen clima, senderos accesibles, agua abundante y loros tricahue activos. Junio–julio ofrece paisajes nevados espectaculares pero con mayor riesgo de avalanchas en los senderos altos (Maitenes, Puente La Leona) entre abril y agosto.',
  },

  seguridad: [
    'Compra el pase CONAF con anticipación en pasesparques.cl (o en puntos Sencillito): debes presentarlo impreso o en el celular junto a tu cédula en el control de ingreso.',
    'Ingresa antes de las 16:00 h (hora límite de entrada). La reserva cierra a las 17:30 h y solo permite visitas de día.',
    'En los senderos de alta dificultad (Maitenes, Puente La Leona) hay riesgo de avalanchas y caída de rocas entre abril y agosto: consulta condiciones con los guardaparques antes de salir.',
    'Presencia de hantavirus: no manipules roedores, no te recuestes directamente en el suelo y evita zonas con heces de ratones.',
    'Hay presencia confirmada de puma: no recorras solo los sectores alejados, haz ruido al caminar y no corras si avistas uno.',
    'El fuego está estrictamente prohibido en toda la reserva (Ley 20.653): incluye fogatas, parrillas y cocinillas en zonas no habilitadas.',
    'Lleva tu propia agua potable: el agua de la reserva no es apta para consumo.',
    'La señal de celular es muy limitada. Informa tu itinerario y hora estimada de regreso antes de entrar.',
    'El camino final desde Coya es de ripio; conduce con precaución, sobre todo tras lluvias, y prefiere un vehículo con buen despeje en invierno.',
    'Emergencias: CONAF Reserva +56 9 4029 9687 · ambulancia 131 · carabineros 133.',
  ],

  recomendaciones: [
    'Reserva la entrada online en pasesparques.cl antes de viajar (especialmente en temporada alta y feriados)',
    'Llega temprano (antes de las 09:00) para ver los loros tricahue y cóndores en su mayor actividad',
    'Calzado de trekking con buen agarre; botas impermeables en invierno',
    'Ropa en capas: el fondo del valle puede ser cálido mientras los miradores son fríos y ventosos',
    'Mínimo 2 litros de agua potable por persona',
    'Snacks y almuerzo: no hay servicios de alimentación dentro de la reserva',
    'Binoculares y teleobjetivo para avistamiento de fauna',
    'Protector solar, lentes y gorro: la reverberación en el cañón es intensa',
    'Bastones de trekking para los senderos largos (Maitenes, Puente La Leona)',
    'Bolsas para llevarte tu basura; no se permiten mascotas',
  ],

  gastronomia: [
    { plato: 'Cazuela de vacuno o cordero', descripcion: 'Plato tradicional muy arraigado en O\'Higgins: caldo sustancioso con carne en el hueso, papas, zapallo, choclo y arroz. Presente en los restaurantes de Machalí y Rancagua, ideal tras una jornada de trekking.' },
    { plato: 'Pastel de choclo', descripcion: 'Clásico del valle central: masa de maíz molido horneada sobre pino de carne, pollo, huevo y aceituna. Típico en la temporada estival de la zona.' },
    { plato: 'Empanadas de pino', descripcion: 'Horneadas y rellenas de carne, cebolla, huevo y aceituna, son un emblema gastronómico de la Región de O\'Higgins y una buena opción para llevar a la reserva.' },
    { plato: 'Trucha del Río Cachapoal', descripcion: 'La trucha arcoíris de aguas cordilleranas se prepara a la plancha, al horno con hierbas o en ceviche, como especialidad en restaurantes de Coya y Machalí.' },
    { plato: 'Cordero del secano', descripcion: 'Propuesta de la nueva cocina regional impulsada por SERNATUR O\'Higgins: cordero criado en el secano, marinado con insumos locales y preparado a la parrilla o al horno de barro.' },
    { plato: 'Asado al palo', descripcion: 'Tradición campestre de la zona: cordero o vacuno asado lentamente sobre brasas de leña, común en las cabañas rurales de Chacayes y en eventos de turismo rural.' },
  ],

  alojamiento: [
    { nombre: 'NOI Puma Lodge', tipo: 'Lodge 4,5★', precioDesde: 'Desde $148.000 CLP/noche', url: 'https://www.noihotels.com/noi-puma-lodge', descripcion: 'Lodge boutique en el Fundo Sierra Nevada, Machalí: 26 habitaciones, restaurante, spa, gimnasio y actividades de aventura (heli-hiking, fly fishing, MTB). El acceso requiere 4x4 obligatorio.' },
    { nombre: 'Hotel Termas de Cauquenes', tipo: 'Hotel termal', precioDesde: 'Desde $50.000 CLP/noche', url: 'https://htdc.cl', descripcion: 'Hotel histórico a orillas del Río Cachapoal, a unos 15 km antes de la reserva. Aguas termales minerales, restaurante y habitaciones; base ideal para visitar el valle.' },
    { nombre: 'Cabañas El Llano de Chacayes', tipo: 'Cabañas', precioDesde: 'Desde $60.000 CLP/noche', url: 'https://www.instagram.com/cabanas_chacayes/', descripcion: 'Cabañas rurales en la localidad de Chacayes, a minutos del acceso a la reserva. Equipadas para 5 personas, con quincho, piscina compartida y vistas a la cordillera.' },
    { nombre: 'Camping Ranchillo (CONAF)', tipo: 'Camping', precioDesde: 'Consultar vigencia', url: 'https://www.pasesparques.cl/es/parks/rio-de-los-cipreses', descripcion: 'Camping oficial dentro de la reserva (sector Ranchillo). Actualmente cerrado para pernocte; la reserva opera solo con visitas de día. Verifica reapertura en pasesparques.cl antes de planificar.' },
  ],

  faq: [
    { pregunta: '¿Cómo llegar a la Reserva Río de los Cipreses desde Santiago?', respuesta: 'Desde Santiago toma la Ruta 5 Sur hasta Rancagua (~85 km) y desde allí la Carretera del Cobre hacia el oriente hasta Coya (~25 km pavimentado). Luego continúa unos 16 km hacia Pangal, cruza el Puente Chacayes y sigue ~5-6 km de ripio hasta la administración CONAF. En total son cerca de 130 km y 1,5 a 2 horas en auto. No se necesita 4x4 para llegar al sector principal.' },
    { pregunta: '¿Cuánto cuesta la entrada a la reserva en 2026?', respuesta: 'Las tarifas CONAF vigentes son: adulto nacional (18-59) $4.200; adolescente nacional (13-17) $2.600; extranjero adulto $8.900; extranjero adolescente $4.700. Entran gratis los menores de 12 años, mayores de 60 y personas con discapacidad. Las entradas se compran en pasesparques.cl o en puntos Sencillito (conviene confirmar el valor vigente antes de viajar).' },
    { pregunta: '¿Hay que reservar entrada con anticipación?', respuesta: 'Sí. Las entradas deben comprarse en línea en pasesparques.cl antes de la visita y se presentan (impresas o en el celular) junto a la cédula en el control de ingreso. En temporada alta (enero-febrero y feriados) conviene comprar con varios días de anticipación.' },
    { pregunta: '¿Qué cascadas hay en la Reserva Río de los Cipreses?', respuesta: 'La cascada más accesible para visitantes de día es la cascada de tres saltos al final del Sendero Los Peumos (1,7 km, fácil-media). El Sendero Puente La Leona (7 km, difícil) lleva a la Garganta Cipreses, un espectacular encañonamiento del río. En el sector cordillerano interior existen cascadas como Ranchillos, Maitenes y El Indio, pero su acceso requiere arriero certificado y autorización de CONAF.' },
    { pregunta: '¿Cuál es la mejor época para visitar?', respuesta: 'La temporada óptima es de septiembre a diciembre y de mediados de febrero a abril: buen clima, senderos accesibles, agua abundante por el deshielo y loros tricahue muy activos. Junio-julio ofrece paisajes nevados espectaculares pero con accesos más difíciles. Enero-febrero es el período de mayor concurrencia.' },
    { pregunta: '¿Se ven cóndores y loros tricahue en la reserva?', respuesta: 'Sí. La reserva alberga la mayor colonia de loro tricahue de Chile (más de 4.478 individuos en 15 loreras activas), visible desde el Sendero Los Tricahues, completamente accesible. El cóndor andino se observa planeando sobre el valle, sobre todo desde el mirador del Sendero Los Pincheira en las primeras horas de la mañana.' },
    { pregunta: '¿Se puede acampar dentro de la reserva?', respuesta: 'Actualmente las zonas de camping están cerradas y la reserva opera solo con visitas de día (08:30 a 17:30 h, último ingreso 16:00). Históricamente existían campings en Ranchillo, Tricahue y Los Peumos. Para verificar si el camping se ha reabierto para la fecha de tu visita, consulta en pasesparques.cl o llama al +56 9 4029 9687.' },
    { pregunta: '¿Los senderos son aptos para familias y personas con movilidad reducida?', respuesta: 'Sí. Los senderos Los Tricahues (250 m, pavimentado y con braille) y Los Pincheira (350 m) son completamente accesibles para sillas de ruedas. El Sendero Los Peumos (1,7 km) es apto para familias con niños. Los senderos Maitenes y Puente La Leona son de alta dificultad y no son accesibles.' },
  ],
};

// ─── STRUCTURED DATA ────────────────────────────────────────────────────────
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'TouristAttraction',
    name: cascada.nombre,
    description: `Cascadas y senderos de la Reserva Nacional Río de los Cipreses, 38.582 hectáreas de cordillera andina en Machalí, Región de O'Higgins, Chile. Hogar de la mayor colonia de loro tricahue del país y de petroglifos del pueblo Chiquillan.`,
    image: `https://cascadaschile.com${cascada.imagen}`,
    geo: {
      '@type': 'GeoCoordinates',
      latitude: cascada.lat,
      longitude: cascada.lng,
    },
    address: {
      '@type': 'PostalAddress',
      addressRegion: "O'Higgins",
      addressLocality: 'Machalí',
      addressCountry: 'CL',
    },
    isAccessibleForFree: false,
    openingHours: 'Mo-Su 08:30-17:30',
    touristType: ['Naturaleza', 'Senderismo', 'Avistamiento de aves', 'Fotografía', 'Familias'],
    url: `https://cascadaschile.com/cascadas/${cascada.slug}`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: cascada.faq.map(f => ({
      '@type': 'Question',
      name: f.pregunta,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.respuesta,
      },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://cascadaschile.com/' },
      { '@type': 'ListItem', position: 2, name: 'Cascadas', item: 'https://cascadaschile.com/cascadas' },
      { '@type': 'ListItem', position: 3, name: cascada.region, item: `https://cascadaschile.com/region/${cascada.regionSlug}` },
      { '@type': 'ListItem', position: 4, name: cascada.nombre },
    ],
  },
];

const pageTitle = `Cascadas de la Reserva Río de los Cipreses — Guía, cómo llegar y senderos | Cascadas de Chile`;
const pageDescription = `Reserva Nacional Río de los Cipreses (Machalí, O'Higgins): cascadas, senderos, loros tricahue y cóndores en 38.582 ha de cordillera. Cómo llegar desde Santiago, entrada CONAF, mejor época y mapa.`;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  ogImage={`https://cascadaschile.com${cascada.imagen}`}
  structuredData={structuredData}
>

  <!-- ─── 1. HERO ──────────────────────────────────────────────────────────── -->
  <section class="cascada-hero">
    <img src={cascada.imagen} alt={cascada.imagenAlt} class="cascada-hero__bg" width="1600" height="1200" decoding="async" fetchpriority="high" />
    <div class="cascada-hero__overlay"></div>
    <div class="cascada-hero__content">
      <nav class="cascada-breadcrumb">
        <a href="/">Inicio</a>
        <span>›</span>
        <a href="/cascadas/">Cascadas</a>
        <span>›</span>
        <a href={`/region/${cascada.regionSlug}`}>{cascada.region}</a>
        <span>›</span>
        <span class="cascada-breadcrumb__current">{cascada.nombre}</span>
      </nav>

      <div class="cascada-hero__bottom">
        <div>
          <span class="cascada-badge">{cascada.region}</span>
          <h1 class="cascada-hero__title">Río de los Cipreses</h1>
        </div>
        <div class="cascada-hero__stat">
          <p class="cascada-hero__stat-number">{cascada.superficie}</p>
          <p class="cascada-hero__stat-label">Hectáreas protegidas</p>
        </div>
      </div>
    </div>
  </section>


  <!-- ─── 2. FICHA RÁPIDA ─────────────────────────────────────────────────── -->
  <section class="cascada-section cascada-section--cream" style="padding-top:3rem; padding-bottom:3rem;">
    <div class="cascada-ficha">
      {[
        { label: 'Dificultad', value: cascada.dificultad },
        { label: 'Acceso', value: cascada.acceso },
        { label: 'Entrada', value: cascada.entrada },
        { label: 'Mejor época', value: cascada.mejorEpoca },
        { label: 'Río', value: cascada.rio },
        { label: 'Superficie', value: `${cascada.superficie} ha` },
        { label: 'Dist. Santiago', value: `${cascada.distanciaSantiago} km` },
