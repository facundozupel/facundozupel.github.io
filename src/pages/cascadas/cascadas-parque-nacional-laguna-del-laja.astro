---
import Layout from '../../layouts/Layout.astro';

// ─── DATOS DE LA CASCADA ──────────────────────────────────────────────────────
// Verificado por chile-waterfalls-researcher + competidores (CONAF, turismoantuco.cl, chileestuyo.cl), mar 2026
const cascada = {
  // --- Identificación ---
  nombre: 'Cascadas del Parque Nacional Laguna del Laja',
  slug: 'cascadas-parque-nacional-laguna-del-laja',
  region: 'Biobío',
  zona: 'Antuco',
  altura: 55,
  caudal: 'Variable estacional — mayor caudal en primavera (deshielo)',
  dificultad: 'Fácil a moderado',
  acceso: 'Ruta Q-45 desde Los Ángeles (93 km)',
  coordenadas: '37°23\'S 71°22\'W',
  mejorEpoca: 'Septiembre — Marzo',
  entrada: 'Pagada (pasesparques.cl)',
  horario: '8:30 — 17:00 (último ingreso 14:00)',
  descripcion: `El Parque Nacional Laguna del Laja alberga al menos cinco cascadas y saltos de agua de origen volcánico y glaciar, distribuidos a lo largo de los senderos y caminos del parque. Las más destacadas son el Salto Las Chilcas (40 m), el Salto Trubunleo (55 m) sobre columnas basálticas, el Salto Echeverría o Las Pulgas (18 m), los Saltos de Malalcura (una serie de seis caídas sobre roca granítica) y el Velo de la Novia (15 m) junto a la ruta de acceso.

  Las cascadas se alimentan de dos fuentes principales: las filtraciones subterráneas de la Laguna del Laja —el embalse natural más grande de Chile con 125 km² de superficie— que atraviesan el suelo volcánico de tefra del complejo Antuco, y los glaciares de la Sierra Velluda (3.585 msnm) que arrastran aguas cristalinas hasta el valle.

  El parque fue creado el 25 de junio de 1958 y protege 11.600 hectáreas de paisajes cordilleranos dominados por el volcán Antuco (2.985 msnm) y la Sierra Velluda. Es uno de los pocos parques nacionales de Chile donde la temporada alta es en invierno, cuando miles de visitantes acuden a practicar deportes de nieve en el Centro de Esquí Antuco.`,
  comoLlegar: `Desde Los Ángeles (93 km, 1h 30min): Tomar la Ruta Q-45 (Ruta Los Carrera) hacia el este. Los primeros 82 km hasta Abanico están pavimentados; el resto es ripio transitable todo el año. En invierno se recomienda vehículo 4x4 y cadenas para nieve.

  Desde Santiago (570 km, 7 horas): Ruta 5 Sur hasta Los Ángeles, luego Ruta Q-45 hacia el parque. Alternativa: vuelo a Concepción (aeropuerto Carriel Sur) + auto hasta Los Ángeles (150 km) + Ruta Q-45.

  Transporte público: Existen buses rurales diarios de Los Ángeles a Abanico (11 km antes de la entrada al parque). Desde Abanico NO hay movilización pública hasta el parque. Se recomienda vehículo propio o contratar transfer en Antuco.

  Entrada al parque: Comprar boletos anticipadamente en pasesparques.cl. Contacto CONAF: +569 63005146, parque.lagunadellaja@conaf.cl`,
  imagen: '/assets/cascadas/cascadas-parque-nacional-laguna-del-laja/hero.webp',
  imagenAlt: 'Cascada en el interior del Parque Nacional Laguna del Laja, Región del Biobío',
  galeria: [
    { src: '/assets/cascadas/cascadas-parque-nacional-laguna-del-laja/galeria-1.webp', alt: 'Salto Las Chilcas, cascada de 40 metros en el sendero Las Chilcas del Parque Nacional Laguna del Laja' },
    { src: '/assets/cascadas/cascadas-parque-nacional-laguna-del-laja/galeria-2.webp', alt: 'Vista panorámica de la Laguna del Laja rodeada de montañas cordilleranas' },
    { src: '/assets/cascadas/cascadas-parque-nacional-laguna-del-laja/galeria-3.webp', alt: 'Volcán Antuco y glaciares de la Sierra Velluda vistos desde el Parque Nacional Laguna del Laja' },
    { src: '/assets/cascadas/cascadas-parque-nacional-laguna-del-laja/galeria-4.webp', alt: 'Río Laja fluyendo entre paisaje volcánico dentro del Parque Nacional Laguna del Laja' },
  ],
  galeriaCreditos: [
    { autor: 'Cyborgsoto', licencia: 'CC BY-SA 3.0', url: 'https://commons.wikimedia.org/wiki/File:Cascadaplaja.jpg' },
    { autor: 'scott.zona', licencia: 'CC BY 2.0', url: 'https://commons.wikimedia.org/wiki/File:Salto_Las_Chilcas.jpg' },
    { autor: 'Hellmighty', licencia: 'CC BY-SA 4.0', url: 'https://commons.wikimedia.org/wiki/File:Laguna_del_Laja,_Bio_Bio,_Chile.jpg' },
    { autor: 'Raymundo46', licencia: 'CC BY-SA 4.0', url: 'https://commons.wikimedia.org/wiki/File:Volcan-Antuco-y-Sierra-Velluda.jpg' },
    { autor: 'AcrossTheMountains', licencia: 'CC BY-SA 4.0', url: 'https://commons.wikimedia.org/wiki/File:Parque_nacional_Laguna_del_Laja_rio_Laja.jpg' },
  ],
  // 3 por cercanía geográfica (misma región o adyacente)
  cascadasCercanas: [
    { nombre: 'Salto del Laja', slug: 'salto-del-laja', region: 'Biobío', altura: 35, tipo: 'cercania' },
    { nombre: 'Salto Rehuén', slug: 'salto-rehuen', region: 'Biobío', altura: 70, tipo: 'cercania' },
    { nombre: 'Salto del Itata', slug: 'salto-del-itata', region: 'Ñuble', altura: 75, tipo: 'cercania' },
  ],
  // 3 por relación semántica (cascadas en parques nacionales, entorno volcánico)
  cascadasRelacionadas: [
    { nombre: 'Salto Truful-Truful', slug: 'salto-truful-truful', region: 'La Araucanía', altura: 20, tipo: 'relacionada' },
    { nombre: 'Saltos del Petrohué', slug: 'saltos-del-petrohue', region: 'Los Lagos', altura: 20, tipo: 'relacionada' },
    { nombre: 'Salto del Claro', slug: 'salto-del-claro', region: 'La Araucanía', altura: 90, tipo: 'relacionada' },
  ],

  // --- Datos verificados ---
  lat: -37.3833,
  lng: -71.3667,
  rio: 'Río Laja / filtraciones Laguna del Laja',
  tipoFormacion: 'Volcánica y glaciar (basalto y granito)',
  numeroBrazos: 5,
  distanciaSantiago: 570,

  historia: `El Parque Nacional Laguna del Laja fue creado el 25 de junio de 1958, convirtiéndose en una de las áreas protegidas más antiguas de la Región del Biobío. Protege 11.600 hectáreas de ecosistemas cordilleranos moldeados por milenios de actividad volcánica del complejo Antuco-Sierra Velluda.

  El volcán Antuco (2.985 msnm) es el protagonista geológico del parque. Su particular forma cónica es resultado de un violento colapso lateral ocurrido hace aproximadamente 10.000 años, similar al del Monte Saint Helens. La avalancha volcánica generó un dique natural que represó las aguas del Río Laja, formando la Laguna del Laja — el embalse natural más grande de Chile con 125 km² de superficie a 1.360 msnm. Las cascadas del parque son consecuencia directa de estas filtraciones: el agua de la laguna se infiltra por el suelo poroso de tefra volcánica y resurge como saltos cristalinos en las laderas del valle.

  La Sierra Velluda (3.585 msnm) es un antiguo estratovolcán extinto que alberga los glaciares más importantes de toda la Región del Biobío. Sus ventisqueros colgantes alimentan los cursos de agua del parque, incluyendo los Saltos de Malalcura y el Salto Trubunleo. A sus pies se forma la Laguna Verde, alimentada por sedimentos glaciares de diferentes colores.

  El 18 de mayo de 2005, el parque fue escenario de la Tragedia de Antuco, cuando 44 soldados conscriptos y un sargento del Regimiento de Infantería de Montaña N.° 17 Los Ángeles fallecieron durante una marcha de instrucción invernal debido a una tormenta de nieve. El evento, uno de los más graves de la historia militar chilena en tiempos de paz, llevó a la construcción de un memorial dentro del parque que hoy recuerda a las víctimas.`,

  queHacer: [
    { actividad: 'Sendero Las Chilcas (1,6 km)', descripcion: 'Sendero de dificultad media que recorre cursos hídricos, escoria volcánica, cascadas y pasarelas con miradores. Incluye dos saltos de agua: el Salto Las Chilcas (40 m) y El Torbellino. Flora destacada: chilco, radal enano, ciprés de cordillera. Con suerte se avistan patos cortacorrientes, chucao, hued hued y cóndores (hay catalejos instalados para buscar nidos). Duración: medio día.' },
    { actividad: 'Sendero Los Coigües (1,8 km)', descripcion: 'Sendero de dificultad media que parte desde la administración del parque. Tras sortear dos cerros se llega a un mirador con vista a antiguos coigües y el volcán Antuco como telón de fondo. Abundan cipreses de cordillera y letreros informativos.' },
    { actividad: 'Sendero Sierra Velluda (4,7 km)', descripcion: 'Ruta de dificultad media-alta hacia la base del macizo Sierra Velluda (3.585 msnm). El recorrido atraviesa cursos de lava, bosques nativos y pendientes rocosas. En invierno se observan cavernas de hielo en la base del glaciar. Duración: día completo.' },
    { actividad: 'Ascenso al Volcán Antuco', descripcion: 'Ascensión a la cumbre del volcán Antuco (2.985 msnm). Requiere buena condición física y experiencia en montaña. Se puede ascender todo el año, aunque en invierno requiere equipo de alta montaña. Desde la cumbre se ve la Laguna del Laja completa.' },
    { actividad: 'Esquí y snowboard', descripcion: 'El Centro de Esquí Antuco, en las faldas del volcán, cuenta con dos pistas para esquí y snowboard. Temporada invernal (julio-agosto). Es lo que convierte al parque en uno de los pocos donde la temporada alta es en invierno.' },
    { actividad: 'Pesca deportiva con mosca', descripcion: 'Las aguas de la Laguna del Laja y el Río Laja son aptas para pesca con mosca. Se requiere permiso de pesca y respetar las regulaciones de CONAF para pescar dentro del parque.' },
  ],

  flora: `El Parque Nacional Laguna del Laja conserva especies de gran valor para la conservación. La más emblemática es el ciprés de la cordillera (Austrocedrus chilensis), clasificado como vulnerable a la extinción, que forma un bosque homogéneo considerado uno de los principales del país. Se observa fácilmente en la entrada del parque, a orillas del camino principal en los sectores Lagunillas y Chacay.

  La araucaria chilena (Araucaria araucana), también vulnerable, encuentra en el parque su distribución natural más septentrional (más al norte). Está representada por pocos ejemplares cuyo valor genético es importante preservar, visibles a través del sendero que asciende hacia la Sierra Velluda. El radal enano (Orites myrtoidea), clasificado como raro, es un arbusto fácil de encontrar en el sector Chacay. En el sendero Las Chilcas predomina el chilco (Fuchsia magellanica), que da nombre a la ruta, junto con coigües (Nothofagus dombeyi) que dominan amplias extensiones del parque y dan nombre al sendero Los Coigües.`,

  fauna: `Las aves son la principal población faunística del parque, con 47 especies registradas. De especial interés son la bandurria (Theristicus caudatus), vulnerable, y el cóndor (Vultur gryphus), también vulnerable, observables en los sectores Lagunillas y Chacay. La perdicita cordillerana (Attagis gayi) y la gaviota andina (Chroicocephalus serranus), ambas raras, se observan en todo el parque. En los senderos se encuentran patos cortacorrientes, chucao, hued hued, pato jergón y picaflores.

  Entre los mamíferos destaca la vizcacha (Lagidium viscacia), en peligro de extinción regional, observable en roqueríos de Lagunillas y lago Laja. También habitan el puma (Puma concolor), vulnerable, y los zorros culpeo (Lycalopex culpaeus) y chilla (Lycalopex griseus). La singularidad más relevante es el matuasto (Phymaturus vociferator), reptil endémico de Chile en peligro crítico — mide hasta 20 cm, el macho es amarillo o verdoso encendido y la hembra grisácea. La población del parque (más de 200 ejemplares) es la más conocida de la especie y es monitoreada por guardaparques desde 2017.`,

  clima: {
    tipo: 'Templado lluvioso cordillerano',
    tempPromedio: '13,6°C',
    tempVerano: '15-27°C',
    tempInvierno: '-18 a 1°C',
    precipitaciones: '2.170 mm anuales',
    descripcion: 'El parque presenta clima de montaña con veranos templados y secos (15-27°C) e inviernos fríos con abundante nieve y temperaturas que pueden descender a -18°C en las noches más gélidas. Las precipitaciones se concentran entre junio y septiembre, alcanzando 2.170 mm anuales. Es uno de los pocos parques donde la temporada alta es en invierno por los deportes de nieve. La mejor época para ver las cascadas es de septiembre a marzo (primavera-verano), cuando el deshielo aumenta el caudal y los senderos están despejados de nieve.',
  },

  seguridad: [
    'El clima de montaña es impredecible — tormentas pueden aparecer sin aviso. Consultar pronóstico antes de ir.',
    'En invierno llevar cadenas para nieve obligatoriamente. Se recomienda vehículo 4x4. Respetar horarios de subida y bajada establecidos por Vialidad.',
    'No salir de los senderos señalizados. En el Salto Trubunleo mantener distancia prudente — hay riesgo de caída de piedras y rocas.',
    'El sendero Sierra Velluda es de dificultad media-alta. Requiere calzado de montaña y buena condición física.',
    'Los estacionamientos son limitados, especialmente en temporada de nieve. Llegar temprano.',
    'Comprar boletos anticipadamente en pasesparques.cl — el parque puede alcanzar su capacidad máxima.',
  ],

  recomendaciones: [
    'Calzado de trekking impermeable — los senderos cruzan cursos de agua',
    'Protector solar, gorro y agua (la radiación UV es alta en cordillera)',
    'Ropa de abrigo abrigada incluso en verano — la brisa cordillerana es fresca',
    'Binoculares para observar cóndores, bandurrias y el matuasto',
    'Cadenas para nieve si se visita entre mayo y septiembre',
    'Cámara fotográfica — los saltos, el volcán y la laguna son espectaculares',
  ],

  gastronomia: [
    { plato: 'Trucha del Río Laja', descripcion: 'El plato estrella de la zona. Trucha fresca a la mantequilla, al ajillo o ahumada, proveniente del Río Laja y la Laguna del Laja. Disponible en restaurantes de Antuco y Los Ángeles.' },
    { plato: 'Asado de cordero al palo', descripcion: 'Tradición ganadera de la precordillera del Biobío. Cordero entero asado a fuego lento en estaca. Característico de fondas y fiestas costumbristas de la zona de Antuco.' },
    { plato: 'Cazuela de ave o vacuno', descripcion: 'Caldo tradicional chileno con trozos de carne, papas, choclo, zapallo y verduras. Plato reconfortante ideal tras una jornada de trekking en la cordillera.' },
    { plato: 'Longaniza ahumada', descripcion: 'Producto regional estrella de la zona Biobío-Ñuble. Se ofrece como entrada en restaurantes de Los Ángeles y en los mercados artesanales de la zona.' },
    { plato: 'Piñones de araucaria', descripcion: 'Los piñones, fruto de las araucarias del parque, son un alimento ancestral mapuche-pehuenche. Se preparan cocidos, tostados o en guisos. Disponibles en otoño (marzo-mayo).' },
    { plato: 'Empanada de pino', descripcion: 'Empanada horneada rellena de carne picada, cebolla, aceitunas y huevo. Tradición criolla disponible en locales de Antuco y Los Ángeles.' },
  ],

  alojamiento: [
    { nombre: 'Cabañas Antucalhue Mountain Resort', tipo: 'Cabaña', precioDesde: 'Consultar precio', url: 'https://parqueantuco.cl', descripcion: 'Cabañas en la Ruta Q-45 km 82, camino al parque. Incluye restaurante. Reservas: contacto@parqueantuco.cl, +56995072559.' },
    { nombre: 'Cabañas Trawüpeyum', tipo: 'Cabaña', precioDesde: 'Consultar precio', url: '#', descripcion: 'Cabañas en el pueblo de Antuco, a 16 km de la entrada del parque. Opción acogedora para base de exploración.' },
    { nombre: 'Camping dentro del parque (CONAF)', tipo: 'Camping', precioDesde: 'Incluido en entrada', url: 'https://www.pasesparques.cl/es/parks/laguna-del-laja', descripcion: 'Zona de campismo habilitada dentro del parque. Reservas: +56982212078, contacto@parqueantuco.cl. Verificar disponibilidad con anticipación.' },
    { nombre: 'Cabañas Las Rosas', tipo: 'Cabaña', precioDesde: 'Consultar precio', url: '#', descripcion: 'Ubicadas en Villa Las Rosas, Ruta Q-45 S/N. Camino al parque con acceso directo a la precordillera antucana.' },
    { nombre: 'Cabañas Turismo Curalemu', tipo: 'Cabaña', precioDesde: 'Consultar precio', url: '#', descripcion: 'En la Ruta Q-45, Camino a Antuco km 55. Punto medio entre Los Ángeles y el parque.' },
    { nombre: 'Parador Turístico Villa Peluca', tipo: 'Hospedaje', precioDesde: 'Consultar precio', url: '#', descripcion: 'En el sector Villa Peluca, camino al parque. Hospedaje rústico para quienes buscan tranquilidad en la precordillera.' },
  ],

  faq: [
    { pregunta: '¿Cuánto cuesta la entrada al Parque Nacional Laguna del Laja?', respuesta: 'La entrada se compra anticipadamente en pasesparques.cl. Los precios varían según temporada. El parque es administrado por CONAF. Para información actualizada sobre tarifas, contactar al +569 63005146 o escribir a parque.lagunadellaja@conaf.cl.' },
    { pregunta: '¿Qué cascadas hay dentro del Parque Nacional Laguna del Laja?', respuesta: 'El parque alberga al menos cinco cascadas principales: el Salto Las Chilcas (40 m) y El Torbellino en el sendero homónimo, el Salto Trubunleo (55 m) sobre columnas basálticas, el Salto Echeverría o Las Pulgas (18 m) accesible desde Camping Malalcura, los Saltos de Malalcura (serie de 6 caídas sobre roca granítica) y el Velo de la Novia (15 m) en la ruta Q-45 antes de la entrada.' },
    { pregunta: '¿Cómo llegar al Parque Nacional Laguna del Laja desde Los Ángeles?', respuesta: 'Desde Los Ángeles se toma la Ruta Q-45 (Ruta Los Carrera) hacia el este, son 93 km y aproximadamente 1 hora 30 minutos. Los primeros 82 km hasta Abanico están pavimentados; el tramo final es ripio. En invierno se recomienda 4x4 y cadenas para nieve. Hay buses rurales hasta Abanico pero no hasta el parque.' },
    { pregunta: '¿Cuál es el mejor sendero para ver cascadas en el parque?', respuesta: 'El Sendero Las Chilcas (1,6 km, dificultad media) es el mejor para ver cascadas: incluye dos saltos de agua, pasarelas, miradores y la posibilidad de avistar cóndores con los catalejos instalados. Duración aproximada de medio día.' },
    { pregunta: '¿Se puede esquiar en el Parque Nacional Laguna del Laja?', respuesta: 'Sí. El Centro de Esquí Antuco se encuentra en las faldas del volcán Antuco, dentro del parque. Cuenta con dos pistas para esquí y snowboard. La temporada es de julio a agosto. Es lo que hace del parque uno de los pocos en Chile donde la temporada alta es en invierno.' },
    { pregunta: '¿Qué es el matuasto y dónde verlo?', respuesta: 'El matuasto (Phymaturus vociferator) es un reptil endémico de Chile en peligro crítico de extinción. Mide hasta 20 cm, el macho es amarillo-verdoso y la hembra grisácea. El parque alberga la población más conocida (más de 200 ejemplares), monitoreada desde 2017. Se observa en escoria volcánica, especialmente en primavera-verano.' },
    { pregunta: '¿Es necesario reservar para entrar al parque?', respuesta: 'Sí, se recomienda comprar boletos anticipadamente en pasesparques.cl. El parque tiene capacidad máxima limitada, especialmente en temporada de nieve. En invierno se forman filas para ingresar y los estacionamientos se llenan temprano.' },
    { pregunta: '¿Se puede hacer camping dentro del parque?', respuesta: 'Sí, el parque cuenta con zona de campismo. Las reservas de cabañas del concesionario se gestionan con Bernabé Leal al +56995072559 o +56982212078. También hay campings y cabañas privados en la Ruta Q-45 camino al parque.' },
  ],
};

// ─── STRUCTURED DATA ────────────────────────────────────────────────────────
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'TouristAttraction',
    name: cascada.nombre,
    description: `Conjunto de cascadas volcánicas y glaciares dentro del Parque Nacional Laguna del Laja, Región del Biobío, Chile. Incluye el Salto Trubunleo (${cascada.altura} m), Salto Las Chilcas, Saltos de Malalcura y más.`,
    image: `https://cascadaschile.com${cascada.imagen}`,
    geo: {
      '@type': 'GeoCoordinates',
      latitude: cascada.lat,
      longitude: cascada.lng,
    },
    address: {
      '@type': 'PostalAddress',
      addressRegion: cascada.region,
      addressLocality: cascada.zona,
      addressCountry: 'CL',
    },
    isAccessibleForFree: false,
    openingHours: 'Mo-Su 08:30-17:00',
    touristType: ['Naturaleza', 'Aventura', 'Montañismo', 'Fotografía', 'Esquí'],
    url: `https://cascadaschile.com/cascadas/${cascada.slug}`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: cascada.faq.map(f => ({
      '@type': 'Question',
      name: f.pregunta,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.respuesta,
      },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://cascadaschile.com/' },
      { '@type': 'ListItem', position: 2, name: 'Cascadas', item: 'https://cascadaschile.com/cascadas' },
      { '@type': 'ListItem', position: 3, name: cascada.region, item: `https://cascadaschile.com/region/${cascada.region.toLowerCase().replace(/\s/g,'-')}` },
      { '@type': 'ListItem', position: 4, name: cascada.nombre },
    ],
  },
];

const pageTitle = `${cascada.nombre} — Guía completa, cómo llegar y qué hacer | Cascadas de Chile`;
const pageDescription = `${cascada.nombre}: 5 saltos de agua volcánicos y glaciares en ${cascada.region}, Chile. Senderos, esquí, volcán Antuco, flora y fauna. Guía completa para tu visita.`;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  ogImage={`https://cascadaschile.com${cascada.imagen}`}
  structuredData={structuredData}
>

  <!-- ─── 1. HERO ──────────────────────────────────────────────────────────── -->
  <section class="cascada-hero">
    <img src={cascada.imagen} alt={cascada.imagenAlt} class="cascada-hero__bg" width="1600" height="1067" decoding="async" fetchpriority="high" />
    <div class="cascada-hero__overlay"></div>
    <div class="cascada-hero__content">
      <nav class="cascada-breadcrumb">
        <a href="/">Inicio</a>
        <span>›</span>
        <a href="/cascadas/">Cascadas</a>
        <span>›</span>
        <a href={`/region/${cascada.region.toLowerCase().replace(/\s/g,'-')}`}>{cascada.region}</a>
        <span>›</span>
        <span class="cascada-breadcrumb__current">{cascada.nombre}</span>
      </nav>

      <div class="cascada-hero__bottom">
        <div>
          <span class="cascada-badge">{cascada.region}</span>
          <h1 class="cascada-hero__title">Cascadas<br/>Laguna<br/>del Laja</h1>
        </div>
        <div class="cascada-hero__stat">
          <p class="cascada-hero__stat-number">{cascada.numeroBrazos}</p>
          <p class="cascada-hero__stat-label">Cascadas principales</p>
        </div>
      </div>
    </div>
  </section>


  <!-- ─── 2. FICHA RÁPIDA ─────────────────────────────────────────────────── -->
  <section class="cascada-section cascada-section--cream" style="padding-top:3rem; padding-bottom:3rem;">
    <div class="cascada-ficha">
      {[
        { label: 'Dificultad', value: cascada.dificultad },
        { label: 'Acceso', value: cascada.acceso },
        { label: 'Entrada', value: cascada.entrada },
